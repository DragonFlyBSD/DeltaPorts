--- Uses/npm.mk.orig
+++ Uses/npm.mk
@@ -78,7 +78,7 @@
 .include "${USESDIR}/nodejs.mk"
 _NODEJS_PKGNAME=node${NODEJS_VERSION}
 _NODEJS_PORT=	www/node${NODEJS_VERSION}
-_NPM_NODEJS_ARCH_CONV_STR=	S/aarch64/arm64/:S/amd64/x64/:S/i386/ia32/
+_NPM_NODEJS_ARCH_CONV_STR=	S/aarch64/arm64/:S/amd64/x64/:S/x86_64/x64/:S/i386/ia32/
 NPM_NODEJS_ARCH=		${ARCH:${_NPM_NODEJS_ARCH_CONV_STR}}
 
 _VALID_NPM_NAMES=npm yarn1 yarn2 yarn4 pnpm
@@ -241,6 +241,14 @@
 NPM_PREFETCH?=		${_NPM_EXISTS_PKGFILE}
 NPM_PREFETCH_ARCHS?=
 NPM_EXTRACT?=		${NPM_PREFETCH}
+
+# Fetching with node (corepack, prefetched node modules) checks the
+# registry's certificate, which finds nothing in a DragonFly build jail
+# without ca_root_nss.
+.  if ${_NPM_NAME} == yarn2 || ${_NPM_NAME} == yarn4 || \
+    ${_NPM_NAME} == pnpm || ${NPM_PREFETCH:tl} == yes
+FETCH_DEPENDS+=	${LOCALBASE}/share/certs/ca-root-nss.crt:security/ca_root_nss
+.  endif
 
 # Bootstrap node package manager for yarn >2 or pnpm
 .  if ${_NPM_NAME} == yarn2 || ${_NPM_NAME} == yarn4 || ${_NPM_NAME} == pnpm

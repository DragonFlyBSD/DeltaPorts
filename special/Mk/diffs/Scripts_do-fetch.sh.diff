--- Scripts/do-fetch.sh.orig
+++ Scripts/do-fetch.sh
@@ -27,6 +27,20 @@
 		;;
 esac
 
+# Serialise fetches of the same distfile across parallel builders. The file
+# list arrives on stdin, so re-invoke once per file with that one line piped
+# in rather than passed as an argument.
+if [ ! -n "${DO_FETCH_ISLOCKED:=}" ]; then
+	while IFS= read -r _file; do
+		mkdir -p .locks
+		file=${_file%%:*}
+		lkfile="`echo "$file" | md5`"
+		printf '%s\n' "${_file}" | \
+			DO_FETCH_ISLOCKED=YES lockf -k -s .locks/${lkfile}.lk sh $0 || exit 1
+	done
+	exit 0
+fi
+
 . $dp_SITES_FILE
 
 # Read the list of files to fetch from stdin, one per line, instead of
@@ -154,7 +168,8 @@

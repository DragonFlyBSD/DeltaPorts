--- Uses/cargo.mk.orig
+++ Uses/cargo.mk
@@ -3,15 +3,15 @@
 #
 # Feature:	cargo
 # Usage:	USES=cargo
-# Valid ARGS:	none
+# Valid ARGS:	extra
 #
 # MAINTAINER: rust@FreeBSD.org
 
 .if !defined(_INCLUDE_USES_CARGO_MK)
 _INCLUDE_USES_CARGO_MK=	yes
 
-.  if !empty(cargo_ARGS)
-IGNORE+=	USES=cargo takes no arguments
+.  if !empty(cargo_ARGS:Nextra)
+IGNORE+=	USES=cargo only takes the optional argument "extra"
 .  endif
 
 .sinclude "${MASTERDIR}/Makefile.crates"
@@ -20,6 +20,15 @@
 # CARGO_CRATES will be downloaded from MASTER_SITE_CRATESIO.
 CARGO_CRATES?=
 
+# DragonFly: per-crate patches. This must come after Makefile.crates and
+# the CARGO_CRATES default. cargo-extra.mk expands CARGO_CRATES in a .for
+# loop, which bmake evaluates at parse time, so including it any earlier
+# sees an empty list and silently adds nothing for every port that keeps
+# its crates in Makefile.crates.
+.  if ${cargo_ARGS:Mextra}
+.    include "${USESDIR}/cargo-extra.mk"
+.  endif
+
 # List of features to build (space separated list).
 # Use special token --no-default-features to disable default
 # features by passing it to cargo build/install/test.
@@ -152,7 +161,7 @@
 .  endif
 
 # Adjust -C target-cpu if -march/-mcpu is set by bsd.cpu.mk
-.  if ${ARCH} == amd64 || ${ARCH} == i386
+.  if ${ARCH} == x86_64 || ${ARCH} == i386
 RUSTFLAGS+=	${CFLAGS:M-march=*:S/-march=/-C target-cpu=/}
 .  elif ${ARCH:Mpowerpc*}
 RUSTFLAGS+=	${CFLAGS:M-mcpu=*:S/-mcpu=/-C target-cpu=/:S/power/pwr/}
@@ -251,9 +251,14 @@
 .  if ${_CARGO_CRATES:Mopenssl-sys}
 # Make sure that openssl-sys can find the correct version of OpenSSL
 CARGO_ENV+=	OPENSSL_LIB_DIR=${OPENSSLLIB} \
 		OPENSSL_INCLUDE_DIR=${OPENSSLINC}
+# DragonFly has no base OpenSSL, and ports using openssl-sys do not always
+# carry USES=ssl, which leaves OPENSSLLIB/OPENSSLINC empty and makes the
+# probe fall back to /usr/lib. Include ssl.mk, the way the pkg-config
+# block below includes pkgconfig.mk.
+.include "${USESDIR}/ssl.mk"
 .  endif
 
 .  if ${_CARGO_CRATES:Mpkg-config}
 .include "${USESDIR}/pkgconfig.mk"
 .  endif
@@ -261,6 +261,14 @@
 .  if ${_CARGO_CRATES:Mzstd-sys}
 # Use the system's zstd instead of building the bundled version
 CARGO_ENV+=	ZSTD_SYS_USE_PKG_CONFIG=1
 .  endif
 
+# DragonFly: clang-sys has no fallback search directories for DragonFly and
+# llvm-config is not on PATH, so bindgen fails with "Unable to find libclang".
+# Point it at the USES=llvm prefix, falling back to LLVM_DEFAULT, unless the
+# port already sets LIBCLANG_PATH itself.
+.  if ${_CARGO_CRATES:Mbindgen} && empty(MAKE_ENV:MLIBCLANG_PATH=*) && empty(CARGO_ENV:MLIBCLANG_PATH=*)
+CARGO_ENV+=	LIBCLANG_PATH=${LLVM_PREFIX:U${LOCALBASE}/llvm${LLVM_DEFAULT}}/lib
+.  endif
+
 .  for _index _crate _name _version in ${_CARGO_CRATES}

port filesystems/gvfs
type port
reason "DragonFly: remove bsdisks/lsof and disable udisks2 volume monitor; materialize GNOME50 build patches"
target @any

text line-remove file Makefile exact "RUN_DEPENDS=	bsdisks>0:sysutils/bsdisks \\" on-missing noop
text line-remove file Makefile exact "		lsof:sysutils/lsof" on-missing noop

file materialize dragonfly/patch-meson.build -> dragonfly/patch-meson.build
file materialize dragonfly/Makefile -> Makefile
file materialize dragonfly/patch-daemon_org.gnome.system.smb.gschema.xml -> files/patch-daemon_org.gnome.system.smb.gschema.xml

file materialize dragonfly/pkg-plist -> pkg-plist

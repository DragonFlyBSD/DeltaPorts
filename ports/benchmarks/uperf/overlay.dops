port benchmarks/uperf
type port
reason "auto-converted from compat (Makefile.DragonFly + dragonfly/)"
target @any

mk add CONFIGURE_ARGS "--with-ssl-includes=${OPENSSLINC} --with-ssl-libs=${OPENSSLLIB}"

# 1.0.8 regenerates configure (USES=autoreconf) and ships none, so the
# DragonFly case (FreeBSD settings, no SCTP) goes into configure.ac
# (dragonfly/@<line>/patch-configure.ac).

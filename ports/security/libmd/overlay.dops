port security/libmd
type dport
reason "DragonFly-only port; source in newport/"
target @any

# md5.h declares MD5Transform with array parameters while md5c.c defines
# it with plain pointers. Same ABI, but gcc 12's -Warray-parameter fires
# and the library builds with -Werror. Keep it a warning; 6.4's gcc 8
# has no -Warray-parameter and rejects the flag.
target @2026Q4,@main

mk ensure-include bsd.port.options.mk
mk block set condition "${DFLYVERSION} >= 600500" <<'MK'
CFLAGS+=	-Wno-error=array-parameter
MK

port security/openssh-portable
type port
reason "disable libutil/stackprotect/blocklistd, add mit flavor, dragonfly sshd.c patch"
target @any

mk add CONFIGURE_ARGS --disable-libutil
mk add CONFIGURE_ARGS --without-stackprotect
mk eval OPTIONS_DEFAULT "${OPTIONS_DEFAULT:NBLOCKLISTD}"
mk add FLAVORS mit
mk set mit_PKGNAMESUFFIX "-portable-mit"

mk block set condition "${FLAVOR:U} == mit" <<'MK'
OPTIONS_DEFAULT+=	MIT
MK


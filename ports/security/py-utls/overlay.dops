port security/py-utls
type port
reason "DragonFly: point bindgen at the llvm port's libclang"
target @2026Q4,@main

# boring-sys runs bindgen, whose clang-sys looks for libclang.so in a fixed
# directory list without DragonFly's llvm prefix ("Unable to find
# libclang"). The maturin build (CARGO_BUILD=no, pep517) sees MAKE_ENV.
mk add MAKE_ENV "LIBCLANG_PATH=${LLVM_PREFIX}/lib"

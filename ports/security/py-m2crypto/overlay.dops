port security/py-m2crypto
type port
reason "auto-converted from compat (Makefile.DragonFly + dragonfly/)"

# setup.py runs "cc $CFLAGS -E -include openssl/x509_vfy.h" and links
# -lssl -lcrypto; FreeBSD finds base OpenSSL there, DragonFly's comes from
# ports, so add LOCALBASE to the include and library paths.
target @2026Q4,@main
mk add USES "localbase:ldflags"

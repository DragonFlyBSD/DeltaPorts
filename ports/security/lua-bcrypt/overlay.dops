port security/lua-bcrypt
type port
reason "auto-converted from Makefile.DragonFly"
target @any

mk add USES "ssl"
mk add CFLAGS "-I${OPENSSLINC}"
mk add LDFLAGS "-L${OPENSSLLIB}"

# dragonfly/@2026Q4, @main: src/ggentropy.c picks arc4random_buf()
# on Free/Open/NetBSD and #errors on anything unlisted. DragonFly has
# arc4random_buf() too.

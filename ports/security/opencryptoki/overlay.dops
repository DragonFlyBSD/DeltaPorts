port security/opencryptoki
type port
reason "auto-converted from compat (Makefile.DragonFly + dragonfly/)"
target @any

mk add CONFIGURE_ARGS "--enable-locks"

# dragonfly/patch-usr_sbin_pkcsslotd_log.c: cast pthread_self() for %lu.

# dragonfly/@<line>/ (3.19): FreeBSD's patches key their BSD paths on
# __FreeBSD__ (USES=alias used to cover DragonFly); add __DragonFly__ for
# <limits.h>, getenv, sys/endian.h, rfork and LOCAL_PEERCRED. DragonFly's
# xucred has no cr_pid or cr_gid: take cr_groups[0], and let the client
# fill in its own pid.

port security/arti
type port
reason "DragonFly: rustix 1.1.4 offers IPv4 source-specific multicast it lacks"
target @any

# dragonfly/@2026Q4, @main: rustix 1.1.4 gates
# set_ip_{add,drop}_source_membership on freebsdlike, which includes
# DragonFly, but DragonFly has no IP_ADD_SOURCE_MEMBERSHIP/ip_mreq_source
# (neither in <netinet/in.h> nor in the libc crate). Narrow the gate to
# FreeBSD.
#
# Also patch-cargo-crates_notify-8.2.0_Cargo.toml: notify keys its kqueue
# and mio dependencies on target_os "dragonflybsd", which does not exist
# (devel/ruff's patch).

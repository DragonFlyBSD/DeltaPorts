port x11-toolkits/gtk40
type port
reason "build without the F16C ifuncs, which DragonFly's rtld cannot resolve under -z now"
target @any

# The F16C fast paths in gsk/gl/fp16.c are ifuncs. gtk links with -z now,
# which puts their GOT slots in RELRO, and DragonFly's rtld write-protects
# RELRO before it resolves ifuncs, so anything linking libgtk-4 crashes
# in ld-elf.so.2 at load. Use the plain C half-float conversions.
mk add MESON_ARGS "-Df16c=disabled"

mk bump PORTREVISION

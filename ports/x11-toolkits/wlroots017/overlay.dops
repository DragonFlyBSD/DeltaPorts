port x11-toolkits/wlroots017
type port
reason "auto-converted from compat (Makefile.DragonFly + dragonfly/)"
target @any

# wayland-util.h calls round() without <math.h>; wlroots forces
# -Werror via meson 'werror=true' so the implicit declaration is fatal.
# Disable meson werror instead of chasing per-warning -Wno-error names
# (clang's builtin-declaration diagnostic isn't demoted by those).
mk add MESON_ARGS "-Dwerror=false"

file materialize dragonfly/patch-render_gles2_renderer.c -> dragonfly/patch-render_gles2_renderer.c
file materialize dragonfly/patch-render_vulkan_vulkan.c -> dragonfly/patch-render_vulkan_vulkan.c

port www/p5-HTTP-MHTTP
type port
reason "auto-converted from Makefile.DragonFly"
target @any

mk add USES "ssl"
mk add CFLAGS "-I${OPENSSLINC}"
mk add LDLAGS "-L${OPENSSLLIB}"

# The @any "mk add CFLAGS" lands in the Makefile's ".if ${OPSYS} == FreeBSD"
# block (the only CFLAGS line), so DragonFly never gets -I${OPENSSLINC}, and
# mhttp/mhttp.h cannot find <openssl/crypto.h>. Add it unconditionally; it
# reaches the mhttp sub-build through CCFLAGS="${CFLAGS}" (perl5.mk).
target @2026Q4,@main
text line-insert-after file Makefile anchor "CONFIGURE_ENV=\tGOTSSL=yes" line "CFLAGS+=\t-I${OPENSSLINC}"

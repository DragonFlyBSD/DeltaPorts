port www/srt
type port
reason "Update SRT to 1.5.6 for the FFmpeg closure and fix CVE-2026-55868 and CVE-2026-55869"
target @any

mk set DISTVERSION "1.5.6"
file materialize distinfo -> distinfo
text replace-once file pkg-plist from "lib/libsrt.so.1.5.5" to "lib/libsrt.so.1.5.6"
file materialize dragonfly/patch-CMakeLists.txt -> dragonfly/patch-CMakeLists.txt

port www/monolith
type port
reason "auto-converted from Makefile.DragonFly"
target @any

mk eval USES "${USES:S/cargo/cargo:extra/}"

# 2.10.1 enables openssl/vendored by default, and the vendored OpenSSL
# (openssl-src) builds its devcrypto engine on BSD, which needs
# <crypto/cryptodev.h>; DragonFly has none. Use the ports OpenSSL that
# cargo.mk already points openssl-sys at. 2.11 (main) no longer vendors.
target @2026Q3,@2026Q4

mk add CARGO_ENV "OPENSSL_NO_VENDOR=1"

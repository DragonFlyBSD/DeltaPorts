port www/nghttp2
type port
reason "auto-converted from compat (Makefile.DragonFly + dragonfly/)"
target @any

mk eval CONFIGURE_ARGS "${CONFIGURE_ARGS:N--with-jemalloc}"

# 1.70 is C++23 (compiler:c++23-lang, USE_CXXSTD=c++23), which base gcc 8.3
# (what compiler:c++23-lang resolves to) does not accept.
target @2026Q4,@main

mk set USE_GCC_VERSION "${GCC_DEFAULT}"

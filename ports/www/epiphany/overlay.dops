port www/epiphany
type port
reason "Update Epiphany to 50.4 for GNOME 50 on DragonFly"
target @any

mk unset PORTVERSION on-missing noop
mk set DISTVERSION "50.4"
mk set PORTSCOUT "limit:^50\\."
mk set USE_CLANG_FALLBACK "19"
mk target remove dfly-patch on-missing noop
file materialize distinfo -> distinfo
file materialize pkg-plist -> pkg-plist
file materialize dragonfly/patch-lib_contrib_gnome-languages.c -> files/patch-lib_contrib_gnome-languages.c
file materialize dragonfly/patch-lib_ephy-sync-utils.c -> files/patch-lib_ephy-sync-utils.c

port www/sarg
type port
reason "gcc format warnings; DragonFly in the sources' __FreeBSD__ tests"
target @any

mk add CFLAGS "-Wno-format-truncation -Wno-format-overflow"

# The sources test __FreeBSD__ only (USES=alias defined it, dp-r65).
mk target set dfly-patch <<'MK'
	${REINPLACE_CMD} -E -e 's/defined[ ]*\([ ]*__FreeBSD__[ ]*\)/(defined(__FreeBSD__) || defined(__DragonFly__))/g' \
		-e 's/^#([[:space:]]*)ifdef[[:space:]]+__FreeBSD__/#\1if defined(__FreeBSD__) || defined(__DragonFly__)/' \
		-e 's/^#([[:space:]]*)ifndef[[:space:]]+__FreeBSD__/#\1if !defined(__FreeBSD__) \&\& !defined(__DragonFly__)/' \
		${WRKSRC}/util.c ${WRKSRC}/topuser.c
MK

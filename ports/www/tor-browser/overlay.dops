port www/tor-browser
type port
reason "Gecko built like www/firefox (clang + libc++, XP_FREEBSD, hidden visibility, no WASM sandbox); its overlay explains each part"
target @any

mk eval OPTIONS_DEFAULT "${OPTIONS_DEFAULT:NPULSEAUDIO}"
mk eval OPTIONS_DEFAULT_x86_64 "${OPTIONS_DEFAULT_x86_64:NLTO}"

mk add MOZ_OPTIONS --disable-webrtc
# In the eval: mk add skips the option, which the powerpc64 branch has.
# configure rejects --with-wasi-sysroot together with it.
mk eval MOZ_OPTIONS "${MOZ_OPTIONS:N--with-wasi-sysroot*} --without-wasm-sandboxed-libraries"
# No --with-clang-path: bindgen.configure rejects it once CC is clang.
mk add MOZ_OPTIONS "--with-libclang-path=${LLVM_PREFIX}/lib"
mk add CXXFLAGS -Wno-multistatement-macros
mk add CXXFLAGS -Wno-class-memaccess
mk add CXXFLAGS "-stdlib=libc++"
mk add CXXFLAGS "-cxx-isystem ${LLVM_PREFIX}/include/c++/v1"
mk add BUILD_DEPENDS "${LOCALBASE}/llvm${LLVM_VERSION}/include/c++/v1/new:devel/libcxx${LLVM_VERSION}"
mk add LDFLAGS "-L${LLVM_PREFIX}/lib"
mk add LIB_DEPENDS "libc++.so.1:devel/libcxx${LLVM_VERSION}"
# Host build scripts link base gcc's libstdc++, outside rtld's default path.
mk add LDFLAGS "-Wl,-rpath,/usr/lib/${DFLY_BASE_CCVER}"
# 6.4's libc only has weak pthread stubs: libthread_xu must come first.
mk ensure-include bsd.port.options.mk
mk block set condition "${DFLYVERSION} < 600500" <<'MK'
LDFLAGS+=	-Wl,--no-as-needed -lpthread -Wl,--as-needed
MK
mk add CONFIGURE_ENV "BINDGEN_CFLAGS=\"-I${LOCALBASE}/include -stdlib=libc++ -cxx-isystem ${LLVM_PREFIX}/include/c++/v1\""

# Big-endian work in progress: on x86_64 it zeroes the BGRX alpha offset.
file remove files/patch-bug1504834_comment5 on-missing noop

mk set BINARY_ALIAS "clang=${LOCALBASE}/llvm${LLVM_VERSION}/bin/clang clang++=${LOCALBASE}/llvm${LLVM_VERSION}/bin/clang++ wasm-ld=${LOCALBASE}/llvm${LLVM_VERSION}/bin/wasm-ld"
# bsd.gecko.mk picks clang only if /usr/lib/libc++.so exists.
mk set CC "${LLVM_PREFIX}/bin/clang"
mk set CXX "${LLVM_PREFIX}/bin/clang++"
mk set CPP "${LLVM_PREFIX}/bin/clang-cpp"

mk target set dfly-patch <<'MK'
	# disable SCTP
	${REINPLACE_CMD} -e 's|MOZ_SCTP|MOZ_DISABLE_SCTP|' \
		${WRKSRC}/netwerk/moz.build
	(cd ${WRKSRC}/gfx/angle/checkout/src/compiler/translator && \
		${REINPLACE_CMD} -e 's|<math.h>|<cmath>|' \
		InfoSink.h IntermNode.cpp)
	${REINPLACE_CMD} -e 's@_XOPEN_SOURCE@&___@g' \
		${WRKSRC}/media/libcubeb/src/cubeb_alsa.c
	${REINPLACE_CMD} -e 's@_POSIX_SOURCE@&___@g' \
		${WRKSRC}/media/libcubeb/src/cubeb_jack.cpp
	${REINPLACE_CMD} -e 's@gtk+-wayland@&z@g' \
		${WRKSRC}/toolkit/moz.configure
MK

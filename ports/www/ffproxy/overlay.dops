port www/ffproxy
type port
reason "DragonFly: take main's distinfo for the regenerated codeberg archive"

# codeberg regenerated the archive and every mirror serves the new one;
# freebsd-ports main re-rolled distinfo for it.
target @2026Q4
text replace-once file distinfo from "TIMESTAMP = 1716348681" to "TIMESTAMP = 1791704270"
text replace-once file distinfo from "SHA256 (ffproxy-1.72.tar.gz) = f7dda759ae20f47f86361f55fa3a23cb6b2fbd631b89f8aca7264f6b6d7fa156" to "SHA256 (ffproxy-1.72.tar.gz) = 0ec7a3a6186f87a7fd732a020b37725bbea14cb6d5a452e1fa86d2465acdd7c2"
text replace-once file distinfo from "SIZE (ffproxy-1.72.tar.gz) = 78395" to "SIZE (ffproxy-1.72.tar.gz) = 78263"

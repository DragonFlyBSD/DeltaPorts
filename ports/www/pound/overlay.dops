port www/pound
type port
reason "auto-converted from compat (Makefile.DragonFly + dragonfly/)"
target @any

mk eval OPTIONS_DEFAULT "${OPTIONS_DEFAULT:NDSAPARAM}"
mk target set dfly-patch <<'MK1'
	${REINPLACE_CMD} -e "s@openssl dhparam@${LOCALBASE}/bin/&@g" \
		${WRKSRC}/Makefile.in
MK1
# OpenSSL comes from ports.
mk add CPPFLAGS "-I${OPENSSLINC}"
mk add LDFLAGS "-L${OPENSSLLIB}"

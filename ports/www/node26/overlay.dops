port www/node26
type port
reason "build with GCC 13 like node24 and apply DragonFly V8 fixes"

# USES=compiler:c++20-lang resolves to base gcc 8, which rejects
# -std=gnu++20. Use gcc 13, as www/node24 does, to match the C++ shared
# dependencies (libada, simdjson, nbytes) built with it.
#
# dragonfly/: node24's DragonFly V8 patches, re-cut where node 26 moved the
# context (trap handler, abseil config.h and time_zone_format.cc); the
# large-pages patch is gone because node 26 removed src/large_pages.
target @2026Q4,@main

mk set USE_GCC_VERSION "13"

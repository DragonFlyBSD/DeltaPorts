file materialize dragonfly/patch-mozglue_baseprofiler_moz.build -> dragonfly/patch-mozglue_baseprofiler_moz.build
file materialize dragonfly/patch-mozglue_baseprofiler_public_ProfilerPlatformMacros.h -> dragonfly/patch-mozglue_baseprofiler_public_ProfilerPlatformMacros.h
file materialize dragonfly/patch-netwerk_dns_moz.build -> dragonfly/patch-netwerk_dns_moz.build
file materialize dragonfly/patch-third__party_angle_angle__common__gn_moz.build -> dragonfly/patch-third__party_angle_angle__common__gn_moz.build
file materialize dragonfly/patch-third__party_angle_angle__program__version__id__gn_moz.build -> dragonfly/patch-third__party_angle_angle__program__version__id__gn_moz.build
file materialize dragonfly/patch-third__party_rust_mtu_build.rs -> dragonfly/patch-third__party_rust_mtu_build.rs
file materialize dragonfly/patch-third__party_rust_mtu_src_bsd.rs -> dragonfly/patch-third__party_rust_mtu_src_bsd.rs
file materialize dragonfly/patch-third__party_rust_mtu_src_lib.rs -> dragonfly/patch-third__party_rust_mtu_src_lib.rs
file materialize dragonfly/patch-third__party_sqlite3_src_moz.build -> dragonfly/patch-third__party_sqlite3_src_moz.build
file materialize dragonfly/patch-tools_profiler_lul_LulElfInt.h -> dragonfly/patch-tools_profiler_lul_LulElfInt.h
file materialize dragonfly/patch-tools_profiler_moz.build -> dragonfly/patch-tools_profiler_moz.build
file materialize dragonfly/patch-toolkit_library_gen__buildid.py -> dragonfly/patch-toolkit_library_gen__buildid.py
file materialize dragonfly/patch-toolkit_moz.configure -> dragonfly/patch-toolkit_moz.configure
file materialize dragonfly/dragonfly.js -> files/dragonfly.js
file materialize dragonfly/firefox.sh -> files/firefox.sh
mk target append post-install <<'MK'
	${INSTALL_DATA} ${FILESDIR}/dragonfly.js \
		${STAGEDIR}${PREFIX}/lib/firefox/defaults/pref/dragonfly.js
	${RM} ${STAGEDIR}${PREFIX}/bin/firefox
	${INSTALL_SCRIPT} ${FILESDIR}/firefox.sh ${STAGEDIR}${PREFIX}/bin/firefox
MK

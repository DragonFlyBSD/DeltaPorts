port textproc/redisearch
type port
reason "auto-converted from compat (Makefile.DragonFly + dragonfly/)"

# search_ctx.h maps CLOCK_MONOTONIC_RAW for FreeBSD only
# (dragonfly/@<line>/patch-src_search__ctx.h).
#
# FreeBSD's files/ patches pick CLOCK_MONOTONIC for freebsd in the Rust code,
# leaving `clock` undefined on dragonfly; take the FreeBSD branch there too.
target @2026Q4,@main

mk target set dfly-patch <<'MK'
	${GREP} -rlF 'cfg(target_os = "freebsd")] let clock' ${WRKSRC}/src/redisearch_rs | \
		${XARGS} ${REINPLACE_CMD} -e 's|#\[cfg(target_os = "freebsd")] let clock|#[cfg(any(target_os = "freebsd", target_os = "dragonfly"))] let clock|'
MK

port textproc/kf6-syntax-highlighting
type port
reason "auto-converted from Makefile.DragonFly"
target @any

# std::format needs libstdc++ 13 or later; base gcc 12 has none (dp-y0f).
mk set USE_GCC_VERSION "14"

mk target set dfly-patch <<'MK1'
	${REINPLACE_CMD} -e 's/^.*\- name: FreeBSD/&\n    - name: DragonFly/g' \
		${WRKSRC}/metainfo.yaml
MK1

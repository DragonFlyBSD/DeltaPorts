port textproc/py-deepsearch-glm
type port
reason "DragonFly: give the bundled loguru a numeric thread id; C++20 compiler"

# dragonfly/: loguru's get_thread_name() falls back to assigning
# pthread_self() to a uint64_t, which only compiles where pthread_t is an
# integer. Use pthread_getthreadid_np() on DragonFly (the patch targets the
# copy post-extract unpacks under build/_deps/).

# CMakeLists.txt sets CMAKE_CXX_STANDARD 20 and the sources use
# std::string::starts_with/ends_with, which base gcc 8's libstdc++ lacks.
target @2026Q3,@2026Q4,@main

mk set USE_GCC_VERSION "${GCC_DEFAULT}"

port textproc/fcitx5-qt
type port
reason "DragonFly: libc++, like textproc/fcitx5"

# textproc/fcitx5 builds with clang and libc++ and its C++ API passes libc++'s
# std:: types, so build against it the same way. The qt6 flavor still fails:
# Qt6 exports std:: API (toStdString(), QUnhandledException), dp-shs.90.
target @2026Q4,@main

mk add USES "dfly-libcxx"

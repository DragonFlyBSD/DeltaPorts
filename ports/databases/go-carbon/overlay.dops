port databases/go-carbon
type port
reason "Statfs_t.Blocks is int64 on DragonFly"
target @any

# carbonserver.go multiplies stat.Blocks by a uint64.
mk target set dfly-patch <<'MK'
	${REINPLACE_CMD} -e 's/:= stat\.Blocks \* uint64(stat\.Bsize)/:= uint64(stat.Blocks) * uint64(stat.Bsize)/' \
		${WRKSRC}/carbonserver/carbonserver.go
MK

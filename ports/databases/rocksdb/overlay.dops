port databases/rocksdb
type port
reason "drop BROKEN_DragonFly; link system googletest in the DragonFly branch, as FreeBSD's patch does for FreeBSD"
target @any

# -Werror is off anyway: MAKE_ENV has DISABLE_WARNING_AS_ERROR=yes.
text line-remove file Makefile exact "BROKEN_DragonFly=	does not build on DragonFly BSD using GCC with -Werror"

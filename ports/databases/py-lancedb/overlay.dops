port databases/py-lancedb
type port
reason "opt into cargo:extra for the aws-lc-sys getentropy() patch"
target @any

mk eval USES "${USES:S/cargo/cargo:extra/}"
# the crates are vendored beside python/ (CARGO_SRC_SUBDIR=..), and the crate
# patches name them from there; the port has no patches of its own
mk set PATCH_WRKSRC "${WRKSRC}/${CARGO_SRC_SUBDIR}"

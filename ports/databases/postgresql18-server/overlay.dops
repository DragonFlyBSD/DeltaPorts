port databases/postgresql18-server
type port
reason "add freebsd template while this is the master port"

# On 2026Q1-Q2 this is the master postgresql port. From 2026Q3 it is a slave
# of postgresql19-server, whose overlay adds the template; adding it here
# too would write CONFIGURE_ARGS= ahead of that include and wipe the
# arguments of this port's own slaves (contrib, pl*).
target @2026Q1,@2026Q2

mk add CONFIGURE_ARGS "--with-template=freebsd"

port databases/openldap27-server
type port
reason "DragonFly: declarations after case labels in tls_o.c (gcc 8)"

# dragonfly/@2026Q4 (also used by openldap27-client, a slave of this port):
# 2.7.1's tls_o.c starts three case blocks with a declaration, which base
# gcc 8.3 rejects ("a label can only be part of a statement"). 2.7.2 on main
# adds braces upstream.

# SMBPWD (contrib smbk5pwd) builds with -DDO_KRB5 against the base Heimdal,
# which DragonFly does not have (krb5.h). Do what FreeBSD 15 does on each
# line: 2026Q4 excludes the option, main builds the overlay without DO_KRB5.
target @2026Q4
mk set OPTIONS_EXCLUDE_DragonFly "SMBPWD"
target @main
mk target set dfly-patch <<'MK'
	@${REINPLACE_CMD} -e 's|-DDO_KRB5 ||' \
		-e 's|^HEIMDAL_INC =.*|HEIMDAL_INC =|' \
		-e 's|^HEIMDAL_LIB =.*|HEIMDAL_LIB =|' \
		${WRKSRC}/contrib/slapd-modules/smbk5pwd/Makefile
MK

port databases/evolution-data-server
type port
reason "auto-converted from Makefile.DragonFly"
target @any
mk remove OPTIONS_DEFAULT GSSAPI_BASE
mk add OPTIONS_DEFAULT GSSAPI_MIT

mk add BUILD_DEPENDS "krb5-config:security/krb5"
mk add RUN_DEPENDS "krb5-config:security/krb5"
file materialize dragonfly/patch-src_camel_camel-debug.c -> dragonfly/patch-src_camel_camel-debug.c
mk set DISTVERSION "3.60.2"
mk unset PORTREVISION
file materialize dragonfly/distinfo -> distinfo
file remove files/patch-sqlite-qds_camel-db.c
file materialize dragonfly/patch-sqlite-qds_camel-db.c -> files/patch-sqlite-qds_camel-db.c
file materialize dragonfly/pkg-plist -> pkg-plist

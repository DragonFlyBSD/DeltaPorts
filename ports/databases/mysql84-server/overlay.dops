port databases/mysql84-server
type port
reason "DragonFly: fix vendored abseil cctz _XOPEN_SOURCE visibility; build with modern GCC (base gcc80 lacks C++20); drop SASLCLIENT default (no Kerberos/GSSAPI dev libs on DragonFly, as in mysql80); rescan static archives for abseil reference cycles"
target @any

mk set USE_GCC_VERSION "13"
mk eval OPTIONS_DEFAULT "${OPTIONS_DEFAULT:NSASLCLIENT}"
mk add LDFLAGS "-Wl,--start-group"

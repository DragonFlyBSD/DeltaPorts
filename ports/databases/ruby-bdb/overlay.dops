port databases/ruby-bdb
type port
reason "Give bdb_append_internal()'s retval a type"

# FreeBSD's files/patch-src-common.c converts bdb_append_internal() to a
# prototype but leaves its last parameter without a type, which gcc
# rejects ("unknown type name 'retval'"). Callers pass Qtrue/Qfalse.
target @2026Q3,@2026Q4,@main

text replace-once file files/patch-src-common.c from "+bdb_append_internal(int argc, VALUE *argv, VALUE obj, int flag, retval)" to "+bdb_append_internal(int argc, VALUE *argv, VALUE obj, int flag, VALUE retval)"

port databases/redis80
type port
reason "DragonFly: point the build at the ports OpenSSL and take malloc_usable_size() from <malloc_np.h>"

# FreeBSD's port relies on the base OpenSSL; on DragonFly the TLS build needs
# OPENSSL_PREFIX (src/Makefile and deps/hiredis add -I/-L from it).
# dragonfly/@<line>/patch-src_zmalloc.h: DragonFly has no <malloc.h>; it
# declares malloc_usable_size() in <malloc_np.h>, as FreeBSD does.

target @2026Q4,@main
mk add TLS_MAKE_ENV "OPENSSL_PREFIX=${OPENSSLBASE}"

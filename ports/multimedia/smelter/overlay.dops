port multimedia/smelter
type port
reason "opt into cargo:extra for aws-lc-sys 0.37.1, audiopus_sys, ffmpeg-next and shared_memory DragonFly patches; wgpu (git) Vulkan cfgs; parent watcher"
target @any

mk eval USES "${USES:S/cargo/cargo:extra/}"

# wgpu (git) enables Vulkan and GLES only on Linux, Android, FreeBSD and Windows;
# files/ gives server.rs's parent watcher a FreeBSD cfg only.
mk target set dfly-patch <<'MK'
	${REINPLACE_CMD} -e 's/target_os = "freebsd"/&, target_os = "dragonfly"/' \
		${WRKSRC}/src/server.rs \
		${WRKDIR}/wgpu-*/wgpu/build.rs ${WRKDIR}/wgpu-*/wgpu-hal/build.rs \
		${WRKDIR}/wgpu-*/wgpu-core/build.rs ${WRKDIR}/wgpu-*/wgpu-core/Cargo.toml \
		${WRKDIR}/wgpu-*/wgpu-core/platform-deps/windows-linux-android/Cargo.toml
MK

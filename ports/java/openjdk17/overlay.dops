port java/openjdk17
type port
reason "DragonFly: boot from java/bootstrap-openjdk17, build args, and the BSD/DragonFly porting patch set"
target @any

# --- Makefile.DragonFly equivalent --------------------------------------
# zrj: no idea why CONF_CHECK=ignore is needed.
mk add MAKE_ARGS "CONF_CHECK=ignore"
mk add CONFIGURE_ARGS "--with-stdc++lib=dynamic"

patch apply diffs/Makefile.diff

# --- bootstrap JDK ------------------------------------------------------
# Upstream boots from a prebuilt FreeBSD JDK extracted into
# ${WRKDIR}/boot-jdk. That binary is FreeBSD-branded ELF and cannot exec
# on DragonFly, so boot from the DragonFly-native java/bootstrap-openjdk17
# (17 boots 17) the way java/openjdk11 does.
target @2026Q4,@main

mk set BOOTSTRAPJDKDIR "${LOCALBASE}/bootstrap-openjdk17"
mk add BUILD_DEPENDS "${LOCALBASE}/bootstrap-openjdk17/bin/javac:java/bootstrap-openjdk17"

# 17.0.20 requires elfctl on bsd.freebsd, which our platform.m4 patch makes
# DragonFly too, to mark executables +wxneeded. DragonFly has neither the
# tool nor W^X; configure only takes a tool override on its command line.
target @2026Q4

mk add CONFIGURE_ARGS "ELFCTL=/usr/bin/true"

target @main

mk add CONFIGURE_ARGS "ELFCTL=/usr/bin/true"

port java/eclipse
type port
reason "DragonFly: build the SWT natives the FreeBSD way"
target @any

# SWT's native build.sh only takes the gmake + FREEBSD_OS path when OS is
# FreeBSD; for any other uname it runs bmake on the GNU make_unix.mak and
# dies on "Invalid line ifdef ...". It reads OS from the environment first,
# and the fragment being built is gtk.freebsd.x86_64 anyway.
mk add MAVEN_ENV "OS=FreeBSD"

# DPorts builds gtk40 (and may build gtk30) without the Wayland backend, so
# gdk/wayland/gdkwayland.h does not exist and SWT's os.h fails to compile.
# Route both Wayland includes through a header that includes them only
# under GDK_WINDOWING_WAYLAND and otherwise makes GDK_IS_WAYLAND_DISPLAY()
# false. CollectSources copies every file in the library folder, so the new
# header reaches the natives build directory.
target @2026Q3,@2026Q4,@main
mk target set dfly-patch <<'MK1'
	@${PRINTF} '#ifdef GDK_WINDOWING_WAYLAND\n#if GTK_CHECK_VERSION(4,0,0)\n#include <gdk/wayland/gdkwayland.h>\n#else\n#include <gdk/gdkwayland.h>\n#endif\n#else\n#define GDK_IS_WAYLAND_DISPLAY(display) FALSE\n#endif\n' \
		> "${WRKSRC}/eclipse.platform.swt/bundles/org.eclipse.swt/Eclipse SWT PI/gtk/library/dfly_wayland.h"
	${REINPLACE_CMD} -e 's|^#include <gdk/wayland/gdkwayland.h>|#include "dfly_wayland.h"|' \
		-e 's|^#include <gdk/gdkwayland.h>|#include "dfly_wayland.h"|' \
		"${WRKSRC}/eclipse.platform.swt/bundles/org.eclipse.swt/Eclipse SWT PI/gtk/library/os.h"
MK1

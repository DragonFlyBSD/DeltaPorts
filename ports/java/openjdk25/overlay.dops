port java/openjdk25
type port
reason "DragonFly: boot from a DragonFly-native JDK on avalon, build args, and the BSD/DragonFly porting patch set"
target @any

# --- Makefile.DragonFly equivalent --------------------------------------
# zrj: no idea why CONF_CHECK=ignore is needed.
mk add MAKE_ARGS "CONF_CHECK=ignore"
mk add CONFIGURE_ARGS "--with-stdc++lib=dynamic"
# gcc rejects the prebuilt PCH here: "one or more PCH files were found,
# but they were invalid" then "precompiled.hpp: No such file or directory".
mk add CONFIGURE_ARGS "--disable-precompiled-headers"

# Upstream's compiler-selection and aarch64 blocks are FreeBSD-only: they
# reach for USE_GCC/GCC_DEFAULT and clang warning flags that do not apply
# here, and DragonFly has no aarch64. DPorts only ever builds on DragonFly,
# so emptying both regions is equivalent to wrapping them in
# .if ${OPSYS} == "FreeBSD". Emptying rather than disabling because the
# first region has an .else branch that must go too.
mk block set condition "${COMPILER_TYPE} == gcc" <<'MK'
# DragonFly: upstream's gcc/clang flag selection is FreeBSD-only.
MK
mk block set condition "${ARCH} == aarch64" <<'MK'
# DragonFly: no aarch64 here.
MK

# The JDK installs its JNI headers under include/<os>; nothing generates
# an include/dragonfly, so clone it from include/freebsd before
# COPYTREE_SHARE stages the image directory. Anchored on the do-install
# MKDIR line so it lands before the copy, not appended after it.
# Guarded: jre_headless/headless legacy images have no include/freebsd.
text line-insert-after file Makefile \
     anchor "	@${MKDIR} ${STAGEDIR}${INSTALLDIR}" \
     line   "	@if [ -d ${JDK_IMAGEDIR}/include/freebsd ]; then ${CP} -rv ${JDK_IMAGEDIR}/include/freebsd ${JDK_IMAGEDIR}/include/dragonfly; fi"

# --- bootstrap JDK ------------------------------------------------------
# Upstream fetches a prebuilt *FreeBSD* JDK into ${WRKDIR}/boot-jdk
# (freebsd-ports D54683/D54731 replaced the old "build from the previous
# version" chain with this). That binary is FreeBSD-branded ELF and dies
# on DragonFly with `ELF binary type "9" not known` / Exec format error,
# so point the :boot group at a DragonFly-native tarball instead and
# leave BOOTSTRAPJDKDIR alone. Same shape as lang/rust.
#
# OpenJDK only accepts N-1 or N as a boot JDK (version-numbers.conf
# DEFAULT_ACCEPTABLE_BOOT_VERSIONS), so 25 needs a native 24. freebsd-ports
# deleted java/openjdk22, 23 and 24 once nothing depended on them, so the
# chain was rebuilt here from the last commit before each removal:
# 21 (native package) -> 22 -> 23 -> 24, each rung repackaged as a
# boot-jdk/ tarball on avalon. The tarball is the DragonFly
# openjdk24-24.0.2+12.2 package payload, re-rooted as boot-jdk/ to match
# what upstream extracts.
mk add MASTER_SITES "https://avalon.dragonflybsd.org/misc/distfiles/openjdk/:boot"
mk set BOOTSTRAPJDKFILE "openjdk24-24.0.2+12.2.${JDK_ARCH}.tar.xz"

# --- diffs/distinfo.diff equivalent -------------------------------------
# Chained so each line anchors on the one inserted before it. The anchor is
# upstream's own x86_64 bootstrap SIZE; if freebsd-ports bumps the bootstrap
# this stops matching and compose fails loudly, which is the point - the
# DragonFly tarball has to be revisited at the same time.
text line-insert-after file distinfo \
     anchor "SIZE (openjdk25-25.0.1+8.f.1.x86_64.tar.xz) = 191262784" \
     line   "SHA256 (openjdk24-24.0.2+12.2.x86_64.tar.xz) = ffffaf82a094bafb352475fad981ddfe6a87a9324ea0e285f1afad6c3a436aa5"
text line-insert-after file distinfo \
     anchor "SHA256 (openjdk24-24.0.2+12.2.x86_64.tar.xz) = ffffaf82a094bafb352475fad981ddfe6a87a9324ea0e285f1afad6c3a436aa5" \
     line   "SIZE (openjdk24-24.0.2+12.2.x86_64.tar.xz) = 188730088"

# 25.0.4 requires elfctl on bsd.freebsd, which our platform.m4 patch makes
# DragonFly too, to mark executables +wxneeded. DragonFly has neither the
# tool nor W^X; configure only takes a tool override on its command line.
target @2026Q4

mk add CONFIGURE_ARGS "ELFCTL=/usr/bin/true"

target @main

mk add CONFIGURE_ARGS "ELFCTL=/usr/bin/true"

port java/openjdk21
type port
reason "DragonFly: boot from a DragonFly-native JDK on avalon, build args, and the BSD/DragonFly porting patch set"
target @any

# --- Makefile.DragonFly equivalent --------------------------------------
# zrj: no idea why CONF_CHECK=ignore is needed.
mk add MAKE_ARGS "CONF_CHECK=ignore"
mk add CONFIGURE_ARGS "--with-stdc++lib=dynamic"

patch apply diffs/Makefile.diff

# --- bootstrap JDK ------------------------------------------------------
# Upstream fetches a prebuilt *FreeBSD* JDK into ${WRKDIR}/boot-jdk
# (freebsd-ports D54683/D54731 replaced the old "build from the previous
# version" chain with this). That binary is FreeBSD-branded ELF and dies
# on DragonFly with `ELF binary type "9" not known` / Exec format error,
# so point the :boot group at a DragonFly-native tarball instead and
# leave BOOTSTRAPJDKDIR alone. Same shape as lang/rust.
#
# The tarball is the DragonFly openjdk21-21.0.6+7.1 package payload,
# re-rooted as boot-jdk/ to match what upstream extracts.
mk add MASTER_SITES "https://avalon.dragonflybsd.org/misc/distfiles/openjdk/:boot"
mk set BOOTSTRAPJDKFILE "openjdk21-21.0.6+7.1.${JDK_ARCH}.tar.xz"

# --- diffs/distinfo.diff equivalent -------------------------------------
# Chained so each line anchors on the one inserted before it. The anchor is
# upstream's own x86_64 bootstrap SIZE; if freebsd-ports bumps the bootstrap
# this stops matching and compose fails loudly, which is the point - the
# DragonFly tarball has to be revisited at the same time.
text line-insert-after file distinfo \
     anchor "SIZE (openjdk21-21.0.9+10.1.x86_64.tar.xz) = 171175000" \
     line   "SHA256 (openjdk21-21.0.6+7.1.x86_64.tar.xz) = c7b286f18eb50a2c8de51bfee57b65bf9512a7c9ef0bee700d5849285d251b8c"
text line-insert-after file distinfo \
     anchor "SHA256 (openjdk21-21.0.6+7.1.x86_64.tar.xz) = c7b286f18eb50a2c8de51bfee57b65bf9512a7c9ef0bee700d5849285d251b8c" \
     line   "SIZE (openjdk21-21.0.6+7.1.x86_64.tar.xz) = 172512764"


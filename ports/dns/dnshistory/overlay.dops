port dns/dnshistory
type port
reason "DragonFly: take main's distinfo for the regenerated codeberg archive"

# codeberg regenerated the archive and every mirror serves the new one;
# freebsd-ports main re-rolled distinfo for it.
target @2026Q4
text replace-once file distinfo from "TIMESTAMP = 1744585345" to "TIMESTAMP = 1791703533"
text replace-once file distinfo from "SHA256 (dnshistory-1.3.tar.gz) = b8a6cc6e4a3b070b4e2e38b5c8c68eb2a5a229e20ba7c9a103498459c78fde2a" to "SHA256 (dnshistory-1.3.tar.gz) = a7eccaf10e6a775ce1e00927cd7b14716fa3c3e6b5db340ade56e4c208a63230"
text replace-once file distinfo from "SIZE (dnshistory-1.3.tar.gz) = 121504" to "SIZE (dnshistory-1.3.tar.gz) = 121398"

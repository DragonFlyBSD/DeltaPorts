port sysutils/ipsc
type port
reason "DragonFly: take main's distinfo for the regenerated codeberg archive"

# codeberg regenerated the archive and every mirror serves the new one;
# freebsd-ports main re-rolled distinfo for it.
target @2026Q3,@2026Q4
text replace-once file distinfo from "TIMESTAMP = 1761844259" to "TIMESTAMP = 1791702844"
text replace-once file distinfo from "SHA256 (ipsc-0.4.4.tar.gz) = dd298249e0a6ae453fe5d9014d4868a7ab162ad5474577cdd6172e14d67f08ad" to "SHA256 (ipsc-0.4.4.tar.gz) = 0f03f1f8783ba57167886edff3a592ed6787dd1e7c20facd0524c0d22ea963c9"
text replace-once file distinfo from "SIZE (ipsc-0.4.4.tar.gz) = 25068" to "SIZE (ipsc-0.4.4.tar.gz) = 24985"

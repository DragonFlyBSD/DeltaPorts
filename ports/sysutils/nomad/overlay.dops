port sysutils/nomad
type port
reason "DragonFly support files and build tags; per-line patch sets in dragonfly/@<line>"

# 1.9.6 takes disk usage and mounts from gopsutil, FreeBSD's files/ move
# mountedPaths() into a freebsd.go, and dependencies come vendored by go
# mod vendor, so the dragonfly/@<line> patches add DragonFly files for allocdir,
# host, log_file and go-ps, and the dragonfly build tag to
# consul-template's signals and moby/term's termios.

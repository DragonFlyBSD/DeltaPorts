port sysutils/edk2
type port
reason "auto-converted from compat (Makefile.DragonFly + dragonfly/)"
target @any

mk add BUILD_DEPENDS "gcc${GCC_DEFAULT}>0:lang/gcc${GCC_DEFAULT}"
mk set DFLY_UNMAINTAINED "yes"

# Firmware for FreeBSD's bhyve, which DragonFly doesn't have.
mk block set condition "${FLAVOR:U} == bhyve" <<'MK'
IGNORE=	FreeBSD specific
MK

port sysutils/packer
type port
reason "auto-converted from compat (Makefile.DragonFly + dragonfly/)"
target @any

# Join the platforms packer builds without syft's SBOM generator, whose
# SQLite needs modernc.org/libc (dp-lu6).
mk target set dfly-patch <<'MK1'
	${REINPLACE_CMD} -e 's,^//go:build !netbsd .*,& \&\& !dragonfly,' \
		${WRKSRC}/internal/sbom/generator_syft.go
	${REINPLACE_CMD} -e 's,^//go:build netbsd .*,& || dragonfly,' \
		${WRKSRC}/internal/sbom/generator_unsupported.go
MK1

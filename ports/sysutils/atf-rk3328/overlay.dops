port sysutils/atf-rk3328
type port
reason "DragonFly: build TF-A with the aarch64-none-elf cross gcc"

# TF-A 2.14 (2026Q4 on) takes CC and CPP from the environment, where the
# ports framework puts the host compiler: DragonFly's gcc 8 for x86_64,
# which rejects the AArch64 flags (-mstrict-align). Point both at the cross
# gcc atf-master already depends on, as atf-rk3399 and atf-sun50i_a64 do.
target @2026Q4,@main

mk add MAKE_ARGS "CC=aarch64-none-elf-gcc CPP=aarch64-none-elf-gcc"

port sysutils/javaservicewrapper
type port
reason "DragonFly: build as dist.os dragonfly with the FreeBSD makefile; per-line patches in dragonfly/@<line>"

# dragonfly/@2026Q4 and @main re-cut build.xml for 3.7.3 and read
# kinfo_proc's kp_ppid in wrapperGetPPid(), which the FREEBSD build flags
# select.
target @any

mk target set dfly-patch <<'MK1'
	${LN} -sv ${WRKSRC}/src/c/Makefile-freebsd-x86-64.gmake \
		  ${WRKSRC}/src/c/Makefile-dragonfly-x86-64.gmake
MK1

port sysutils/bareos24-server
type port
reason "DragonFly: build without ACL and xattr support; link libintl for NLS"

# core/CMakeLists.txt only knows FreeBSD among the BSDs: on DragonFly it
# finds sys/acl.h and sys/extattr.h, turns on HAVE_ACL and HAVE_XATTR, but
# no OS section of findlib/acl.cc or xattr.cc provides the os_*_streams
# functions, so those files do not compile. Turn both off, as the last
# DragonFly bareos build did. The FreeBSD section also adds
# link_libraries(intl), which the NLS build needs for gettext (bconsole:
# undefined libintl_gettext). sysutils/bareos24-client builds from this
# Makefile.
target @2026Q4,@main

mk add CMAKE_ARGS "-Dacl=OFF -DHAVE_SYS_EXTATTR_H:BOOL=OFF"
mk set NLS_LDFLAGS "-lintl"

# FreeBSD's files/ adds fastlz/include to the stored plugins only for
# HAVE_FREEBSD_OS (autoxflate-sd: no fastlz/fastlzlib.h). libbareossd
# uses jansson but is not linked with it.
mk target set dfly-patch <<'MK1'
	${REINPLACE_CMD} -e 's/^if(HAVE_FREEBSD_OS)$$/if(HAVE_FREEBSD_OS OR CMAKE_SYSTEM_NAME STREQUAL "DragonFly")/' \
		${WRKSRC}/core/src/plugins/stored/CMakeLists.txt
	${REINPLACE_CMD} -e 's/bareossd PRIVATE bareos $${THREADS_THREADS} fmt::fmt-header-only/& $${JANSSON_LIBRARIES}/' \
		${WRKSRC}/core/src/stored/CMakeLists.txt
MK1

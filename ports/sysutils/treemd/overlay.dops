port sysutils/treemd
type port
reason "DragonFly: rustix source-membership sockopts (dragonfly/@<line> cargo-crate patches); notify kqueue target cfg (cargo:extra)"

# dragonfly/@<line>/patch-cargo-crates_rustix-<ver>_src_*sockopt.rs: libc 0.2.189
# (2026Q4 on) defines IP_ADD_SOURCE_MEMBERSHIP and ip_mreq_source for FreeBSD
# only (DragonFly has neither); limit rustix's source-membership setters to
# freebsd, as rustix 1.1.5 does. The same fix ships centrally as
# extra-rustix-<ver>; --forward makes the duplicates harmless.

mk eval USES "${USES:S/cargo/cargo:extra/}"

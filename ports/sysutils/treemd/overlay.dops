port sysutils/treemd
type port
reason "DragonFly: rustix source-membership sockopts, notify kqueue target cfg (cargo:extra)"

# extra-rustix-<ver>: libc defines IP_ADD_SOURCE_MEMBERSHIP and
# ip_mreq_source for FreeBSD only (DragonFly has neither); cfg rustix's
# source-membership setters out on dragonfly.

mk eval USES "${USES:S/cargo/cargo:extra/}"

port sysutils/deltup
type port
reason "auto-converted from compat (Makefile.DragonFly + dragonfly/)"
target @any

# The src build gets no CXXFLAGS, and there are no OpenSSL headers in base.
text replace-once file Makefile from "cd ${WRKSRC}/src && ${MAKE} deltup" to "cd ${WRKSRC}/src && ${MAKE} CXXFLAGS=\"${CXXFLAGS}\" deltup"

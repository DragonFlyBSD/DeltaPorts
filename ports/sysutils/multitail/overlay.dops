port sysutils/multitail
type port
reason "ncurses from ports (base keeps panel private); take the FreeBSD paths in the sources"
target @any

# devel/ncurses is built --disable-lib-suffixes: libpanel is the wide one.
# FindCurses does not look in include/ncurses, so name the port's files.
text replace-once file Makefile \
     from "USES=\t\tcmake ncurses pkgconfig" \
     to   "USES=\t\tcmake ncurses:port pkgconfig"
mk add CMAKE_ARGS "-DCURSES_INCLUDE_PATH=${NCURSESINC} -DCURSES_NCURSES_LIBRARY=${NCURSESLIB}/libncursesw.so"
mk target set dfly-patch <<'MK'
	${REINPLACE_CMD} -e 's/find_library(PANEL_LIBRARY panelw REQUIRED)/find_library(PANEL_LIBRARY panel REQUIRED)/' \
		${WRKSRC}/CMakeLists.txt
	${REINPLACE_CMD} -e 's/defined(__FreeBSD__)/(defined(__FreeBSD__) || defined(__DragonFly__))/g' \
		${WRKSRC}/*.c ${WRKSRC}/*.h
MK

port sysutils/gotop
type port
reason "auto-converted from compat (Makefile.DragonFly + dragonfly/)"

# dragonfly/@<line>/patch-*: gotop's process list uses ps --libxo on FreeBSD,
# which DragonFly's ps lacks; use the fixed-width "ps -caxo" variant of
# darwin/openbsd (DragonFly ps also widens columns to the header). Add
# DragonFly to the Dup2 logging file and the vendored jibber_jabber unix tag.

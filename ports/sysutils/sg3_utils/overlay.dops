port sysutils/sg3_utils
type lock
reason "auto-converted from compat (fragment + diffs/)"
target @any

mk target set dfly-patch <<'MK1'
	${REINPLACE_CMD} -e 's@<cam/@<bus/cam/@g' \
		${WRKSRC}/lib/sg_pt_freebsd.c
MK1
file remove files/patch-lib_sg__pt__freebsd.c on-missing noop
file remove files/patch-include_freebsd__nvme__ioctl.h on-missing noop

# The locked 1.42 plist lists its man pages under man/man8, where
# bsd.port.mk used to point --mandir; it now defaults to share/man. Install
# them there, and have compress-man look there too: it only walks MANDIRS
# (share/man), so the plist's .8.gz files were missing.
target @2026Q4,@main

mk set GNU_CONFIGURE_MANPREFIX "${PREFIX}"
mk add MANDIRS "${PREFIX}/man"

port sysutils/gnome-control-center
type port
reason "gnome-control-center 47.7 -> 50.3 (GNOME 50); migrated compat -> dops; sound/gvc restored via libpulse; needs system goa 3.54 + blueprint-compiler"
target @any

file materialize dragonfly/patch-panels_meson.build -> dragonfly/patch-panels_meson.build
file materialize dragonfly/patch-panels_color_cc-color-calibrate.c -> dragonfly/patch-panels_color_cc-color-calibrate.c
mk unset PORTREVISION
mk add BUILD_DEPENDS "blueprint-compiler>=0.19:devel/blueprint-compiler"
mk add USES "gssapi:mit"
mk unset OPTIONS_SUB
mk unset OPTIONS_DEFINE
mk unset OPTIONS_DEFAULT
mk unset WAYLAND_MESON_TRUE
mk set PORTSCOUT "limit:^50\\."
mk set PORTVERSION "50.3"

file materialize distinfo -> distinfo
patch apply diffs/pkg-plist.diff
file remove files/patch-panels_color_cc-color-calibrate.c on-missing noop
file remove files/patch-panels_meson.build on-missing noop
file remove files/patch-panels_system_about_cc-about-page.ui on-missing noop
file remove files/patch-panels_system_about_cc-system-details-window.c on-missing noop
file materialize dragonfly/patch-panels_system_about_cc-system-details-window.c -> dragonfly/patch-panels_system_about_cc-system-details-window.c

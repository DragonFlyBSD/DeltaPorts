port x11-servers/xorg-server
type port
reason "DragonFly xorg-server: Makefile changes, remove stale patch file, materialize DragonFly patches"
target @any

# libunwind is listed for amd64; DragonFly calls that arch x86_64.
text replace-once file Makefile from "${ARCH} == amd64 ||" to "${ARCH} == x86_64 ||"

# Pin SHA1 so the package dependencies match the linked library: automatic
# detection can select a library present on the build host but absent from
# the package, and a minimal ISO then misses a library Xorg needs
# (DragonFly issue #3395).
mk add MESON_ARGS "-Dsha1=libnettle"
mk add LIB_DEPENDS "libnettle.so:security/nettle"
mk bump PORTREVISION

file remove files/patch-hw_xfree86_xorg-wrapper.c on-missing noop

# FreeBSD 67dae6618236 run-depends on libdril_dri.so, which locked mesa-dri
# 21.3.9 does not build. swrast_dri.so is in its package on every arch.
target @2026Q4

text replace-once file Makefile from "${LOCALBASE}/lib/dri/libdril_dri.so:graphics/mesa-dri" to "${LOCALBASE}/lib/dri/swrast_dri.so:graphics/mesa-dri"

target @main

text replace-once file Makefile from "${LOCALBASE}/lib/dri/libdril_dri.so:graphics/mesa-dri" to "${LOCALBASE}/lib/dri/swrast_dri.so:graphics/mesa-dri"

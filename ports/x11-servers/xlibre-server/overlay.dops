port x11-servers/xlibre-server
type port
reason "DragonFly: provide feature_present() fallback for config/udev.c (FreeBSD libc only)"

# Locked mesa-dri 21.3.9 builds no libdril_dri.so; swrast_dri.so is in its
# package on every arch.
target @2026Q4
text replace-once file Makefile.common from "${LOCALBASE}/lib/dri/libdril_dri.so:graphics/mesa-dri" to "${LOCALBASE}/lib/dri/swrast_dri.so:graphics/mesa-dri"

target @main
text replace-once file Makefile.common from "${LOCALBASE}/lib/dri/libdril_dri.so:graphics/mesa-dri" to "${LOCALBASE}/lib/dri/swrast_dri.so:graphics/mesa-dri"

port x11-servers/xwayland
type port
reason "Select the DRI header provider with GL_DEFAULT so it matches the selected Mesa libraries."

mk remove BUILD_DEPENDS "${LOCALBASE}/include/GL/internal/dri_interface.h:graphics/mesa-dri"
mk add BUILD_DEPENDS "${LOCALBASE}/include/GL/internal/dri_interface.h:graphics/${GL_DEFAULT:S/^mesa-libs$/mesa-dri/}"

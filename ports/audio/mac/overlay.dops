port audio/mac
type port
reason "map DragonFly to PLATFORM_LINUX in All.h, as FreeBSD's patches do"
target @2026Q4,@main

# The installed MAC/All.h otherwise picks Windows.h for consumers (audio/aqualung); bump to reinstall it.
text replace-once file files/patch-Shared_All.h from "defined(__linux__) || defined(__FreeBSD__)" to "defined(__linux__) || defined(__FreeBSD__) || defined(__DragonFly__)"
text replace-once file files/patch-Source_Shared_All.h from "defined(__linux__) || defined(__FreeBSD__)" to "defined(__linux__) || defined(__FreeBSD__) || defined(__DragonFly__)"
mk bump PORTREVISION

port audio/pulseaudio
type port
reason "client libraries only: pipewire-pulse serves the pulse API (dp-4az)"
target @any

# libpulse, libpulse-simple and libpulse-mainloop-glib (what dependents link)
# and the pactl/pacat client tools; no daemon, modules or daemon configs.
mk add MESON_ARGS "-Ddaemon=false"
mk add LDFLAGS "-L${LOCALBASE}/lib -lintl"
text replace-once file Makefile from ".for ii in default.pa daemon.conf client.conf system.pa" to ".for ii in client.conf"

# pkg-plist: drop what -Ddaemon=false does not install.
text line-remove file pkg-plist exact "bin/pacmd"
text line-remove file pkg-plist exact "bin/pasuspender"
text line-remove file pkg-plist exact "bin/pulseaudio"
text line-remove file pkg-plist exact "bin/qpaeq"
text line-remove file pkg-plist exact "%%X11%%bin/start-pulseaudio-x11"

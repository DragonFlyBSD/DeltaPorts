port audio/vst3sdk
type port
reason "build with GCC_DEFAULT for std::filesystem and with Ninja; DragonFly sources, sqlite3; CLOCK_UPTIME for CLOCK_BOOTTIME (dragonfly/)"
target @any

# compiler:c++14-lang can leave base gcc 8, which has no std::filesystem.
mk set USE_GCC_VERSION "${GCC_DEFAULT}"

mk target set dfly-patch <<'MK'
	${REINPLACE_CMD} -e 's@__FreeBSD__@__DragonFly__@g' \
		${WRKSRC}/pluginterfaces/base/fplatform.h \
		${WRKSRC}/vstgui4/vstgui/lib/vstguibase.h
	${REINPLACE_CMD} -e 's@//#include <ext@#include <ext@g' \
		${WRKSRC}/pluginterfaces/base/funknown.cpp
MK

# vstgui's CMake requires pkg-config sqlite3.
mk add LIB_DEPENDS "libsqlite3.so:databases/sqlite3"

# Resource paths with spaces break the Makefile generator's depend step.
mk add USES "ninja"

port ftp/curl-impersonate
type port
reason "DragonFly: build without the bundled libidn2, as on the other BSDs; gcc 8 ICEs on boringssl"

# CMakeLists.txt defaults USE_LIBIDN2 off for CMAKE_SYSTEM_NAME matching
# "BSD$", which "DragonFly" does not. With it on, configure stops: the
# port never runs the `make prepare-libidn2` prebuild it requires.
target @any

mk add CMAKE_OFF "USE_LIBIDN2"

# Base gcc 8.3 hits an internal compiler error (expand_debug_locations)
# on boringssl's AVX2 keccak_f_x4 in crypto/fipsmodule/bcm.cc. The bundled
# dependencies are built with the port's compiler, so switch the port.
mk set USE_GCC_VERSION "${GCC_DEFAULT}"

# The curl sub-build's CONFIGURE_COMMAND hard-codes -GNinja, and
# DragonFly's USES=cmake does not pull in ninja (it builds with make).
mk add BUILD_DEPENDS "ninja:devel/ninja"

# dragonfly/patch-CMakeLists.txt: curl's lib/CMakeLists.txt defaults
# CURL_LIBCURL_SOVERSION on only for a list of systems that names FreeBSD
# but not DragonFly, so libcurl-impersonate.so came out unversioned and
# the plist's .so.4/.so.4.8.0 were missing. Turn it on for the sub-build.

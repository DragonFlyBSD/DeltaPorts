port net/kamailio
type port
reason "auto-converted from compat (Makefile.DragonFly + dragonfly/)"
target @any

mk eval OPTIONS_DEFAULT "${OPTIONS_DEFAULT:NSCTP}"
mk add MAKE_ARGS "SCTP=0 LOCALBASE=${LOCALBASE}"
mk target set dfly-patch <<'MK1'
	${REINPLACE_CMD} -e 's@clang@gcc@g' \
			 -e 's@"-ldl"@-ldl -lm@g' \
		${WRKSRC}/src/Makefile.defs
	${REINPLACE_CMD} -e "s@LIBS = @& -L${LOCALBASE}/lib @g" \
		${WRKSRC}/src/modules/db_mysql/Makefile
	# Upstream's dragonfly.cmake is a copy of linux.cmake (epoll, SIGIO_RT).
	${CP} ${WRKSRC}/cmake/os-specific/freebsd.cmake \
		${WRKSRC}/cmake/os-specific/dragonfly.cmake
MK1
# No SCTP here; the CMake build turns USE_SCTP on by default.
mk add CMAKE_ARGS "-DUSE_SCTP=OFF"

port net/nethogs
type port
reason "auto-converted from Makefile.DragonFly"
target @any

mk set MAKE_JOBS_UNSAFE "yes"
mk add USES "ncurses"
mk target set dfly-patch <<'MK1'
	${REINPLACE_CMD} -e 's@FreeBSD@DragonFly@g' \
		${WRKSRC}/doc/Makefile \
		${WRKSRC}/src/MakeLib.mk
MK1

# dragonfly/@<line>/patch-src_{nethogs.h,packet.cpp,connection.cpp}:
# DragonFly no longer has <malloc.h>; take the <stdlib.h> branch the
# sources already have for FreeBSD.

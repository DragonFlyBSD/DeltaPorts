port net/kube-controller-manager
type port
reason "vendored moby/term: DragonFly as a BSD"
target @any

# vendor/github.com/moby/term lists darwin, freebsd, netbsd and openbsd as
# the BSDs (TIOCGETA); DragonFly took the Linux TCGETS file.
mk target set dfly-patch <<'MK'
	${REINPLACE_CMD} -e 's|^\(//go:build .*freebsd.*\)$$|\1 \|\| dragonfly|' \
		${GO_WRKSRC}/vendor/github.com/moby/term/termios_bsd.go
	${REINPLACE_CMD} -e 's|^\(//go:build .*!freebsd.*\)$$|\1 \&\& !dragonfly|' \
		${GO_WRKSRC}/vendor/github.com/moby/term/termios_nonbsd.go
MK

port net/libradius
type dport
reason "DragonFly-only port; source in newport/"
target @any

# The library is built with -Werror and calls OpenSSL's MD5_* and HMAC_*
# functions, which OpenSSL 3 (the ports default) marks deprecated. Ask for
# the 1.1.1 API, under which they are not.
target @2026Q3,@2026Q4,@main

mk add CFLAGS "-DOPENSSL_API_COMPAT=0x10101000L"

# The source Makefile installs man pages under ${PREFIX}/man, which the
# ports mtree no longer creates, so stage failed on .../man/man3. Install
# them under share/man like everything else.
mk add MAKE_ARGS "MANDIR=${PREFIX}/share/man/man"
text replace-once file Makefile from "man/man3/libradius.3.gz" to "share/man/man3/libradius.3.gz"
text replace-once file Makefile from "man/man5/radius.conf.5.gz" to "share/man/man5/radius.conf.5.gz"

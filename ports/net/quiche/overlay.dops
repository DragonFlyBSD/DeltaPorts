port net/quiche
type port
reason "auto-converted from Makefile.DragonFly"
target @any

mk add USES "gmake"

# boring-sys runs bindgen, and clang-sys 1.8.1 only searches its built-in
# libclang directories (/usr/local/llvm*/lib*) on Linux and FreeBSD; on
# DragonFly it finds nothing. Point it at the llvm from USES=llvm.
target @2026Q4,@main

mk add MAKE_ENV "LIBCLANG_PATH=${LLVM_PREFIX}/lib"

# The Makefile links BoringSSL's C++ parts against libc++
# (BORING_BSSL_RUST_CPPLIB=c++), FreeBSD's C++ runtime. DragonFly builds them
# with g++ and libstdc++.
mk remove MAKE_ENV "BORING_BSSL_RUST_CPPLIB=c++"
mk add MAKE_ENV "BORING_BSSL_RUST_CPPLIB=stdc++"

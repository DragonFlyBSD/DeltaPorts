port net/gnome-connections
type port
target @any
reason "Update Connections to GNOME 50 with DragonFly VNC audio disabled"

file materialize dragonfly/Makefile -> Makefile
file materialize dragonfly/distinfo -> distinfo
file materialize dragonfly/pkg-plist -> pkg-plist
file materialize dragonfly/files/patch-meson.build -> files/patch-meson.build
file materialize dragonfly/files/patch-src_vnc-connection.vala -> files/patch-src_vnc-connection.vala
file materialize dragonfly/files/patch-src_ui_vnc-preferences.ui -> files/patch-src_ui_vnc-preferences.ui

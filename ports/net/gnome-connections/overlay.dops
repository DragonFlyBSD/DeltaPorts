port net/gnome-connections
type port
reason "Update Connections to GNOME 50 with DragonFly VNC audio disabled"
target @any

mk unset PORTVERSION
mk set DISTVERSION "50.0"
patch apply diffs/pkg-plist.diff
file materialize dragonfly/patch-meson.build -> dragonfly/patch-meson.build
file materialize dragonfly/patch-src_vnc-connection.vala -> dragonfly/patch-src_vnc-connection.vala
file materialize dragonfly/patch-src_ui_vnc-preferences.ui -> dragonfly/patch-src_ui_vnc-preferences.ui

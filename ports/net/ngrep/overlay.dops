port net/ngrep
type port
reason "auto-converted from compat (Makefile.DragonFly + dragonfly/)"
target @any

mk add OPTIONS_EXCLUDE "CAPSICUM"
mk add CONFIGURE_ARGS "--disable-pcap-restart"

# 1.48 regenerates configure (USES=autoreconf), so the DragonFly case
# (OS=BSD) goes into configure.ac (dragonfly/@<line>/patch-configure.ac).

port net/ngrep
type port
reason "auto-converted from compat (Makefile.DragonFly + dragonfly/)"
target @any

mk add OPTIONS_EXCLUDE "CAPSICUM"
mk add CONFIGURE_ARGS "--disable-pcap-restart"

# dragonfly/@2026Q1, @2026Q2: patch-configure (DragonFly as OS=BSD). 1.48
# (2026Q3 on) regenerates configure (USES=autoreconf), so the same case goes
# into configure.ac (dragonfly/@<line>/patch-configure.ac).

port net/dtcpclient
type port
reason "libmd and md5.h from ports for files/patch-Makefile's DragonFly MD5 branch"

# FreeBSD's files/patch-Makefile installs the man page under share/man and
# gives DragonFly its HAVE_MD5/-lmd branch; DragonFly's libmd and md5.h
# come from security/libmd in ${LOCALBASE}.
target @any

mk add USES "localbase:ldflags"
mk add LIB_DEPENDS "libmd.so:security/libmd"

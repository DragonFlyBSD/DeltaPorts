port net/trantor
type port
reason "DragonFly: take the FreeBSD thread-id branch in Logger.cc"
target @any

# dragonfly/@2026Q4, @main: Logger.cc gets the thread id with
# pthread_getthreadid_np() on FreeBSD and falls back to macOS's
# pthread_threadid_np() on anything unlisted. DragonFly has the former in
# <pthread_np.h>.

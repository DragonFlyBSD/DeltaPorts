port net/yggdrasil
type port
reason "vendored wireguard tun: a DragonFly backend (dragonfly/); tun_other.go's MTU type"
target @any

# tun_other.go (no address setup) is what DragonFly builds; it passes the
# uint64 MTU to CreateTUN's int.
mk target set dfly-patch <<'MK'
	${REINPLACE_CMD} -e 's|^\(//go:build .*\)$$|\1 \|\| dragonfly|' \
		${WRKSRC}/vendor/golang.zx2c4.com/wireguard/tun/operateonfd.go
	${REINPLACE_CMD} -e 's|wgtun.CreateTUN(ifname, mtu)|wgtun.CreateTUN(ifname, int(mtu))|' \
		${WRKSRC}/src/tun/tun_other.go
MK

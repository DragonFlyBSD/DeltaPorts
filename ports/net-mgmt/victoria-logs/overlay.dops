port net-mgmt/victoria-logs
type port
reason "vendored VictoriaMetrics lib/filestream and lib/fs: without fadvise, as on OpenBSD"
target @any

# filestream_bsd.go and lib/fs/fadvise_unix.go use unix.Fadvise, which
# x/sys/unix lacks on DragonFly; the OpenBSD files do without. lib/fs's
# Unix files list the other BSDs.
mk target set dfly-patch <<'MK'
	cd ${GO_WRKSRC}/vendor/github.com/VictoriaMetrics/VictoriaMetrics/lib && \
		${CP} filestream/filestream_openbsd.go filestream/filestream_dragonfly.go && \
		${CP} fs/fadvise_openbsd.go fs/fadvise_dragonfly.go && \
		${REINPLACE_CMD} -e 's@^\(//go:build .*freebsd.*\)$$@\1 || dragonfly@' \
			fs/fs_nix.go fs/fs_unix.go
MK

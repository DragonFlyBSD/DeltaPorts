port net-mgmt/realmd
type port
reason "HOST_NAME_MAX from MAXHOSTNAMELEN, as FreeBSD's patches do"
target @any

mk target set dfly-patch <<'MK'
	${REINPLACE_CMD} -e 's/^#if defined(__FreeBSD__)$$/& || defined(__DragonFly__)/' \
		${WRKSRC}/service/realm-provider.c \
		${WRKSRC}/service/realm-samba-enroll.c
MK

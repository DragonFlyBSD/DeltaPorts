port x11-wm/wayfire
type port
reason "DragonFly: build with GCC_DEFAULT"

# 0.11.0: gcc 8 rejects plugins/protocols/session-lock.cpp (an
# empty pack forwarded through a pack of base-class initializers, a lambda
# of local type passed to a template). Build with the default ports GCC,
# whose libstdc++ has std::filesystem.
target @2026Q4,@main

mk set USE_GCC_VERSION "${GCC_DEFAULT}"

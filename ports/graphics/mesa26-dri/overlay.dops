file materialize newport/files/patch-src_util_u__memory.h -> files/patch-src_util_u__memory.h
file materialize newport/files/patch-src_vulkan_vram-report-limit-layer_vram__report__limit__layer.c -> files/patch-src_vulkan_vram-report-limit-layer_vram__report__limit__layer.c
file materialize newport/files/patch-src_vulkan_wsi_wsi__common__wayland.c -> files/patch-src_vulkan_wsi_wsi__common__wayland.c
file materialize newport/files/patch-userptr -> files/patch-userptr

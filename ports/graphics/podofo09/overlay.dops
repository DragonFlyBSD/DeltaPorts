port graphics/podofo09
type port
reason "DragonFly: libcrypto is not in base, so the OpenSSL 1.1 API check fails"

# cmake/modules/FindLIBCRYPTO.cmake gets libcrypto from pkg-config as the bare
# name "crypto" and test-links the PODOFO_HAVE_OPENSSL_1_1 check with it.
# FreeBSD finds that in /usr/lib; DragonFly's linker does not search
# LOCALBASE, so the check fails and PdfEncrypt.cpp uses the pre-1.1 API
# (EVP_CIPHER_CTX by value). Record the result, and give the real link
# -L${LOCALBASE}/lib.
target @2026Q4,@main

mk add CMAKE_ARGS "-DPODOFO_HAVE_OPENSSL_1_1:BOOL=TRUE"
mk add USES "localbase:ldflags"

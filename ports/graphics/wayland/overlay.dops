port graphics/wayland
type port
target @any
reason "DragonFly runtime patches for wayland (kqueue event-loop, pipe2 terminate fd, os-wrappers, test harness). base @2026Q2 is already 1.24.0 with 0.24.0 plist, so no version bump/distinfo/pkg-plist changes are needed -- only the DragonFly source patches, applied from files/."

file materialize dragonfly/patch-meson.build -> files/patch-meson.build
file materialize dragonfly/patch-src_connection.c -> files/patch-src_connection.c
file materialize dragonfly/patch-src_event-loop.c -> files/patch-src_event-loop.c
file materialize dragonfly/patch-src_wayland-os.c -> files/patch-src_wayland-os.c
file materialize dragonfly/patch-src_wayland-os.h -> files/patch-src_wayland-os.h
file materialize dragonfly/patch-src_wayland-server.c -> files/patch-src_wayland-server.c
file materialize dragonfly/patch-tests_os-wrappers-test.c -> files/patch-tests_os-wrappers-test.c
file materialize dragonfly/patch-tests_test-runner.c -> files/patch-tests_test-runner.c
file materialize dragonfly/patch-tests_test-helpers.c -> files/patch-tests_test-helpers.c

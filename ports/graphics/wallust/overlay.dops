port graphics/wallust
type port
reason "DragonFly: take main's distinfo for the regenerated codeberg archive"

# codeberg regenerated the archive and every mirror serves the new one;
# freebsd-ports main re-rolled distinfo for it.
target @2026Q3,@2026Q4
text replace-once file distinfo from "TIMESTAMP = 1768915047" to "TIMESTAMP = 1791704324"
text replace-once file distinfo from "SHA256 (wallust-3.5.2.tar.gz) = 46c2592217f0de968437850b14b2e844f2af4158b70135b2b448dc426c0309a1" to "SHA256 (wallust-3.5.2.tar.gz) = 8609d27162975777797f2f625d884a6475c766ed943393219d585577ac8bfcfe"
text replace-once file distinfo from "SIZE (wallust-3.5.2.tar.gz) = 166200" to "SIZE (wallust-3.5.2.tar.gz) = 166156"

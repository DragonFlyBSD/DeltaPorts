port graphics/vulkan-tools
type port
reason "DragonFly: let cube/ and vulkaninfo/ CMake treat DragonFly like the BSDs"

target @any

# cube/ and vulkaninfo/CMakeLists.txt match CMAKE_SYSTEM_NAME against
# "Linux|BSD|GNU", which "DragonFly" does not match, so no WSI platform and
# no vkcube targets are set up. Edit the regex instead of patching: the
# lines move between releases and the old cube patch no longer applied.
mk target set dfly-patch <<'MK'
	${REINPLACE_CMD} -e 's/"Linux|BSD|GNU"/"Linux|BSD|GNU|DragonFly"/' \
		${WRKSRC}/cube/CMakeLists.txt \
		${WRKSRC}/vulkaninfo/CMakeLists.txt
MK

# 1.4.35x: vkcube's main() and vkcubepp's platform switch are guarded by an
# OS list (__linux__, __FreeBSD__, __OpenBSD__, ...) without __DragonFly__,
# so vkcube linked without main() and cube.cpp hit "Platform not supported".
target @2026Q4,@main

mk target set post-patch <<'MK'
	${REINPLACE_CMD} -e 's/defined(__FreeBSD__) || defined(__OpenBSD__)/defined(__FreeBSD__) || defined(__DragonFly__) || defined(__OpenBSD__)/' \
		${WRKSRC}/cube/cube.c \
		${WRKSRC}/cube/cube.cpp
MK

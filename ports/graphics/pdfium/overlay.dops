port graphics/pdfium
type port
reason "DragonFly: no compiler-rt builtins to link; libc++ lives in the llvm prefix; pkg-config wrapper ignores dragonfly"

# dragonfly/patch-build_config_compiler_BUILD.gn: chromium's build links
# clang's clang_rt.builtins; FreeBSD's port asks clang where it lives. Our
# llvm ports are built without compiler-rt, so clang answers with a bare
# file name and ninja finds no rule for
# .../lib/clang/19/lib/libclang_rt.builtins.a/libclang_rt.builtins.a.
# Drop the config on the "freebsd" target OS this build runs as; libgcc
# provides the intrinsics.
#
# The same patch points C++ compiles at libc++'s headers: the build passes
# --target=x86_64-unknown-freebsd, and clang's FreeBSD driver only looks in
# /usr/include/c++/v1, while devel/libcxx${LLVM_DEFAULT} installs them under
# ${LOCALBASE}/llvm${LLVM_DEFAULT}. libpdfium.so is linked with -lc++, so
# declare the library too.
#
# dragonfly/patch-build_config_linux_pkg-config.py: chromium's pkg-config
# wrapper returns empty flags unless sys.platform names linux (FreeBSD's
# patch adds freebsd). On DragonFly it answered nothing, so the system
# openjpeg's include dir never reached the compile: 'openjpeg.h' not found.
target @any

mk add LIB_DEPENDS "libc++.so.1:devel/libcxx${LLVM_DEFAULT}"

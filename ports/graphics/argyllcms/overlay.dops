port graphics/argyllcms
type port
reason "auto-converted from compat (Makefile.DragonFly + dragonfly/)"

# 3.5: take the FreeBSD serial/USB code paths (DragonFly's u4b USB stack is
# FreeBSD's), with the usb_ioctl.h include from bus/u4b
# (dragonfly/@<line>/patch-spectro_usbio__bsd.c).
target @2026Q4,@main

mk target set dfly-patch <<'MK'
	${REINPLACE_CMD} -e 's/defined(__FreeBSD__)/(defined(__FreeBSD__) || defined(__DragonFly__))/g' \
		${WRKSRC}/spectro/hidio.c ${WRKSRC}/spectro/icoms.h \
		${WRKSRC}/spectro/icoms_ux.c ${WRKSRC}/spectro/usbio.c \
		${WRKSRC}/spectro/usbio.h ${WRKSRC}/spectro/usbio_bsd.c
MK

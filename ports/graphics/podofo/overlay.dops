port graphics/podofo
type port
reason "DragonFly: 0.10 needs a newer GCC than base gcc 8"

# The bundled chromium numerics (3rdparty/numerics, used by the pdfium
# shims) call __builtin_is_constant_evaluated(), which gcc 9 added, and the
# library uses std::filesystem, which base gcc 8 keeps out of libstdc++.
# Use the ports GCC. Inserted at top level: `mk add` would land it inside
# the MAINTAINER_MODE .else (it inserts before the first target).
target @2026Q4,@main

text line-insert-after file Makefile \
     anchor "TIFF_LIB_DEPENDS=\tlibtiff.so:graphics/tiff" \
     line   "\nUSE_GCC_VERSION=\t${GCC_DEFAULT}"

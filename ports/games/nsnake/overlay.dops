port games/nsnake
type port
reason "append to the Makefile's CFLAGS/LDFLAGS: curses comes from ports ncurses"

# The Makefile assigns CFLAGS and LDFLAGS itself, so the -I/-L for ports
# ncurses (DragonFly has no curses in base) never reach the build.
target @any

mk target set dfly-patch <<'MK1'
	${REINPLACE_CMD} -e 's@^CFLAGS=@CFLAGS+=@' -e 's@^LDFLAGS=@LDFLAGS+=@' \
		${WRKSRC}/Makefile
MK1

port games/libretro-snes9x
type port
reason "DragonFly: minizip's ioapi.h maps fopen64 & co. only for FreeBSD/OpenBSD/NetBSD/Haiku"

# unzip/ioapi.h defines fopen64, ftello64 and fseeko64 to the plain calls on
# the other BSDs; DragonFly has no *64 variants, so the core fails to link
# with undefined fopen64/ftello64/fseeko64.
target @2026Q3,@2026Q4,@main

mk target set dfly-patch <<'MK'
	${REINPLACE_CMD} -e 's/^#if defined(__FreeBSD__) || defined(__OpenBSD__)/#if defined(__FreeBSD__) || defined(__DragonFly__) || defined(__OpenBSD__)/' \
		${WRKSRC}/unzip/ioapi.h
MK

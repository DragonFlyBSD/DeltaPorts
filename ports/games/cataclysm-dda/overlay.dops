port games/cataclysm-dda
type port
reason "BSD=1 make arg, disable -Werror, fix ncursesw config call, materialize dragonfly patches"
target @any

mk block set condition "!defined(_INCLUDE_GAMES_CATACLYSM__DDA_MK)" <<'MK'
_INCLUDE_GAMES_CATACLYSM__DDA_MK=     yes

CXXFLAGS+= -Wno-deprecated-declarations

MAKE_ARGS+=		BSD=1
NLS_MAKE_ARGS_ON=	LOCALIZE=1

dfly-patch:
	${REINPLACE_CMD} -e "s@ncursesw5-config@ncursesw6-config@g" \
			 -e 's/-Werror[[:>:]]//g' \
		${WRKSRC}/Makefile
MK
# -Wfor-loop-analysis is clang-only; gcc then fails the compiler check.
text line-remove file Makefile exact "CXXFLAGS+=\t-Wno-error=for-loop-analysis"
# Macros from devel/ncurses' curses.h trip -Werror=old-style-cast unless
# the headers count as system ones, as base ncurses does on FreeBSD.
mk add CXXFLAGS "-isystem ${LOCALBASE}/include/ncurses"

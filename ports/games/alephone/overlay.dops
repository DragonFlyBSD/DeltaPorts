port games/alephone
type port
reason "auto-converted from Makefile.DragonFly"

# configure installs the MIME files only for *linux*|*bsd* hosts; add
# DragonFly to the case in the shipped configure. Editing configure.ac would
# make the generated Makefile rerun aclocal-1.16, which the port does not
# depend on.
target @2026Q4,@main

mk target set dfly-patch <<'MK1'
	${REINPLACE_CMD} -e 's,^  \*linux\*|\*bsd\*) :$$,  *linux*|*bsd*|*dragonfly*) :,' \
		${WRKSRC}/configure
MK1

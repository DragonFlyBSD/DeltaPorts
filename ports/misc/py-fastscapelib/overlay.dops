port misc/py-fastscapelib
type port
reason "DragonFly: xtensor 0.27 headers need C++20 concepts"

# xtensor 0.27's headers use concepts (cxx_std_20 in its CMake target), which
# base gcc 8.3 cannot compile. The Makefile uses no compiler: USES.
target @2026Q3,@2026Q4,@main

mk set USE_GCC_VERSION "${GCC_DEFAULT}"

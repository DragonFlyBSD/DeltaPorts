port misc/gnome-user-docs
type port
reason "Update GNOME User Docs to the GNOME 50 release"
target @any

mk set PORTVERSION "50.2"
mk set PORTSCOUT "limit:^50\\."
text replace-once file distinfo from "TIMESTAMP = 1745169560" to "TIMESTAMP = 1779580509"
text replace-once file distinfo from "SHA256 (gnome/gnome-user-docs-47.6.tar.xz) = 3b27364d5bd2eb924caca29b4e8e6fc5188f8e8bf1c9365b6f92785198030f62" to "SHA256 (gnome/gnome-user-docs-50.2.tar.xz) = 834863d916189ae13f72562be81d3817232e136d0d37ec376811111ffa159542"

port misc/py-onnxruntime
type port
reason "DragonFly: build with GCC_DEFAULT; thread-id, affinity and bundled abseil fixes"
target @2026Q4,@main

# CMakeLists.txt refuses gcc < 11.1.
mk set USE_GCC_VERSION "${GCC_DEFAULT}"

# dragonfly/@<line>/:
#  - posix/env.cc, logging.cc: no SYS_gettid; skip the affinity block as
#    FreeBSD does, and use lwp_gettid() for the log thread id.
#  - setup.py: package the FreeBSD library list on DragonFly too.
#  - abseil-cpp.cmake + absl_dragonfly.patch: the bundled abseil
#    20250814 casts pthread_self() to pid_t and lacks DragonFly in its
#    mmap/auxv/strptime checks (what devel/abseil patches).

# FreeBSD's files/patch-onnxruntime_core_common_spin__pause.cc comments out
# tpause_spin_delay_cycles: on FreeBSD CMAKE_SYSTEM_PROCESSOR is amd64, so
# spin_pause.cc is built without -mwaitpkg and the constant is unused. On
# DragonFly it is x86_64, -mwaitpkg defines __WAITPKG__ and _tpause() needs it.
file remove files/patch-onnxruntime_core_common_spin__pause.cc on-missing noop

# onnxruntime_set_compile_flags() turns on COMPILE_WARNING_AS_ERROR for every
# onnxruntime target, which upstream only exercises with clang and its own gcc
# CI. gcc 12 stops in model_package_variant_selector.cc on a
# -Wstringop-overread false positive inside std::vector's initializer_list
# assignment. build.py's --compile_no_warning_as_error turns the property off.
text line-insert-after file Makefile anchor "\t\t--skip_tests \\" line "\t\t--compile_no_warning_as_error \\"

# The MLAS AVX-VNNI support test constant-folds the probed intrinsic away,
# so it passes even though base as (2.34) cannot assemble the real VNNI
# kernels. Preseed it off: the TU still compiles, with the VNNI paths
# compiled out by upstream's own #if guards, falling back to pure AVX2.
text line-insert-after file Makefile anchor "\t\t--cmake_extra_defines onnxruntime_BUILD_UNIT_TESTS=OFF \\" line "\t\t--cmake_extra_defines MLAS_COMPILER_SUPPORTS_AVXVNNI=OFF \\"

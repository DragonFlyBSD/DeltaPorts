port misc/llama-cpp
type port
reason "DragonFly: no posix_spawn_file_actions_addchdir(_np)"

# vendor/sheredom/subprocess.h uses posix_spawn_file_actions_addchdir_np for
# the child's working directory, or falls back to fork()+exec() on systems
# that have neither spelling (AIX, OpenBSD, old NetBSD). DragonFly has
# neither; add it to the fork list.
target @2026Q4,@main

mk target set dfly-patch <<'MK'
	${REINPLACE_CMD} -e 's/^#if defined(_AIX) || defined(__OpenBSD__) ||/#if defined(_AIX) || defined(__OpenBSD__) || defined(__DragonFly__) ||/' \
		${WRKSRC}/vendor/sheredom/subprocess.h
MK

# dragonfly/@2026Q4: patch-common_common.cpp. b10975's cache and config
# directory lookups #error on systems they do not list; DragonFly takes the
# XDG branch with FreeBSD. main's b11669 rewrote them without the #error.

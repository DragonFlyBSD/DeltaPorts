port misc/sff
type port
reason "DragonFly: take main's distinfo for the regenerated codeberg archive"

# codeberg regenerated the archive and every mirror serves the new one;
# freebsd-ports main re-rolled distinfo for it.
target @2026Q3,@2026Q4
text replace-once file distinfo from "TIMESTAMP = 1772803346" to "TIMESTAMP = 1791702661"
text replace-once file distinfo from "SHA256 (sff-1.3.tar.gz) = 80736c30fe0150cec98afce2dae835cc5e0e3944d2ed1a618490ea78213b71de" to "SHA256 (sff-1.3.tar.gz) = 5c651a32cb16a4c94ed6612f462a1b0311af3cd5631d88c2226860ce4aefefc8"
text replace-once file distinfo from "SIZE (sff-1.3.tar.gz) = 32900" to "SIZE (sff-1.3.tar.gz) = 32788"

port x11/gnome
type port
reason "x11/gnome 47 -> 50 metaport; full and lite share the DragonFly GNOME 50 Wayland batch (gdm+session+shell+gsd+control-center+portal+PipeWire+WirePlumber+Orca+Nautilus+Sushi+console+zenity+fonts+backgrounds); full additionally includes each verified GNOME 50 application, beginning with Baobab, Calculator, Calendar, Characters, Maps, Font Viewer, Clocks, Epiphany, EOG, Weather, Text Editor, System Monitor, User Docs, Shell Extensions, Connections, and Showtime"
target @any

mk unset PORTVERSION
mk set DISTVERSION "50"
patch apply diffs/Makefile.structure.diff

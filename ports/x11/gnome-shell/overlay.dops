port x11/gnome-shell
type port
reason "gnome-shell 50.2 for GNOME 50 on DragonFly (native Wayland via mutter path-beta); migrated compat -> dops on version bump"
target @any

mk unset PORTVERSION
mk remove LIB_DEPENDS "libmutter-15.so:x11-wm/mutter"
mk remove LIB_DEPENDS "libpulse-mainloop-glib.so:audio/pulseaudio"
mk add LIB_DEPENDS "libmutter-18.so:x11-wm/mutter libpulse.so:audio/pulseaudio"
mk remove USES "gstreamer"
mk add MESON_ARGS "-Dextensions_app=false -Dcamera_monitor=false -Dman=false"
mk remove GLIB_SCHEMAS "org.gnome.Extensions.gschema.xml"
mk set DISTVERSION "50.2"
mk target remove post-extract
file materialize distinfo -> distinfo
patch apply diffs/pkg-plist.diff
file remove files/patch-js_misc_loginManager.js on-missing noop
file materialize dragonfly/patch-zz-dfly-js_misc_loginManager.js -> dragonfly/patch-zz-dfly-js_misc_loginManager.js
file materialize dragonfly/patch-zz-dfly-js_gdm_util.js -> dragonfly/patch-zz-dfly-js_gdm_util.js
file materialize dragonfly/patch-zz-dfly-js_ui_screenShield.js -> dragonfly/patch-zz-dfly-js_ui_screenShield.js
file remove files/patch-js_gdm_loginDialog.js on-missing noop
file remove files/patch-js_ui_endSessionDialog.js on-missing noop
file remove files/patch-js_ui_appDisplay.js on-missing noop
file remove files/patch-js_ui_appFavorites.js on-missing noop
file remove files/patch-data_gnome-shell-dbus-interfaces_gresource_xml on-missing noop
file materialize dragonfly/patch-zz-dfly-meson.build -> dragonfly/patch-zz-dfly-meson.build
file materialize dragonfly/patch-zz-dfly-src_meson.build -> dragonfly/patch-zz-dfly-src_meson.build
file materialize dragonfly/patch-zz-dfly-js_ui_panel.js -> dragonfly/patch-zz-dfly-js_ui_panel.js

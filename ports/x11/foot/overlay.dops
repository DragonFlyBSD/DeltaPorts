port x11/foot
type port
reason "localbase ldflags; libstdthreads for <threads.h>; DragonFly's wchar_t is UTF-32 (dragonfly/@<line> patch)"

target @2026Q4,@main

mk add USES "localbase:ldflags"
mk add LIB_DEPENDS "libstdthreads.so:misc/libstdthreads"

# dragonfly/@<line>/patch-server.c: the passed-socket check reads SO_DOMAIN,
# which DragonFly lacks; check the family with getsockname() instead.

port x11/wf-shell
type port
reason "DragonFly takes the FreeBSD PAM paths (dragonfly/); no wayland-logout here"
target @any

# x11/wayland-logout is IGNOREd on DragonFly (it needs the socket peer's
# pid, which LOCAL_PEERCRED does not report here), and this port is
# already built with -Dwayland-logout=false.
mk remove RUN_DEPENDS "wayland-logout:x11/wayland-logout"

port x11/swaylock
type port
reason "DragonFly as FreeBSD in meson.build; swaylock-effects SSE2 fix"
target @any

# A sed, not a patch: x11/swaylock-effects builds from this Makefile and its
# meson.build differs.
mk target set dfly-patch <<'MK'
	${REINPLACE_CMD} -e "s/startswith('freebsd')$$/& or host_machine.system().startswith('dragonfly')/" \
		${WRKSRC}/meson.build
.if ${PKGNAMESUFFIX:U:M-effects}
	${REINPLACE_CMD} -e 's@#ifdef __SSE2__@#if defined(__SSE2__) \&\& __GNUC__ \!= 8@g' \
		${WRKSRC}/fade.c
.endif
MK

port deskutils/gnome-font-viewer
type port
reason "GNOME Font Viewer 50.0 matches the GNOME 50 desktop stack"
target @any

mk unset PORTVERSION on-missing noop
mk set DISTVERSION "50.0"
mk set PORTSCOUT "limit:^50\\."
file materialize distinfo -> distinfo
text replace-once file pkg-plist from "share/metainfo/org.gnome.font-viewer.appdata.xml" to "share/metainfo/org.gnome.font-viewer.metainfo.xml"
text line-insert-after file pkg-plist anchor "share/locale/uk/LC_MESSAGES/gnome-font-viewer.mo" line "share/locale/uz/LC_MESSAGES/gnome-font-viewer.mo"
text line-insert-after file pkg-plist anchor "share/locale/rw/LC_MESSAGES/gnome-font-viewer.mo" line "share/locale/sat/LC_MESSAGES/gnome-font-viewer.mo"
text line-insert-after file pkg-plist anchor "share/locale/ku/LC_MESSAGES/gnome-font-viewer.mo" line "share/locale/kw/LC_MESSAGES/gnome-font-viewer.mo"

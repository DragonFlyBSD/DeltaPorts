port deskutils/xdg-desktop-portal
type port
reason "DragonFly: no O_PATH, memfd seals or Linux syscalls; no FUSE document portal"
target @any

# dragonfly/ patches libglnx and the portal for the missing O_PATH,
# AT_EMPTY_PATH, statx and memfd seals. The FUSE document portal is not
# built (dp-hlu).
mk eval LIB_DEPENDS "${LIB_DEPENDS:Nlibfuse3.so*}"
text line-remove file pkg-plist exact "libexec/xdg-document-portal"
text line-remove file pkg-plist exact "share/dbus-1/services/org.freedesktop.portal.Documents.service"

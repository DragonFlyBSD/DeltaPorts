port science/libcifpp
type port
reason "DragonFly: std::format needs gcc 13; install the cron update script"

# CMakeLists.txt asks for cxx_std_23 and the headers include <format>, which
# libstdc++ has only from gcc 13 (base is gcc 12.5). Build with gcc 13.
#
# dragonfly/@<line>/patch-CMakeLists.txt: the update script's install is
# only known for Linux, GNU and FreeBSD and stops configure elsewhere;
# install it to etc/cron.weekly on DragonFly too, as pkg-plist expects.
target @2026Q4,@main

mk set USE_GCC_VERSION "13"

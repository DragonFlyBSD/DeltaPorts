port science/ncrystal
type port
reason "no _POSIX_C_SOURCE/_XOPEN_SOURCE in NCCFileUtils.cc, as on FreeBSD"
target @any

# _XOPEN_SOURCE 500 narrows the C visibility and hides the C99 wide
# functions libstdc++'s <cwchar> needs; the file skips both on FreeBSD.
mk target set dfly-patch <<'MK'
	${REINPLACE_CMD} -e 's/^#  ifndef __FreeBSD__$$/#  if !defined(__FreeBSD__) \&\& !defined(__DragonFly__)/' \
		${WRKSRC}/ncrystal_core/src/utils/NCCFileUtils.cc
MK

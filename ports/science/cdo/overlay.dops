port science/cdo
type port
reason "auto-converted from Makefile.DragonFly"
target @any

mk add MAKE_ENV "LDVER=ld.bfd"

# 2.6 requires C++20 ("A compiler with support for C++20 language features
# is required"); compiler:c++20-lang resolves to base gcc 8.3.
target @2026Q3,@2026Q4,@main

mk set USE_GCC_VERSION "${GCC_DEFAULT}"

# FreeBSD adds clang's -fexperimental-library for std::jthread; gcc rejects
# the option, so every C++ configure test failed ("supports C++20... no").
# libstdc++ has std::jthread since gcc 10.
mk remove CXXFLAGS "-fexperimental-library"

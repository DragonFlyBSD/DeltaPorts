port comms/gnuradio
type port
reason "auto-converted from compat (Makefile.DragonFly + dragonfly/)"

# FreeBSD's files/ patch thread.cc and the gsm headers themselves:
# dragonfly/@2026Q4 and @main extend those FreeBSD guards to DragonFly.
# The flat high_res_timer.h patch applies everywhere; its pybind file
# carries the patched header's hash, which cmake checks.
target @any

mk add LDFLAGS "-L${LOCALBASE}/lib"
mk set CPP "cpp"
mk set CC "cc"
mk set CXX "c++"

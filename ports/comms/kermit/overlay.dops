target @any
port comms/kermit
type port
reason "DragonFly needs ncurses library path fix and source patches for libc differences"

mk add USES ncurses

mk target set dfly-patch <<'MK'
	${REINPLACE_CMD} -e "s@\(-lncurses\)@-L${LOCALBASE}/lib \1@g"	\
		${WRKSRC}/makefile
MK

# dragonfly/@2026Q4, @main: patch-ckucmd.c re-cut for 11.0 (FILE is opaque on
# DragonFly; read _r through struct __FILE_public). The 10.0 ckupty.c patch
# stays on 2026Q1-Q3: in 11.0 openpty() is only used under __FreeBSD__, so
# the <libutil.h> include is not needed, and its NO_PTY_XOPEN_SOURCE hunk
# changes nothing on DragonFly.

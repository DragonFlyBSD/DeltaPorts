port devel/libzim
type port
reason "auto-converted from compat (Makefile.DragonFly + dragonfly/)"
target @any

mk target set dfly-patch <<'MK1'
	${REINPLACE_CMD} -e 's@freebsd@dragonfly@' \
		${WRKSRC}/meson.build \
		${WRKSRC}/src/meson.build

MK1

# 9.x defaults to werror=true. The unit tests (built by default) compare
# int with unsigned in gtest's EXPECT_EQ; gcc's -Wall includes
# -Wsign-compare for C++ (clang's does not), so the build stopped there.
target @2026Q4,@main

mk add MESON_ARGS "-Dwerror=false"

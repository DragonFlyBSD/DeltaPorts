port devel/meson
type port
reason "Enable Python 3.12 flavor required by meson-python; include DragonFly CPU detection"
target @any

file materialize dragonfly/patch-mesonbuild_environment.py -> dragonfly/patch-mesonbuild_environment.py
# Update the existing top-level version; new variables would enter the conditional pre-test block.
mk set PORTVERSION "1.10.2"
mk unset PORTREVISION
mk set USE_PYTHON "allflavors autoplist concurrent cython_test pep517 pytest"
mk target set post-patch <<'MK'
	@${REINPLACE_CMD} -e 's|lib/pkgconfig|libdata/pkgconfig|g' \
		-e "s|'lib', 'pkgconfig'|'libdata', 'pkgconfig'|g" \
		-e "s|self.libdir, 'pkgconfig'|'libdata', 'pkgconfig'|g" \
		-e "s|yonder_libdir, 'pkgconfig'|yonder_prefix, 'libdata', 'pkgconfig'|g" \
		${WRKSRC}/unittests/internaltests.py \
		${WRKSRC}/unittests/linuxliketests.py
	@${REINPLACE_CMD} -e "s|'gcc'|'gcc${GCC_DEFAULT}'|g" \
		${WRKSRC}/unittests/internaltests.py
MK
patch apply diffs/Makefile.structure.diff

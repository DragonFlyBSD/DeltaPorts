port devel/meson
type port
reason "Enable coexisting Python flavors; only the default flavor owns the global Polkit action; retain DragonFly CPU detection"
target @any

file materialize dragonfly/patch-mesonbuild_environment.py -> dragonfly/patch-mesonbuild_environment.py
mk remove USE_PYTHON "optsuffix"
mk add USE_PYTHON "allflavors concurrent"
mk ensure-include bsd.port.pre.mk
text replace-once file Makefile from ".include <bsd.port.mk>" to ".include <bsd.port.post.mk>"
mk block set condition "${PYTHON_VER} != ${PYTHON_DEFAULT}" <<'MK'
PKGNAMESUFFIX=	${PYTHON_PKGNAMESUFFIX}

# Let the default flavor own the global polkit action.
post-install:
	@${RM} ${STAGEDIR}${PREFIX}/share/polkit-1/actions/com.mesonbuild.install.policy
	@${RMDIR} ${STAGEDIR}${PREFIX}/share/polkit-1/actions ${STAGEDIR}${PREFIX}/share/polkit-1
	@${REINPLACE_CMD} -e '\|share/polkit-1/actions/com.mesonbuild.install.policy|d' \
		${_PYTHONPKGLIST} \
		${STAGEDIR}${PYTHONPREFIX_SITELIBDIR}/meson-${PORTVERSION}.dist-info/RECORD
MK

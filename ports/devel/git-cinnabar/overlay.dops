port devel/git-cinnabar
type port
reason "auto-converted from Makefile.DragonFly"
target @any

mk add BUILD_DEPENDS "xmlto>=0:textproc/xmlto"
mk add BUILD_DEPENDS "asciidoc>=0:textproc/asciidoc"
mk add BUILD_DEPENDS "asciidoctor:textproc/rubygem-asciidoctor"
mk add BUILD_DEPENDS "autoconf>=0:devel/autoconf"
mk add BUILD_DEPENDS "automake>=0:devel/automake"
mk add BUILD_DEPENDS "gettext-tools>=0:devel/gettext-tools"

# curl-sys reports two include dirs (cargo:include=/usr/local/include, then
# /usr/include from the pkg-config Cflags); cargo keeps the last, so the
# bundled git build gets CURL_CFLAGS=-I/usr/include and misses
# <curl/curl.h>. Add ${LOCALBASE}/include to CFLAGS, which build.rs passes
# to git's make. (CFLAGS+= by text op: "mk add" would write "CFLAGS=".)
target @2026Q3,@2026Q4,@main
text line-insert-after file Makefile anchor "USES=\t\tcargo gmake" line "CFLAGS+=\t-I${LOCALBASE}/include"

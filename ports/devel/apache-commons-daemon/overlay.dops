port devel/apache-commons-daemon
type port
reason "auto-converted from Makefile.DragonFly"

# Treat DragonFly like FreeBSD in the OS case of the configure script.
# 1.6.0 ships no configure (USES=autoreconf generates it), so edit the
# m4 source the case comes from.
target @2026Q4,@main

mk target set dfly-patch <<'MK2'
	${REINPLACE_CMD} -e 's@\(freebsd\*\))@\1|dragonfly*)@g' \
		${WRKSRC}/support/apsupport.m4
MK2

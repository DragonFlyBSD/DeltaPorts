port devel/mongo-c-driver
type port
reason "auto-converted from compat (Makefile.DragonFly + dragonfly/)"
target @any

mk add CFLAGS "-DZ_HAVE_UNISTD_H"
file materialize dragonfly/patch-CMakeLists.txt -> dragonfly/patch-CMakeLists.txt
file materialize dragonfly/patch-src_libmongoc_src_mongoc_mongoc-counters-private.h -> dragonfly/patch-src_libmongoc_src_mongoc_mongoc-counters-private.h
text line-remove file pkg-plist exact "%%PORTDOCS%%%%DOCSDIR%%/mongo-c-driver/html/api.html"
text line-remove file pkg-plist exact "%%PORTDOCS%%@dir %%DOCSDIR%%/mongo-c-driver/html/index"

port devel/rubygem-gitlab_query_language
type port
reason "DragonFly: set LIBCLANG_PATH for rb-sys's bindgen"

# rb-sys runs bindgen, and clang-sys only searches its built-in libclang
# directories (/usr/local/llvm*/lib*) on Linux and FreeBSD; on DragonFly
# it finds nothing. Point it at the llvm that USES=llvm:build installs.
target @2026Q4,@main

mk add GEM_ENV "LIBCLANG_PATH=${LLVM_PREFIX}/lib"

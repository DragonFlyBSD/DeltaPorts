port devel/qt6-tools
type port
reason "DragonFly: build without libclang, which is built against libc++"
target @any

# Qt6 builds with gcc and libstdc++ (Uses/qt.mk), but devel/llvm* is built
# against libc++, and libclang's C++ API passes std:: types, so qdoc and
# lupdate's clang-based C++ parser cannot link it. Build without libclang:
# no qdoc, and lupdate keeps its own C++ parser.
text replace-once file Makefile from "gl llvm:min=17,lib,noexport" to "gl"
text replace-once file Makefile from "-DClang_DIR:PATH=\"${LLVM_PREFIX}/lib/cmake/clang\" \\" to "-DFEATURE_clang=OFF -DFEATURE_qdoc=OFF \\"
text replace-once file Makefile from "-DLLVM_DIR:PATH=\"${LLVM_PREFIX}/lib/cmake/llvm\"" to "-DFEATURE_clangcpp=OFF"
text line-remove file Makefile exact "CMAKE_ARGS+=\t-DQDOC_USER_CLANG_VERSION:STRING=\"`${LLVM_CONFIG} --version`\""
text line-remove file pkg-plist exact "bin/qdoc6"
text line-remove file pkg-plist exact "%%QT_INCDIR%%/QtQDocCatch/QtQDocCatchDepends"
text line-remove file pkg-plist exact "%%QT_INCDIR%%/QtQDocCatch/catch/catch.hpp"
text line-remove file pkg-plist exact "%%QT_INCDIR%%/QtQDocCatchConversions/QtQDocCatchConversionsDepends"
text line-remove file pkg-plist exact "%%QT_INCDIR%%/QtQDocCatchConversions/catch_conversions/qdoc_catch_conversions.h"
text line-remove file pkg-plist exact "%%QT_INCDIR%%/QtQDocCatchConversions/catch_conversions/qt_catch_conversions.h"
text line-remove file pkg-plist exact "%%QT_INCDIR%%/QtQDocCatchConversions/catch_conversions/std_catch_conversions.h"
text line-remove file pkg-plist exact "%%QT_INCDIR%%/QtQDocCatchGenerators/QtQDocCatchGeneratorsDepends"
text line-remove file pkg-plist exact "%%QT_INCDIR%%/QtQDocCatchGenerators/catch_generators/generators/combinators/cycle_generator.h"
text line-remove file pkg-plist exact "%%QT_INCDIR%%/QtQDocCatchGenerators/catch_generators/generators/combinators/oneof_generator.h"
text line-remove file pkg-plist exact "%%QT_INCDIR%%/QtQDocCatchGenerators/catch_generators/generators/k_partition_of_r_generator.h"
text line-remove file pkg-plist exact "%%QT_INCDIR%%/QtQDocCatchGenerators/catch_generators/generators/path_generator.h"
text line-remove file pkg-plist exact "%%QT_INCDIR%%/QtQDocCatchGenerators/catch_generators/generators/qchar_generator.h"
text line-remove file pkg-plist exact "%%QT_INCDIR%%/QtQDocCatchGenerators/catch_generators/generators/qstring_generator.h"
text line-remove file pkg-plist exact "%%QT_INCDIR%%/QtQDocCatchGenerators/catch_generators/namespaces.h"
text line-remove file pkg-plist exact "%%QT_INCDIR%%/QtQDocCatchGenerators/catch_generators/utilities/semantics/copy_value.h"
text line-remove file pkg-plist exact "%%QT_INCDIR%%/QtQDocCatchGenerators/catch_generators/utilities/semantics/generator_handler.h"
text line-remove file pkg-plist exact "%%QT_INCDIR%%/QtQDocCatchGenerators/catch_generators/utilities/semantics/move_into_vector.h"
text line-remove file pkg-plist exact "%%QT_INCDIR%%/QtQDocCatchGenerators/catch_generators/utilities/statistics/distribution.h"
text line-remove file pkg-plist exact "%%QT_INCDIR%%/QtQDocCatchGenerators/catch_generators/utilities/statistics/percentages.h"
text line-remove file pkg-plist exact "lib/cmake/Qt6QDocCatchConversionsPrivate/Qt6QDocCatchConversionsPrivateAdditionalTargetInfo.cmake"
text line-remove file pkg-plist exact "lib/cmake/Qt6QDocCatchConversionsPrivate/Qt6QDocCatchConversionsPrivateConfig.cmake"
text line-remove file pkg-plist exact "lib/cmake/Qt6QDocCatchConversionsPrivate/Qt6QDocCatchConversionsPrivateConfigVersion.cmake"
text line-remove file pkg-plist exact "lib/cmake/Qt6QDocCatchConversionsPrivate/Qt6QDocCatchConversionsPrivateConfigVersionImpl.cmake"
text line-remove file pkg-plist exact "lib/cmake/Qt6QDocCatchConversionsPrivate/Qt6QDocCatchConversionsPrivateTargets.cmake"

port devel/volk
type port
reason "DragonFly: std::filesystem from cxxfs_gcc8 for base gcc 8"
target @any

# Boost dropped the libboost_system stub in 1.89, and 3.x does not use
# Boost; the old LIB_DEPENDS on it can never be met. Append the cxxfs
# flags; mk add would write CXXFLAGS=/LDFLAGS= and drop the defaults.
mk add BUILD_DEPENDS "cxxfs_gcc8>0:misc/cxxfs_gcc8"
mk eval CXXFLAGS "${CXXFLAGS} -isystem ${LOCALBASE}/cxxfs_gcc8"
mk eval LDFLAGS "${LDFLAGS} -L${LOCALBASE}/cxxfs_gcc8"

port devel/wizer
type port
reason "DragonFly: cap-primitives oflags, system-interface fadvise/fallocate (cargo:extra)"

# extra-cap-primitives-3.4.5: rustix has no OFlags::DSYNC or RSYNC on
# DragonFly; approximate DSYNC with SYNC and skip RSYNC, as cap-primitives
# does for FreeBSD (as devel/uv).

mk eval USES "${USES:S/cargo/cargo:extra/}"

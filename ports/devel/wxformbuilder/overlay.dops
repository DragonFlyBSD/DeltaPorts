port devel/wxformbuilder
type port
reason "CMake supports RUNTIME_DEPENDENCY_SET on Windows, Linux, macOS and FreeBSD only"
target @any

# The set only feeds the Windows bundling installs; don't register it.
mk target set dfly-patch <<'MK'
	${REINPLACE_CMD} -e '/^ *RUNTIME_DEPENDENCY_SET wxFormBuilder_dependencies$$/d' \
		${WRKSRC}/src/CMakeLists.txt ${WRKSRC}/cmake/functions.cmake
MK

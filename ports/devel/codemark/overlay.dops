port devel/codemark
type port
reason "DragonFly: wasmtime trap registers (dragonfly/@<line> cargo-crate patch)"

# dragonfly/@<line>/patch-cargo-crates_wasmtime-29.0.1_src_runtime_vm_sys_unix_signals.rs:

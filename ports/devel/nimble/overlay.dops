port devel/nimble
type port
reason "DragonFly: the bundled nim-chronos tests defined(dragonflybsd) for its BSD sendfile(); Nim calls the OS dragonfly"

target @2026Q4,@main
mk target set dfly-patch <<'MK1'
	${REINPLACE_CMD} -e 's|defined(dragonflybsd)|defined(dragonfly)|' \
		${WRKSRC_chronos}/chronos/sendfile.nim
MK1

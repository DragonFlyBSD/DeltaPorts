port devel/libsigrok
type port
reason "auto-converted from Makefile.DragonFly"
target @any

mk target set dfly-patch <<'MK1'
	${REINPLACE_CMD} -e 's@_POSIX_C_SOURCE@&___@g' \
		${WRKSRC}/config.h.in
	${REINPLACE_CMD} -e 's@_XOPEN_SOURCE@&___@g' \
		${WRKSRC}/bindings/cxx/classes.cpp \
		${WRKSRC}/src/std.c \
		${WRKSRC}/src/strutil.c
MK1

# The FreeBSD libusb workarounds in src/libsigrok-internal.h (no
# libusb_has_capability) and src/usb.c (libusb_get_port_numbers) are keyed on
# __FreeBSD__, which DragonFly lost with USES=alias; its base libusb is the
# FreeBSD one. dragonfly/@<line>/ adds __DragonFly__.

port devel/opencl-clang
type port
reason "DragonFly: build the llvm17 flavor with clang and libc++, like the LLVM it links"

# devel/llvm17 sets USE_CLANG_FALLBACK=default, so libLLVM-17/libclang-cpp
# are built with clang${LLVM_DEFAULT} against that generation's libc++, as
# is devel/spirv-llvm-translator@llvm17. Built with base gcc and libstdc++,
# opencl-clang failed to link them (std::__cxx11 symbols). llvm17 is also
# the default flavor, so key on ${FLAVOR} where USES is read.
target @2026Q4,@main

mk add USES "${FLAVOR:Mllvm17:C/.+/dfly-libcxx/}"

port devel/libvirt
type port
reason "DragonFly: QEMU driver on, no ZFS; NVMM accelerator, BSD network driver"
target @any

mk eval OPTIONS_DEFAULT "${OPTIONS_DEFAULT:NZFS} QEMU"

# -Wl,-no_warn_duplicate_libraries is macOS ld's; GNU ld reads it as
# -n -o _warn_duplicate_libraries, so meson's probe passes.
mk target set dfly-patch <<'MK'
	${REINPLACE_CMD} -e '/libvirt_no_warn_duplicate_libraries/d' \
		${WRKSRC}/src/meson.build \
		${WRKSRC}/tests/meson.build \
		${WRKSRC}/tools/meson.build
MK

port devel/libdex
type port
reason "DragonFly: no eventfd(2)"

# meson.mk turns auto features on, so the eventfd feature is required and
# configure stops when eventfd() is not found ("Entry HAVE_EVENTFD not in
# configuration data"). DragonFly has no eventfd; libdex's semaphores
# fall back to their non-eventfd path.
target @2026Q4,@main

mk add MESON_ARGS "-Deventfd=disabled"

# The work-stealing queue stores 16-byte _Atomic(DexWorkItem) values. gcc
# never inlines 16-byte atomics and calls __atomic_load_16/_store_16 from
# libatomic, which FreeBSD's compiler-rt provides and DragonFly's base gcc
# does not ship. Build with gcc 13, whose libatomic is in the ports, and link
# it as upstream already does on Linux (dragonfly/@<line>/patch-src_meson.build).
mk set USE_GCC_VERSION "13"

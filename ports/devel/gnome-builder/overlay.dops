port devel/gnome-builder
type port
reason "auto-converted from compat (Makefile.DragonFly + dragonfly/)"
target @any

mk eval OPTIONS_DEFAULT "${OPTIONS_DEFAULT:NCLANG}"
mk target set dfly-install <<'MK1'
	${TOUCH} ${STAGEDIR}${LOCALBASE}/libexec/gnome-builder-clang
	${TOUCH} ${STAGEDIR}${LOCALBASE}/share/glib-2.0/schemas/org.gnome.builder.clang.gschema.xml
MK1

# gcc does not fold GDK_RGBA ("rrggbb")'s string-literal indexing into a
# constant, so the static palettes fail: write them out as initializers.
mk target set dfly-patch <<'MK2'
	${REINPLACE_CMD} -E 's/GDK_RGBA \("([0-9a-fA-F]{2})([0-9a-fA-F]{2})([0-9a-fA-F]{2})"\)/{ 0x\1 \/ 255., 0x\2 \/ 255., 0x\3 \/ 255., 1. }/g' \
		${WRKSRC}/src/libide/terminal/ide-terminal-palettes.h
MK2

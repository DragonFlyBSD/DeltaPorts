port devel/bazel7
type port
reason "DragonFly: map Java's os.name dragonflybsd to GOOS dragonfly in the bundled rules_go"

# Bazel's repository_ctx.os.name is Java's os.name lower-cased, "dragonflybsd"
# here, and rules_go 0.39.1 uses it verbatim as GOOS, so analysis stops with
# "no such target '@@rules_go~//go/toolchain:dragonflybsd'". The dragonfly/
# patches add toolchain_local/rules_go_dragonfly.patch and apply it through a
# single_version_override in MODULE.bazel, as FreeBSD does for rules_python.
# Bazel's OS enum knows no "DragonFlyBSD" either: the dragonfly/ OS.java patch
# maps it to FREEBSD, as CommandBuilder refuses to run commands on UNKNOWN.
# The external C++ repos key their platform code on __FreeBSD__: grpc's
# port_platform.h stops at "Could not auto-detect platform", and abseil's
# vdso_support.cc defines Elf64_auxv_t for FreeBSD only. The same
# MODULE.bazel overrides add toolchain_local/grpc_dragonfly.patch (DragonFly
# takes the FreeBSD block) and abseil_dragonfly.patch.
target @2026Q4,@main

text replace-once file files/toolchain_local-BUILD from "exports_files([\"rules_python_freebsd.patch\"])" to "exports_files([\"rules_python_freebsd.patch\", \"rules_go_dragonfly.patch\", \"grpc_dragonfly.patch\", \"abseil_dragonfly.patch\"])"

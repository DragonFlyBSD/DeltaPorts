port devel/bazel7
type port
reason "DragonFly: map Java's os.name dragonflybsd to GOOS dragonfly in the bundled rules_go"

# Bazel's repository_ctx.os.name is Java's os.name lower-cased, "dragonflybsd"
# here, and rules_go 0.39.1 uses it verbatim as GOOS, so analysis stops with
# "no such target '@@rules_go~//go/toolchain:dragonflybsd'". The dragonfly/
# patches add toolchain_local/rules_go_dragonfly.patch and apply it through a
# single_version_override in MODULE.bazel, as FreeBSD does for rules_python.
# Bazel's OS enum knows no "DragonFlyBSD" either: the dragonfly/ OS.java patch
# maps it to FREEBSD, as CommandBuilder refuses to run commands on UNKNOWN.
# The external C++ repos key their platform code on __FreeBSD__: grpc's
# port_platform.h stops at "Could not auto-detect platform", and abseil
# enables mmap (config.h, else LowLevelAlloc is left out) and Elf64_auxv_t
# (vdso_support.cc) for FreeBSD only; its status.cc also uses errno names
# that only libc++ supplies on FreeBSD. The same
# MODULE.bazel overrides add toolchain_local/grpc_dragonfly.patch (DragonFly
# takes the FreeBSD block) and abseil_dragonfly.patch. platforms_dragonfly.patch
# gives @platforms//host the FreeBSD OS constraint; without one, Bazel's own
# select()s pick the Linux sources.
target @2026Q4,@main

text replace-once file files/toolchain_local-BUILD from "exports_files([\"rules_python_freebsd.patch\"])" to "exports_files([\"rules_python_freebsd.patch\", \"rules_go_dragonfly.patch\", \"grpc_dragonfly.patch\", \"abseil_dragonfly.patch\", \"platforms_dragonfly.patch\"])"

# The client, its JNI library and singlejar key their platform code on
# __FreeBSD__ (or stop with "Unknown platform"): DragonFly takes the FreeBSD
# branches, except GetSelfPath (dragonfly/), which has no libprocstat here;
# the client's freebsd linkopts drop -lprocstat.
mk target set dfly-patch <<'MK'
	${REINPLACE_CMD} -e 's/defined(__FreeBSD__)/defined(__FreeBSD__) || defined(__DragonFly__)/' \
		${WRKSRC}/src/tools/singlejar/diag.h \
		${WRKSRC}/src/tools/singlejar/mapped_file_posix.inc \
		${WRKSRC}/src/tools/singlejar/zip_headers.h \
		${WRKSRC}/src/main/native/unix_jni.h \
		${WRKSRC}/src/main/native/unix_jni_bsd.cc
	${REINPLACE_CMD} -e '/"-lprocstat",/d' ${WRKSRC}/src/main/cpp/BUILD
MK

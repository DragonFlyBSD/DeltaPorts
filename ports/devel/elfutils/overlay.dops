port devel/elfutils
type port
reason "add BUILD_DEPENDS, CFLAGS/LDFLAGS; dfly-patch/install targets; move headers/libs to elfutils subdir"
target @any

mk add BUILD_DEPENDS "gnustat:sysutils/coreutils"
mk add BUILD_DEPENDS "bash>0:shells/bash"
mk add CFLAGS "-Wno-error=cast-function-type -O1"
mk add CFLAGS "-std=gnu17"
mk add LDFLAGS "-Wl,-rpath,${LOCALBASE}/lib/elfutils"

# Newer gnulib obstack.c includes <stdckdint.h> (C23) which DragonFly
# 6.5 base headers lack, and uses max_align_t hidden under -std=gnu99.
# WRKSRC/lib/obstack.c is copied at pre-configure time so it cannot be
# patched statically; provision a compatible shim alongside the copies
# when the system header is absent.
mk target append pre-configure <<'MK'
	if ! echo '#include <stdckdint.h>' | ${CC} -E - >/dev/null 2>&1; then \
	  ${PRINTF} '#ifndef _GL_STDCKDINT_H\n#define _GL_STDCKDINT_H\n/* DragonFly shim for C23 <stdckdint.h> via compiler builtins. */\n#include <stddef.h>\n#define ckd_add(_R,_A,_B) __builtin_add_overflow((_A),(_B),(_R))\n#define ckd_sub(_R,_A,_B) __builtin_sub_overflow((_A),(_B),(_R))\n#define ckd_mul(_R,_A,_B) __builtin_mul_overflow((_A),(_B),(_R))\n#endif\n' > ${WRKSRC}/lib/stdckdint.h; \
	fi
MK

mk set DPMSG "${WRKDIR}/dports-message"
mk set PKGMESSAGE "${DPMSG}"

mk target set dfly-patch <<'MK'
	@${ECHO} "[" > ${DPMSG}
	@${ECHO} "{ type: install" >> ${DPMSG}
	@${ECHO} "  message: <<EOM" >> ${DPMSG}
	@${ECHO} "To use this port add:" >> ${DPMSG}
	@${ECHO} "  CFLAGS+= -I${LOCALBASE}/include/elfutils" >> ${DPMSG}
	@${ECHO} "           -I${LOCALBASE}/include" >> ${DPMSG}
	@${ECHO} "  LDFLAGS+= -L${LOCALBASE}/lib/elfutils" >> ${DPMSG}
	@${ECHO} "            -Wl,-rpath,${LOCALBASE}/lib/elfutils" >> ${DPMSG}
	@${ECHO} "EOM" >> ${DPMSG}
	@${ECHO} "}" >> ${DPMSG}
	@${ECHO} "]" >> ${DPMSG}
	${REINPLACE_CMD} -e "s@Libs: @&-L${LOCALBASE}/lib/elfutils -Wl,-rpath,${LOCALBASE}/lib/elfutils @g" \
			 -e "s@Cflags: @&-I${LOCALBASE}/include/elfutils @g" \
			 -e '/Requires: libelf =/d' \
		${WRKSRC}/config/libelf.pc.in ${WRKSRC}/config/libdw.pc.in
	${REINPLACE_CMD} -e 's@dwarfcfi_LDADD =@& $$(libeu) @g' \
			 -e 's@next_cfi_LDADD =@& $$(libeu) @g' \
		${WRKSRC}/tests/Makefile.am
	${REINPLACE_CMD} -e 's@wc --lines@wc -l@g' \
		${WRKSRC}/tests/run-strip-test.sh
	${REINPLACE_CMD} -e 's@ /bin/sh@/usr/local/bin/bash@g' \
			 -e 's@ /bin/bash@/usr/local/bin/bash@g' \
			 -e 's@stat -c@gnustat -c@g' \
		${WRKSRC}/tests/*.sh
MK

mk target set dfly-install <<'MK'
	${MV} -v ${STAGEDIR}${PREFIX}/include/*.h \
		${STAGEDIR}${PREFIX}/include/elfutils/
	${MKDIR} ${STAGEDIR}${PREFIX}/lib/elfutils
	${MV} -v ${STAGEDIR}${PREFIX}/lib/lib* \
		${STAGEDIR}${PREFIX}/lib/elfutils/
	${MV} -v ${STAGEDIR}${PREFIX}/libdata/pkgconfig/libelf.pc \
		${STAGEDIR}${PREFIX}/libdata/pkgconfig/elfutils.pc
MK

patch apply diffs/pkg-plist.diff

# dragonfly/@2026Q3, @2026Q4, @main: gelf.h typedefs GElf_Lib from
# Elf64_Lib, which only elfutils' own elf.h defines; consumers include
# DragonFly's <elf.h>, which has no Elf64_Lib (emulators/qemu with libdw,
# devel/libabigail). Add a fallback in gelf.h guarded by a
# LIBELF_ELF_LIB_DEFINED marker in elfutils' elf.h, as FreeBSD's files/
# patches do for Elf64_Section and Elf64_auxv_t (patch-libelf_gelf.h, and
# patch-libelf_elf.h, which also keeps NT_BSD_ABI_TAG). Bump PORTREVISION
# so the package carrying the new header is rebuilt.
target @2026Q3,@2026Q4,@main

mk bump PORTREVISION

port devel/libcdb
type port
reason "auto-converted from Makefile.DragonFly"
target @any

mk target set dfly-patch <<'MK1'
	${REINPLACE_CMD} -e 's@FreeBSD@DragonFly@g' \
		${WRKSRC}/Makefile
	${REINPLACE_CMD} -e 's@ && !defined(__FreeBSD__)$$@& \&\& !defined(__DragonFly__)@' \
		${WRKSRC}/cdb_impl.h
MK1

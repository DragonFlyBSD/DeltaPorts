port devel/sccache
type port
reason "auto-converted from Makefile.DragonFly; skip libmount on DragonFly like FreeBSD"
target @any

mk eval USES "${USES:S/cargo/cargo:extra/}"

# libmount needs nix::mount, which only exists on Linux; sccache already
# skips the dependency on FreeBSD for the same reason.
mk target set dfly-patch <<'MK'
	@${REINPLACE_CMD} -e 's|not(target_os = "freebsd")|not(any(target_os = "freebsd", target_os = "dragonfly"))|' \
		${WRKSRC}/Cargo.toml
MK

port devel/py-pyinstaller
type port
reason "DragonFly: allow foreign binaries when DEVELOPER defined; DragonFly support patches per line in dragonfly/@<line>"

# dragonfly/@2026Q4 and @main are re-cut for 6.22: waf reports DragonFly
# as DEST_OS 'generic', so map it to 'dragonfly', and take the FreeBSD paths
# in the bootloader (floatingpoint, ntohl, /proc/curproc/file) and in
# PyInstaller.compat.
target @any

mk block set condition "defined(DEVELOPER)" <<'MK'
.MAKEFLAGS+=	DFLY_ALLOW_FOREIGN_BINARIES=yes
DFLY_ALLOW_FOREIGN_BINARIES=yes
MK

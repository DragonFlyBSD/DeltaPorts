port devel/llvm21
type port
reason "build against libc++; disable LLDB/FLANG/COMPILER_RT/OPENMP; add LLD_LINK; dfly-patch/install; binutils@native"
# Modelled on devel/llvm20: llvm21 had no overlay and fails in the bulk
# build. The Makefile anchors were verified present and identical; the
# pkg-plist deletion is ADOPTED FROM llvm20 UNVERIFIED -- this version's
# real plist delta is unknown, so expect the agent to correct it.
target @any

mk eval OPTIONS_DEFAULT "${OPTIONS_DEFAULT:NLLDB:NFLANG:NCOMPILER_RT:NOPENMP}"
mk add OPTIONS_DEFINE LLD_LINK

mk target set dfly-patch <<'MK'
	${REINPLACE_CMD} -e 's,set(ENABLE_LIBOMPTARGET ON),set(ENABLE_LIBOMPTARGET OFF),g' \
		${WRKSRC}/openmp/CMakeLists.txt
MK

mk target set dfly-install <<'MK'
	-${RM} -fv ${STAGEDIR}${PREFIX}/bin/llvm-omp-device-info${LLVM_SUFFIX}
MK

# gcc will not resolve the std::make_unique overload set against
# std::function; clang picks an overload. Wrap each entry in a lambda with
# an explicit return type. devel/llvm19 has a byte-identical table and the
# same gcc14 and does not need this, so what changed is libc++ 20.
file materialize dragonfly/patch-clang-tools-extra_clangd_index_dex_dexp_Dexp.cpp -> dragonfly/patch-clang-tools-extra_clangd_index_dex_dexp_Dexp.cpp

# Both Makefile edits are single, uniquely-anchored lines, so express
# them rather than carrying a diff: no context to drift. Anchored on the
# whole GOLD_BUILD_DEPENDS line because "devel/binutils" alone appears
# twice, and replace-once refuses an ambiguous match.
text replace-once file Makefile \
  from "GOLD_BUILD_DEPENDS=\t${LOCALBASE}/bin/ld.gold:devel/binutils" \
  to   "GOLD_BUILD_DEPENDS=\t${LOCALBASE}/bin/ld.gold:devel/binutils@native"
mk target rename post-install-LLD-on -> post-install-LLD_LINK-on
# pkg-plist edits are pure line deletions: express them directly so
# there is no context to drift, and a line that vanishes upstream
# fails loudly instead of rejecting a hunk.
text line-remove file pkg-plist exact "%%LLD%%llvm%%LLVM_SUFFIX%%/bin/ld"

# libclang's API passes std:: types across the boundary, so every port that
# links it has to agree on the standard library. gcc15 as for llvm22, and it
# is used here rather than clang because clang comes from this port.
#
# devel/libcxx21 installs into ${LLVM_PREFIX} itself, the layout clang's
# driver derives from its own location, so clang finds libc++ with no
# clang++.cfg. A cfg applies to every target, including cross-compiles:
# it put a second copy of the libc++ headers behind the build's own, and
# the duplicate include guards cut the #include_next chain to the target
# libc, which is what broke devel/wasi-libcxx21.
mk block set condition "${OPSYS} == DragonFly" <<'MK'
USE_GCC_VERSION=	15
LIB_DEPENDS+=		libc++.so.1:devel/libcxx21
CMAKE_ARGS+=		-DCLANG_DEFAULT_CXX_STDLIB=libc++
CXXFLAGS+=		-nostdinc++ -nostdlib++ -isystem ${LLVM_PREFIX}/include/c++/v1
LDFLAGS+=		-L${LLVM_PREFIX}/lib -Wl,-rpath=${LLVM_PREFIX}/lib -lc++ -lc++abi -lm
MK

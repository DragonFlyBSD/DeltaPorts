port devel/libukcprog
type port
reason "auto-converted from Makefile.DragonFly"
target @any


# Like FreeBSD, DragonFly declares sys_nerr/sys_errlist (const) in <stdio.h>.
mk target set dfly-patch <<'MK'
	${REINPLACE_CMD} -e 's/^#ifndef __FreeBSD__$$/#if !defined(__FreeBSD__) \&\& !defined(__DragonFly__)/' \
		${WRKSRC}/src/logf.c ${WRKSRC}/src/formf.c
MK

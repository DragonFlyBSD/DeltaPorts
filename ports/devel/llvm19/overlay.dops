port devel/llvm19
type port
reason "build against libc++; ship clang++.cfg; disable LLDB/FLANG/COMPILER_RT/OPENMP; add LLD_LINK; dfly-patch/install; binutils@native"
target @any

mk eval OPTIONS_DEFAULT "${OPTIONS_DEFAULT:NLLDB:NFLANG:NCOMPILER_RT:NOPENMP}"
mk add OPTIONS_DEFINE LLD_LINK

mk target set dfly-patch <<'MK'
	${REINPLACE_CMD} -e 's,set(ENABLE_LIBOMPTARGET ON),set(ENABLE_LIBOMPTARGET OFF),g' \
		${WRKSRC}/openmp/CMakeLists.txt
MK

mk target set dfly-install <<'MK'
	-${RM} -fv ${STAGEDIR}${PREFIX}/bin/llvm-omp-device-info${LLVM_SUFFIX}
	${ECHO} '-stdlib=libc++' > ${STAGEDIR}${LLVM_PREFIX}/bin/clang++.cfg
	${ECHO} '-cxx-isystem ${LLVM_PREFIX}/libcxx/include/c++/v1' >> ${STAGEDIR}${LLVM_PREFIX}/bin/clang++.cfg
	${ECHO} '-L${LLVM_PREFIX}/libcxx/lib' >> ${STAGEDIR}${LLVM_PREFIX}/bin/clang++.cfg
MK

mk add PLIST_FILES "llvm%%LLVM_SUFFIX%%/bin/clang++.cfg"

# Both Makefile edits are single, uniquely-anchored lines, so express
# them rather than carrying a diff: no context to drift. Anchored on the
# whole GOLD_BUILD_DEPENDS line because "devel/binutils" alone appears
# twice, and replace-once refuses an ambiguous match.
text replace-once file Makefile \
  from "GOLD_BUILD_DEPENDS=\t${LOCALBASE}/bin/ld.gold:devel/binutils" \
  to   "GOLD_BUILD_DEPENDS=\t${LOCALBASE}/bin/ld.gold:devel/binutils@native"
mk target rename post-install-LLD-on -> post-install-LLD_LINK-on
# pkg-plist edits are pure line deletions: express them directly so
# there is no context to drift, and a line that vanishes upstream
# fails loudly instead of rejecting a hunk.
text line-remove file pkg-plist exact "%%LLD%%llvm%%LLVM_SUFFIX%%/bin/ld"

# libclang's API passes std:: types across the boundary, so every port that
# links it has to agree on the standard library. gcc14 is the oldest gcc
# that can parse libc++'s headers -- they use __has_feature, which gcc
# implemented in 14 -- and it is used here rather than clang because clang
# comes from this port.
mk block set condition "${OPSYS} == DragonFly" <<'MK'
USE_GCC_VERSION=	14
LIB_DEPENDS+=		libc++.so.1:devel/libcxx19
CXXFLAGS+=		-nostdinc++ -nostdlib++ -isystem ${LLVM_PREFIX}/libcxx/include/c++/v1
LDFLAGS+=		-L${LLVM_PREFIX}/libcxx/lib -lc++ -lc++abi -lm
MK

port devel/libphonenumber
type port
reason "auto-converted from compat (Makefile.DragonFly + dragonfly/)"
target @any

mk set MAKE_JOBS_UNSAFE "yes"
mk add USES "gmake"
# CXXFLAGS is not assigned by the port: append, keeping sys.mk's flags.
mk eval CXXFLAGS "${CXXFLAGS} -Wno-error=sign-compare"

# dragonfly/: FreeBSD's files/ add __FreeBSD__ to the POSIX-thread checks
# in the base headers (installed for consumers); add __DragonFly__ beside it.

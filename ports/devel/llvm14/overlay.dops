port devel/llvm14
type port
reason "disable LLDB/FLANG/COMPILER_RT/OPENMP; clang+openmp extra patches; fix gcc; drop ld symlink and TEST_CMD; binutils@native"
target @any

mk eval OPTIONS_DEFAULT "${OPTIONS_DEFAULT:NLLDB:NFLANG:NOPENMP}"
mk eval OPTIONS_DEFAULT_x86_64 "${OPTIONS_DEFAULT_x86_64:NCOMPILER_RT:NLLDB:NOPENMP}"

# Copied from devel/llvm60, should be okay for now
mk add CLANG_EXTRA_PATCHES "${DFLY_PATCHDIR}/clang-patch-tools_clang_lib_Basic_Targets_OSTargets.h"
mk add OPENMP_EXTRA_PATCHES "${DFLY_PATCHDIR}/openmp-patch-openmp_runtime_src_kmp__wrapper__getpid.h"

# some leftover garbage
mk add MAN1SRCS lldb-tblgen.1

mk target set dfly-patch <<'MK'
	${REINPLACE_CMD} -e 's|gcc50|gcc80|g' -e 's|5.0"|8.0"|' \
		${WRKSRC}/clang/lib/Driver/ToolChains/DragonFly.cpp \
		${WRKSRC}/clang/lib/Lex/InitHeaderSearch.cpp
	-${REINPLACE_CMD} -e 's,set(ENABLE_LIBOMPTARGET ON),set(ENABLE_LIBOMPTARGET OFF),g' \
		${WRKSRC}/openmp/CMakeLists.txt
MK

mk target set dfly-install <<'MK'
	-${RM} -fv ${STAGEDIR}${PREFIX}/bin/llvm-omp-device-info${LLVM_SUFFIX}
MK

file materialize dragonfly/clang-patch-tools_clang_lib_Basic_Targets_OSTargets.h -> dragonfly/clang-patch-tools_clang_lib_Basic_Targets_OSTargets.h
file materialize dragonfly/openmp-patch-openmp_runtime_src_kmp__wrapper__getpid.h -> dragonfly/openmp-patch-openmp_runtime_src_kmp__wrapper__getpid.h

# Both Makefile edits are single, uniquely-anchored lines, so express
# them rather than carrying a diff: no context to drift. Anchored on the
# whole GOLD_BUILD_DEPENDS line because "devel/binutils" alone appears
# twice, and replace-once refuses an ambiguous match.
text replace-once file Makefile \
  from "GOLD_BUILD_DEPENDS=\t${LOCALBASE}/bin/ld.gold:devel/binutils" \
  to   "GOLD_BUILD_DEPENDS=\t${LOCALBASE}/bin/ld.gold:devel/binutils@native"
text line-remove file Makefile exact "\t${LN} -s ld.lld ${STAGEDIR}${LLVM_PREFIX}/bin/ld"
text line-remove file Makefile exact "TEST_CMD=\t'(cd ${WRKSRC}/test; ${SETENV} ${MAKE_ENV} LD_LIBRARY_PATH=${WRKSRC}/Release/lib ${MAKE_CMD} check-local-lit)'"
# pkg-plist edits are pure line deletions: express them directly so
# there is no context to drift, and a line that vanishes upstream
# fails loudly instead of rejecting a hunk.
text line-remove file pkg-plist exact "%%OPENMP%%bin/llvm-omp-device-info%%LLVM_SUFFIX%%"
text line-remove file pkg-plist exact "%%LLD%%llvm%%LLVM_SUFFIX%%/bin/ld"
text line-remove file pkg-plist exact "%%OPENMP%%llvm%%LLVM_SUFFIX%%/bin/llvm-omp-device-info"
text line-remove file pkg-plist exact "%%OPENMP%%llvm%%LLVM_SUFFIX%%/lib/libomptarget.rtl.amdgpu.so"
text line-remove file pkg-plist exact "%%OPENMP%%llvm%%LLVM_SUFFIX%%/lib/libomptarget.so"

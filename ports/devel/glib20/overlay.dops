port devel/glib20
type port
target @any
reason "Update GLib to 2.88.2 for GNOME 50; carry DragonFly GIO, module and faccessat fixes"

mk add MAKE_ENV "LC_ALL=C"

file materialize dragonfly/Makefile -> Makefile
file materialize dragonfly/distinfo -> distinfo
file materialize dragonfly/pkg-plist -> pkg-plist
file materialize dragonfly/patch-gio_gunixmount.c -> files/patch-gio_gunixmount.c
file materialize dragonfly/patch-gio_gunixmounts.c -> files/patch-gio_gunixmounts.c
file materialize dragonfly/patch-gio_gunixvolume.c -> files/patch-gio_gunixvolume.c
file materialize dragonfly/patch-gio_glocalfile.c -> files/patch-gio_glocalfile.c
file materialize dragonfly/patch-glib_glib-unix.c -> files/patch-glib_glib-unix.c
file materialize dragonfly/patch-gmodule_gmodule.c -> files/patch-gmodule_gmodule.c

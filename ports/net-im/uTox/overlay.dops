port net-im/uTox
type port
reason "build as FreeBSD; ld emulation name for the embedded icon"

# post-patch adds -m${_LLD_EMUL_${ARCH}} to the ld -b binary call that
# embeds the icon; DragonFly's ld calls the emulation elf_x86_64.
target @any

mk set _LLD_EMUL_amd64 "elf_x86_64"
mk set _LLD_EMUL_x86_64 "elf_x86_64"
# Appended through CFLAGS_x86_64: the port sets no CFLAGS of its own.
mk set CFLAGS_x86_64 "-Wno-cast-function-type -Wno-implicit-fallthrough"

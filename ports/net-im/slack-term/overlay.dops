port net-im/slack-term
type port
reason "vendored xdg: the Linux paths, as FreeBSD links them"
target @any

# xdg v0.2.0 has per-OS files by name only; FreeBSD's post-patch links
# xdg_linux.go to xdg_freebsd.go.
mk target set dfly-patch <<'MK'
	@cd ${WRKSRC}/vendor/github.com/OpenPeeDeeP/xdg && \
		${RLN} xdg_linux.go xdg_dragonfly.go
MK

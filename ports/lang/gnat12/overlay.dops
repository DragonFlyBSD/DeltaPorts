port lang/gnat12
type port
reason "disable NLS; bootstrap from gcc6-aux; LIB_DIR_32 override; plist: drop LIB32 s-mmap/mmauni/mmosin, freebsd config headers, add dragonfly ones"
target @any

mk add CONFIGURE_ARGS "--disable-nls"

# LIB_DIR_32 is set inside arch-conditional blocks; add an unconditional
# override via patch apply (diff adds a new standalone line, not editing existing)
patch apply diffs/Makefile.diff

# The default PREVASSET bootstrap fetches gnat-x86_64-dragonfly.6-*.tar.xz,
# an asset nobody has built for DragonFly. Bootstrap from lang/gcc6-aux, as
# the last DragonFly build (12.2.0) did.
text replace-once file Makefile from "OPTIONS_DEFAULT=\t\tPREVASSET" to "OPTIONS_DEFAULT=\t\tGCC6AUX"

# The NLS option (on by default) appends --enable-nls after the
# --disable-nls above; gnatlink then fails to link: ld cannot find -lintl.
target @2026Q4,@main

mk set OPTIONS_EXCLUDE_DragonFly "NLS"

# pkg-plist: the x86_64-*-dragonfly* target installs dragonfly*.h config
# headers where FreeBSD gets freebsd*.h.
target @2026Q4,@main

text line-remove file pkg-plist exact "%%LIB32%%%%GNAT%%/lib/gcc/%%CONFTRGT%%/%%VER%%/32/adainclude/s-mmap.adb"
text line-remove file pkg-plist exact "%%LIB32%%%%GNAT%%/lib/gcc/%%CONFTRGT%%/%%VER%%/32/adainclude/s-mmap.ads"
text line-remove file pkg-plist exact "%%LIB32%%%%GNAT%%/lib/gcc/%%CONFTRGT%%/%%VER%%/32/adainclude/s-mmauni.ads"
text line-remove file pkg-plist exact "%%LIB32%%%%GNAT%%/lib/gcc/%%CONFTRGT%%/%%VER%%/32/adainclude/s-mmosin.adb"
text line-remove file pkg-plist exact "%%LIB32%%%%GNAT%%/lib/gcc/%%CONFTRGT%%/%%VER%%/32/adainclude/s-mmosin.ads"

text line-insert-after file pkg-plist \
    anchor "%%AARCH64%%%%GNAT%%/lib/gcc/%%CONFTRGT%%/%%VER%%/plugin/include/config/aarch64/biarchlp64.h" \
    line "%%GNAT%%/lib/gcc/%%CONFTRGT%%/%%VER%%/plugin/include/config/dragonfly-stdint.h"
text line-insert-after file pkg-plist \
    anchor "%%GNAT%%/lib/gcc/%%CONFTRGT%%/%%VER%%/plugin/include/config/dragonfly-stdint.h" \
    line "%%GNAT%%/lib/gcc/%%CONFTRGT%%/%%VER%%/plugin/include/config/dragonfly.h"
text line-insert-after file pkg-plist \
    anchor "%%GNAT%%/lib/gcc/%%CONFTRGT%%/%%VER%%/plugin/include/config/dragonfly.h" \
    line "%%GNAT%%/lib/gcc/%%CONFTRGT%%/%%VER%%/plugin/include/config/i386/dragonfly.h"

text line-remove file pkg-plist exact "%%GNAT%%/lib/gcc/%%CONFTRGT%%/%%VER%%/plugin/include/config/freebsd-spec.h"
text line-remove file pkg-plist exact "%%GNAT%%/lib/gcc/%%CONFTRGT%%/%%VER%%/plugin/include/config/freebsd-stdint.h"
text line-remove file pkg-plist exact "%%GNAT%%/lib/gcc/%%CONFTRGT%%/%%VER%%/plugin/include/config/freebsd.h"
text line-remove file pkg-plist exact "%%X86%%%%GNAT%%/lib/gcc/%%CONFTRGT%%/%%VER%%/plugin/include/config/i386/freebsd.h"
text line-remove file pkg-plist exact "%%AMD64%%%%GNAT%%/lib/gcc/%%CONFTRGT%%/%%VER%%/plugin/include/config/i386/freebsd64.h"

# pkg-plist: DragonFly builds no libsanitizer (asan/ubsan), fixincludes
# leaves only limits.h/syslimits.h in include-fixed, and the x86 runtime
# skips the mmap/object-reader units (s-mmauni, s-mmosin, s-dwalin, s-objrea).
target @2026Q4,@main

text line-remove file pkg-plist exact "%%X86%%%%GNAT%%/lib/gcc/%%CONFTRGT%%/%%VER%%/adainclude/s-mmauni.ads"
text line-remove file pkg-plist exact "%%X86%%%%GNAT%%/lib/gcc/%%CONFTRGT%%/%%VER%%/adainclude/s-mmosin.adb"
text line-remove file pkg-plist exact "%%X86%%%%GNAT%%/lib/gcc/%%CONFTRGT%%/%%VER%%/adainclude/s-mmosin.ads"
text line-remove file pkg-plist exact "%%X86%%%%GNAT%%/lib/gcc/%%CONFTRGT%%/%%VER%%/adalib/s-dwalin.ali"
text line-remove file pkg-plist exact "%%X86%%%%GNAT%%/lib/gcc/%%CONFTRGT%%/%%VER%%/adalib/s-mmap.ali"
text line-remove file pkg-plist exact "%%X86%%%%GNAT%%/lib/gcc/%%CONFTRGT%%/%%VER%%/adalib/s-mmauni.ali"
text line-remove file pkg-plist exact "%%X86%%%%GNAT%%/lib/gcc/%%CONFTRGT%%/%%VER%%/adalib/s-mmosin.ali"
text line-remove file pkg-plist exact "%%X86%%%%GNAT%%/lib/gcc/%%CONFTRGT%%/%%VER%%/adalib/s-objrea.ali"
text line-remove file pkg-plist exact "%%GNAT%%/lib/gcc/%%CONFTRGT%%/%%VER%%/include-fixed/stddef.h"
text line-remove file pkg-plist exact "%%GNAT%%/lib/gcc/%%CONFTRGT%%/%%VER%%/include-fixed/stdio.h"
text line-remove file pkg-plist exact "%%GNAT%%/lib/gcc/%%CONFTRGT%%/%%VER%%/include-fixed/stdlib.h"
text line-remove file pkg-plist exact "%%GNAT%%/lib/gcc/%%CONFTRGT%%/%%VER%%/include-fixed/sys/types.h"
text line-remove file pkg-plist exact "%%GNAT%%/lib/gcc/%%CONFTRGT%%/%%VER%%/include-fixed/unistd.h"
text line-remove file pkg-plist exact "%%GNAT%%/lib/gcc/%%CONFTRGT%%/%%VER%%/include-fixed/wchar.h"
text line-remove file pkg-plist exact "%%X86%%%%GNAT%%/lib/gcc/%%CONFTRGT%%/%%VER%%/include/sanitizer/asan_interface.h"
text line-remove file pkg-plist exact "%%X86%%%%GNAT%%/lib/gcc/%%CONFTRGT%%/%%VER%%/include/sanitizer/common_interface_defs.h"
text line-remove file pkg-plist exact "%%X86%%%%GNAT%%/lib/gcc/%%CONFTRGT%%/%%VER%%/include/sanitizer/hwasan_interface.h"
text line-remove file pkg-plist exact "%%X86%%%%GNAT%%/lib/gcc/%%CONFTRGT%%/%%VER%%/include/sanitizer/lsan_interface.h"
text line-remove file pkg-plist exact "%%X86%%%%GNAT%%/lib/gcc/%%CONFTRGT%%/%%VER%%/include/sanitizer/tsan_interface.h"
text line-remove file pkg-plist exact "%%X86%%%%GNAT%%/lib/libasan.a"
text line-remove file pkg-plist exact "%%X86%%%%GNAT%%/lib/libasan.so"
text line-remove file pkg-plist exact "%%X86%%%%GNAT%%/lib/libasan.so.8"
text line-remove file pkg-plist exact "%%X86%%%%GNAT%%/lib/libasan.so.8.0.0"
text line-remove file pkg-plist exact "%%X86%%%%GNAT%%/lib/libasan_preinit.o"
text line-remove file pkg-plist exact "%%X86%%%%GNAT%%/lib/libsanitizer.spec"
text line-remove file pkg-plist exact "%%X86%%%%GNAT%%/lib/libubsan.a"
text line-remove file pkg-plist exact "%%X86%%%%GNAT%%/lib/libubsan.so"
text line-remove file pkg-plist exact "%%X86%%%%GNAT%%/lib/libubsan.so.1"
text line-remove file pkg-plist exact "%%X86%%%%GNAT%%/lib/libubsan.so.1.0.0"

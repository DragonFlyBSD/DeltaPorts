port lang/spidermonkey140
type port
reason "DragonFly target triple, bfd linker, XP_UNIX mozjs metadata, and ICU configure fix for SpiderMonkey 140"
target @any

mk add CONFIGURE_ARGS "--enable-linker=bfd"
mk target set post-patch <<'MK'
	@${REINPLACE_CMD} -e 's|%%LOCALBASE%%|${LOCALBASE}|g' ${WRKSRC}/js/moz.configure
	@${REINPLACE_CMD} -e 's|^Cflags: |Cflags: -DXP_UNIX |' ${WRKSRC}/js/src/build/js.pc.in
	@${REINPLACE_CMD} -e 's|icu-i18n|icu-uc icu-i18n|g' ${WRKSRC}/js/moz.configure
MK
text replace-once file Makefile from "CONFIGURE_TARGET=\tx86_64-portbld-freebsd${OSREL}" to "CONFIGURE_TARGET=\tx86_64-portbld-dragonfly${OSREL}"

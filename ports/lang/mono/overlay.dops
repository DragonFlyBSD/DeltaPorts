port lang/mono
type port
reason "DragonFly: localbase USES, iconv/charset deps, configure fix"

# lang/mono has been a metaport for mono${MONO_DEFAULT} since 2023 (the real
# port, and its DragonFly overlay, is lang/mono5.20): there is no source to
# patch, and dsynth failed on the first dragonfly/ patch. The ops and the
# dragonfly/@2026Q1, @2026Q2 patches are left only on the retired lines.
target @2026Q1,@2026Q2

mk add USES localbase

mk set DFLY_ALLOW_REMAKE "increases chances of building exponentially"

mk add LIB_DEPENDS "libcharset.so:converters/libiconv"

mk add CONFIGURE_ARGS "ac_cv_header_localcharset_h=yes"
mk add CONFIGURE_ARGS "ac_cv_lib_charset_locale_charset=yes"

mk target set dfly-patch <<'MK'
	${REINPLACE_CMD} -e 's@LIBS+="-liconv -lcharset"@LIBS="-liconv -lcharset $$LIBS"@g' \
		${WRKSRC}/configure ${WRKSRC}/configure.ac
MK

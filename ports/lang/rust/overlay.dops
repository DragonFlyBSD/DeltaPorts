port lang/rust
type port
reason "DragonFly: allow OPSYS, point bootstrap at avalon, materialize the dragonfly patch lane and the shared cargo crate patches"
target @any

# --- diffs/Makefile.diff equivalent -------------------------------------
mk replace-if from "${OPSYS} != FreeBSD" \
              to   "${OPSYS} != FreeBSD && ${OPSYS} != DragonFly"

# --- Makefile.DragonFly equivalent --------------------------------------
# Bootstrap tarballs are self-hosted (no cross-build port exists for
# DragonFly); avalon lays them out under <version>/ rather than the
# <compiler_date>/ FreeBSD uses, so BOOTSTRAPS_DATE carries the version.
# RUST_BOOTSTRAP_VERSION already defaults to 1.95.0 upstream.
mk add MASTER_SITES "https://avalon.dragonflybsd.org/misc/distfiles/rust-bootstrap/:bootstrap"
mk set BOOTSTRAPS_DATE "1.95.0"

# ld.gold cannot link std into the rustc driver.
mk add MAKE_ENV "LDVER=ld.bfd"
# The stage0 rustc/cargo need their own shared libs plus base libgcc.
mk add MAKE_ENV "LD_LIBRARY_PATH=${WRKDIR}/bootstrap/lib:/usr/lib/gcc80"

# --- diffs/distinfo.diff equivalent -------------------------------------
# Chained so each line anchors on the one inserted before it.
text line-insert-after file distinfo \
     anchor "SIZE (rust/rustc-1.96.1-src.tar.xz) = 241602032" \
     line   "SHA256 (rust/1.95.0/rustc-1.95.0-x86_64-unknown-dragonfly.tar.xz) = 03693380bf72e839ff5d7c2b0e9626c48baebca08667bef197a5c9ac1adf3595"
text line-insert-after file distinfo \
     anchor "SHA256 (rust/1.95.0/rustc-1.95.0-x86_64-unknown-dragonfly.tar.xz) = 03693380bf72e839ff5d7c2b0e9626c48baebca08667bef197a5c9ac1adf3595" \
     line   "SIZE (rust/1.95.0/rustc-1.95.0-x86_64-unknown-dragonfly.tar.xz) = 67955352"
text line-insert-after file distinfo \
     anchor "SIZE (rust/1.95.0/rustc-1.95.0-x86_64-unknown-dragonfly.tar.xz) = 67955352" \
     line   "SHA256 (rust/1.95.0/rust-std-1.95.0-x86_64-unknown-dragonfly.tar.xz) = 98d3e167dff45e14bf34529dee6bab0d551b1a6045299e029d164786bc1a3ea8"
text line-insert-after file distinfo \
     anchor "SHA256 (rust/1.95.0/rust-std-1.95.0-x86_64-unknown-dragonfly.tar.xz) = 98d3e167dff45e14bf34529dee6bab0d551b1a6045299e029d164786bc1a3ea8" \
     line   "SIZE (rust/1.95.0/rust-std-1.95.0-x86_64-unknown-dragonfly.tar.xz) = 24177544"
text line-insert-after file distinfo \
     anchor "SIZE (rust/1.95.0/rust-std-1.95.0-x86_64-unknown-dragonfly.tar.xz) = 24177544" \
     line   "SHA256 (rust/1.95.0/cargo-1.95.0-x86_64-unknown-dragonfly.tar.xz) = 96f567a18864c3bcb577984409134edce661c625a99dcd186e3388da8e6b4faa"
text line-insert-after file distinfo \
     anchor "SHA256 (rust/1.95.0/cargo-1.95.0-x86_64-unknown-dragonfly.tar.xz) = 96f567a18864c3bcb577984409134edce661c625a99dcd186e3388da8e6b4faa" \
     line   "SIZE (rust/1.95.0/cargo-1.95.0-x86_64-unknown-dragonfly.tar.xz) = 11309856"

# --- dragonfly/ lane: DragonFly patches for the rust source tree --------
# do-patch applies every dragonfly/patch-* via DFLY_PATCHDIR.
file materialize dragonfly/patch-compiler_rustc_codegen_ssa_src_back_link.rs -> dragonfly/patch-compiler_rustc_codegen_ssa_src_back_link.rs
file materialize dragonfly/patch-compiler_rustc_codegen_ssa_src_back_linker.rs -> dragonfly/patch-compiler_rustc_codegen_ssa_src_back_linker.rs
file materialize dragonfly/patch-compiler_rustc_target_src_spec_targets_x86_64_unknown_dragonfly.rs -> dragonfly/patch-compiler_rustc_target_src_spec_targets_x86_64_unknown_dragonfly.rs
file materialize dragonfly/patch-library_backtrace_src_symbolize_gimli.rs -> dragonfly/patch-library_backtrace_src_symbolize_gimli.rs
file materialize dragonfly/patch-library_std_src_sys_io_error_unix.rs -> dragonfly/patch-library_std_src_sys_io_error_unix.rs

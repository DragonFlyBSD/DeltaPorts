port lang/rust
type port
reason "DragonFly: allow OPSYS, add the avalon bootstrap, and carry the dragonfly patch lane plus the shared cargo crate patches"

# Quarterly follows FreeBSD; main carries the latest DragonFly Rust release.

# =======================================================================
# Independent of the rust version.
# =======================================================================
target @any

# --- diffs/Makefile.diff equivalent -------------------------------------
mk replace-if from "${OPSYS} != FreeBSD" \
              to "${OPSYS} != FreeBSD && ${OPSYS} != DragonFly"

# --- dragonfly/ lane: tree-wide cargo crate patches ---------------------
# Mk/Uses/cargo-extra.mk sets CARGO_EXTRA_PATCHDIR=${PORTSDIR}/lang/rust/dragonfly
# and pulls extra-<crate>-<version> into EXTRA_PATCHES for EVERY cargo port
# in the tree, so these must keep composing even though lang/rust itself
# never reads them. They pin crate versions, not rust versions, which is
# why they stay at the top of dragonfly/ and out of the per-target dirs.
# The folder installs them, so a new crate patch needs no op.

# =======================================================================
# Where the DragonFly bootstrap is fetched from, and its build environment.
# @2026Q4 repeats these in its own block below.
# =======================================================================
target @main

# Bootstrap tarballs are self-hosted (no cross-build port exists for
# DragonFly); avalon lays them out under <version>/ rather than the
# <compiler_date>/ FreeBSD uses, so BOOTSTRAPS_DATE carries the version.
mk add MASTER_SITES "https://avalon.dragonflybsd.org/misc/distfiles/rust-bootstrap/:bootstrap"

# ld.gold cannot link std into the rustc driver.
mk add MAKE_ENV "LDVER=ld.bfd"
# The stage0 rustc/cargo need their own shared libs plus the base compiler's
# libstdc++/libgcc (gcc80 on 6.4, gcc120 on 6.5: it must match what the rest
# of the build loads, or e.g. cmake fails on a missing GLIBCXX version).
mk add MAKE_ENV "LD_LIBRARY_PATH=${WRKDIR}/bootstrap/lib:/usr/lib/${DFLY_BASE_CCVER}"

# =======================================================================
# @main: Rust 1.100.0, bootstrapped with Avalon 1.99.0.
# =======================================================================
target @main
mk set PORTVERSION "1.100.0"
mk set PORTREVISION "0"
mk set BOOTSTRAPS_DATE "1.99.0"
mk set RUST_BOOTSTRAP_VERSION "1.99.0"
mk set LLVM_VERSION "23"
mk set _LLVM_VERSION "23"

# Use the same upstream source archive as the tested bootstrap.
text replace-once file Makefile from "${DISTNAME}${EXTRACT_SUFX}:src" to "${DISTNAME}.tar.gz:src"

# LLVM now derives the allocator alignment from the target ABI.
file remove files/patch-llvm_include_llvm_Support_Allocator.h
# First-lane propagation moved from VPlanRecipes to VPlanUtils.
file remove files/patch-llvm_lib_Transforms_Vectorize_VPlanRecipes.cpp
# This workaround is only for 32-bit FreeBSD.
file remove files/patch-vendor_openssl_crypto_threads__pthread.c

# 1.98.1 and later vendor enough crates that the glob exceeds ARG_MAX.
text replace-once file Makefile \
     from "@${REINPLACE_CMD} 's,\"files\":{[^}]*},\"files\":{},'" \
     to "@${FIND} ${CARGO_VENDOR_DIR} -name .cargo-checksum.json -exec ${REINPLACE_CMD} 's,\"files\":{[^}]*},\"files\":{},'"
text replace-once file Makefile \
     from "${CARGO_VENDOR_DIR}/*/.cargo-checksum.json" \
     to "{} +"

text replace-once file distinfo from "SHA256 (rust/rustc-1.99.1-src.tar.xz) = 6451598a99e77f07571960f6b21d577399d3a30f33e80cbd2e3a4aae6535d265" to "SHA256 (rust/rustc-1.100.0-src.tar.gz) = e8904548563117043c24a67c4967119b7c9ed304821988283e7681122ceec98b"
text replace-once file distinfo from "SIZE (rust/rustc-1.99.1-src.tar.xz) = 265270392" to "SIZE (rust/rustc-1.100.0-src.tar.gz) = 561848646"
text line-insert-after file distinfo anchor "SIZE (rust/rustc-1.100.0-src.tar.gz) = 561848646" line "SHA256 (rust/1.99.0/cargo-1.99.0-x86_64-unknown-dragonfly.tar.xz) = 1e8d4e4ef8d5cc8fe69d4be7cf94554935299ef9fddf84f82136c94e1c2ce280"
text line-insert-after file distinfo anchor "SHA256 (rust/1.99.0/cargo-1.99.0-x86_64-unknown-dragonfly.tar.xz) = 1e8d4e4ef8d5cc8fe69d4be7cf94554935299ef9fddf84f82136c94e1c2ce280" line "SIZE (rust/1.99.0/cargo-1.99.0-x86_64-unknown-dragonfly.tar.xz) = 11654236"
text line-insert-after file distinfo anchor "SIZE (rust/1.99.0/cargo-1.99.0-x86_64-unknown-dragonfly.tar.xz) = 11654236" line "SHA256 (rust/1.99.0/rust-std-1.99.0-x86_64-unknown-dragonfly.tar.xz) = da85b327e4c85e98cf08904e075d1a71514780a4498002449dfef44b48469cd6"
text line-insert-after file distinfo anchor "SHA256 (rust/1.99.0/rust-std-1.99.0-x86_64-unknown-dragonfly.tar.xz) = da85b327e4c85e98cf08904e075d1a71514780a4498002449dfef44b48469cd6" line "SIZE (rust/1.99.0/rust-std-1.99.0-x86_64-unknown-dragonfly.tar.xz) = 26040012"
text line-insert-after file distinfo anchor "SIZE (rust/1.99.0/rust-std-1.99.0-x86_64-unknown-dragonfly.tar.xz) = 26040012" line "SHA256 (rust/1.99.0/rustc-1.99.0-x86_64-unknown-dragonfly.tar.xz) = 82d85c615059ad124c9598fc0c8203459456fed28410bdc6bb833d2925ff617f"
text line-insert-after file distinfo anchor "SHA256 (rust/1.99.0/rustc-1.99.0-x86_64-unknown-dragonfly.tar.xz) = 82d85c615059ad124c9598fc0c8203459456fed28410bdc6bb833d2925ff617f" line "SIZE (rust/1.99.0/rustc-1.99.0-x86_64-unknown-dragonfly.tar.xz) = 67928828"

# =======================================================================
# @2026Q4: rust 1.98.1, bootstrap 1.97.1. FreeBSD's 2026Q4 lang/rust is
# main's of 2026-09-11, which @main built until da3bd93a65c; this is that
# block, with the bootstrap site and environment above copied in.
# =======================================================================
target @2026Q4

# Bootstrap tarballs are self-hosted (no cross-build port exists for
# DragonFly); avalon lays them out under <version>/ rather than the
# <compiler_date>/ FreeBSD uses, so BOOTSTRAPS_DATE carries the version.
mk add MASTER_SITES "https://avalon.dragonflybsd.org/misc/distfiles/rust-bootstrap/:bootstrap"

# ld.gold cannot link std into the rustc driver.
mk add MAKE_ENV "LDVER=ld.bfd"
# The stage0 rustc/cargo need their own shared libs plus the base compiler's
# libstdc++/libgcc (gcc80 on 6.4, gcc120 on 6.5: it must match what the rest
# of the build loads, or e.g. cmake fails on a missing GLIBCXX version).
mk add MAKE_ENV "LD_LIBRARY_PATH=${WRKDIR}/bootstrap/lib:/usr/lib/${DFLY_BASE_CCVER}"

# rustc 1.98.1 needs LLVM 22.
mk set LLVM_VERSION "22"
mk set _LLVM_VERSION "22"

mk set BOOTSTRAPS_DATE "1.97.1"

# 1.98.1 and later vendor enough crates that the glob exceeds ARG_MAX.
text replace-once file Makefile \
     from "@${REINPLACE_CMD} 's,\"files\":{[^}]*},\"files\":{},'" \
     to "@${FIND} ${CARGO_VENDOR_DIR} -name .cargo-checksum.json -exec ${REINPLACE_CMD} 's,\"files\":{[^}]*},\"files\":{},'"
text replace-once file Makefile \
     from "${CARGO_VENDOR_DIR}/*/.cargo-checksum.json" \
     to "{} +"

# Chained so each line anchors on the one inserted before it. The first
# anchors on the branch's own source SIZE line, so this fails loudly if
# the base moves rather than writing a wrong distinfo.
text line-insert-after file distinfo \
     anchor "SIZE (rust/rustc-1.98.1-src.tar.xz) = 244440824" \
     line "SHA256 (rust/1.97.1/rustc-1.97.1-x86_64-unknown-dragonfly.tar.xz) = 3ae8e16224118083cd089aa5318a00a0ca57f11d7a58aa4dd782a75394ad1db4"
text line-insert-after file distinfo \
     anchor "SHA256 (rust/1.97.1/rustc-1.97.1-x86_64-unknown-dragonfly.tar.xz) = 3ae8e16224118083cd089aa5318a00a0ca57f11d7a58aa4dd782a75394ad1db4" \
     line "SIZE (rust/1.97.1/rustc-1.97.1-x86_64-unknown-dragonfly.tar.xz) = 68662392"
text line-insert-after file distinfo \
     anchor "SIZE (rust/1.97.1/rustc-1.97.1-x86_64-unknown-dragonfly.tar.xz) = 68662392" \
     line "SHA256 (rust/1.97.1/rust-std-1.97.1-x86_64-unknown-dragonfly.tar.xz) = f11578b7ec1aa67dc1299cbdcb7c60d3a5dee528085bf322cbc37c6c7efca7bd"
text line-insert-after file distinfo \
     anchor "SHA256 (rust/1.97.1/rust-std-1.97.1-x86_64-unknown-dragonfly.tar.xz) = f11578b7ec1aa67dc1299cbdcb7c60d3a5dee528085bf322cbc37c6c7efca7bd" \
     line "SIZE (rust/1.97.1/rust-std-1.97.1-x86_64-unknown-dragonfly.tar.xz) = 24595676"
text line-insert-after file distinfo \
     anchor "SIZE (rust/1.97.1/rust-std-1.97.1-x86_64-unknown-dragonfly.tar.xz) = 24595676" \
     line "SHA256 (rust/1.97.1/cargo-1.97.1-x86_64-unknown-dragonfly.tar.xz) = eaa880eac5c00b16d64c41d92b0b02bd97be4ac95b6c1ecda5cdbee85af53562"
text line-insert-after file distinfo \
     anchor "SHA256 (rust/1.97.1/cargo-1.97.1-x86_64-unknown-dragonfly.tar.xz) = eaa880eac5c00b16d64c41d92b0b02bd97be4ac95b6c1ecda5cdbee85af53562" \
     line "SIZE (rust/1.97.1/cargo-1.97.1-x86_64-unknown-dragonfly.tar.xz) = 11460860"

# This line's own patches are in dragonfly/@2026Q4/, cut against the 1.98.1
# source.

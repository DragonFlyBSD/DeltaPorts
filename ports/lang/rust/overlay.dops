port lang/rust
type port
reason "DragonFly: allow OPSYS, add the avalon bootstrap, and carry the dragonfly patch lane plus the shared cargo crate patches"

# Each base builds the rust its own branch ships. The DragonFly source
# patches track the rust version, so they cannot be shared between
# targets: none of the fourteen patches common to both sets is identical
# across 1.96.1 and 1.98.1. Nothing here rewrites PORTVERSION.

# =======================================================================
# Independent of the rust version.
# =======================================================================
target @any

# --- diffs/Makefile.diff equivalent -------------------------------------
mk replace-if from "${OPSYS} != FreeBSD" \
              to "${OPSYS} != FreeBSD && ${OPSYS} != DragonFly"

# --- dragonfly/ lane: tree-wide cargo crate patches ---------------------
# Mk/Uses/cargo-extra.mk sets CARGO_EXTRA_PATCHDIR=${PORTSDIR}/lang/rust/dragonfly
# and pulls extra-<crate>-<version> into EXTRA_PATCHES for EVERY cargo port
# in the tree, so these must keep composing even though lang/rust itself
# never reads them. They pin crate versions, not rust versions, which is
# why they stay at the top of dragonfly/ and out of the per-target dirs.
# The folder installs them, so a new crate patch needs no op.

# =======================================================================
# Wherever a DragonFly bootstrap is fetched. Same site and same build
# environment for either version; only the version differs, below.
# =======================================================================
target @2026Q3,@main

# Bootstrap tarballs are self-hosted (no cross-build port exists for
# DragonFly); avalon lays them out under <version>/ rather than the
# <compiler_date>/ FreeBSD uses, so BOOTSTRAPS_DATE carries the version.
mk add MASTER_SITES "https://avalon.dragonflybsd.org/misc/distfiles/rust-bootstrap/:bootstrap"

# ld.gold cannot link std into the rustc driver.
mk add MAKE_ENV "LDVER=ld.bfd"
# The stage0 rustc/cargo need their own shared libs plus base libgcc.
mk add MAKE_ENV "LD_LIBRARY_PATH=${WRKDIR}/bootstrap/lib:/usr/lib/gcc80"

# =======================================================================
# @2026Q3: rust 1.96.1, bootstrap 1.95.0.
# =======================================================================
target @2026Q3

mk set BOOTSTRAPS_DATE "1.95.0"

# Chained so each line anchors on the one inserted before it. The first
# anchors on the branch's own source SIZE line, so this fails loudly if
# the base moves off 1.96.1 rather than writing a wrong distinfo.
text line-insert-after file distinfo \
     anchor "SIZE (rust/rustc-1.96.1-src.tar.xz) = 241602032" \
     line "SHA256 (rust/1.95.0/rustc-1.95.0-x86_64-unknown-dragonfly.tar.xz) = 03693380bf72e839ff5d7c2b0e9626c48baebca08667bef197a5c9ac1adf3595"
text line-insert-after file distinfo \
     anchor "SHA256 (rust/1.95.0/rustc-1.95.0-x86_64-unknown-dragonfly.tar.xz) = 03693380bf72e839ff5d7c2b0e9626c48baebca08667bef197a5c9ac1adf3595" \
     line "SIZE (rust/1.95.0/rustc-1.95.0-x86_64-unknown-dragonfly.tar.xz) = 67955352"
text line-insert-after file distinfo \
     anchor "SIZE (rust/1.95.0/rustc-1.95.0-x86_64-unknown-dragonfly.tar.xz) = 67955352" \
     line "SHA256 (rust/1.95.0/rust-std-1.95.0-x86_64-unknown-dragonfly.tar.xz) = 98d3e167dff45e14bf34529dee6bab0d551b1a6045299e029d164786bc1a3ea8"
text line-insert-after file distinfo \
     anchor "SHA256 (rust/1.95.0/rust-std-1.95.0-x86_64-unknown-dragonfly.tar.xz) = 98d3e167dff45e14bf34529dee6bab0d551b1a6045299e029d164786bc1a3ea8" \
     line "SIZE (rust/1.95.0/rust-std-1.95.0-x86_64-unknown-dragonfly.tar.xz) = 24177544"
text line-insert-after file distinfo \
     anchor "SIZE (rust/1.95.0/rust-std-1.95.0-x86_64-unknown-dragonfly.tar.xz) = 24177544" \
     line "SHA256 (rust/1.95.0/cargo-1.95.0-x86_64-unknown-dragonfly.tar.xz) = 96f567a18864c3bcb577984409134edce661c625a99dcd186e3388da8e6b4faa"
text line-insert-after file distinfo \
     anchor "SHA256 (rust/1.95.0/cargo-1.95.0-x86_64-unknown-dragonfly.tar.xz) = 96f567a18864c3bcb577984409134edce661c625a99dcd186e3388da8e6b4faa" \
     line "SIZE (rust/1.95.0/cargo-1.95.0-x86_64-unknown-dragonfly.tar.xz) = 11309856"

# do-patch applies every dragonfly/patch-* via DFLY_PATCHDIR. This line's
# own are in dragonfly/@2026Q3/, cut against the 1.96.1 source; the folder
# installs them under the flat name.

# =======================================================================
# @main: rust 1.99.0, bootstrap 1.98.1.
# =======================================================================
target @main

# rustc 1.98.1 needs LLVM 22. @2026Q3 keeps the 20/21 its own port pins.
mk set LLVM_VERSION "22"
mk set _LLVM_VERSION "22"

mk set BOOTSTRAPS_DATE "1.98.1"

# 1.98.1 and later vendor enough crates that the glob exceeds ARG_MAX.
text replace-once file Makefile \
     from "@${REINPLACE_CMD} 's,\"files\":{[^}]*},\"files\":{},'" \
     to "@${FIND} ${CARGO_VENDOR_DIR} -name .cargo-checksum.json -exec ${REINPLACE_CMD} 's,\"files\":{[^}]*},\"files\":{},'"
text replace-once file Makefile \
     from "${CARGO_VENDOR_DIR}/*/.cargo-checksum.json" \
     to "{} +"

# Same chain as @2026Q3, against this branch's own source SIZE line.
text line-insert-after file distinfo \
     anchor "SIZE (rust/rustc-1.99.0-src.tar.xz) = 265258564" \
     line "SHA256 (rust/1.98.1/rustc-1.98.1-x86_64-unknown-dragonfly.tar.xz) = a1c6681de742ac9736d8b99e7c52033643eba64eb95c98b9527983dbc53b7ab1"
text line-insert-after file distinfo \
     anchor "SHA256 (rust/1.98.1/rustc-1.98.1-x86_64-unknown-dragonfly.tar.xz) = a1c6681de742ac9736d8b99e7c52033643eba64eb95c98b9527983dbc53b7ab1" \
     line "SIZE (rust/1.98.1/rustc-1.98.1-x86_64-unknown-dragonfly.tar.xz) = 67429280"
text line-insert-after file distinfo \
     anchor "SIZE (rust/1.98.1/rustc-1.98.1-x86_64-unknown-dragonfly.tar.xz) = 67429280" \
     line "SHA256 (rust/1.98.1/rust-std-1.98.1-x86_64-unknown-dragonfly.tar.xz) = c73df8d1c7f82984888251d7cca5eca1d18e6f5521bad67414cd53756134786a"
text line-insert-after file distinfo \
     anchor "SHA256 (rust/1.98.1/rust-std-1.98.1-x86_64-unknown-dragonfly.tar.xz) = c73df8d1c7f82984888251d7cca5eca1d18e6f5521bad67414cd53756134786a" \
     line "SIZE (rust/1.98.1/rust-std-1.98.1-x86_64-unknown-dragonfly.tar.xz) = 25129860"
text line-insert-after file distinfo \
     anchor "SIZE (rust/1.98.1/rust-std-1.98.1-x86_64-unknown-dragonfly.tar.xz) = 25129860" \
     line "SHA256 (rust/1.98.1/cargo-1.98.1-x86_64-unknown-dragonfly.tar.xz) = 6acb8356e784a389a48ec6a3f560168c05da996f8a5a6528146397b3d0f004ba"
text line-insert-after file distinfo \
     anchor "SHA256 (rust/1.98.1/cargo-1.98.1-x86_64-unknown-dragonfly.tar.xz) = 6acb8356e784a389a48ec6a3f560168c05da996f8a5a6528146397b3d0f004ba" \
     line "SIZE (rust/1.98.1/cargo-1.98.1-x86_64-unknown-dragonfly.tar.xz) = 11510100"

# This line's own patches are in dragonfly/@main/, cut against the 1.99.0
# source.

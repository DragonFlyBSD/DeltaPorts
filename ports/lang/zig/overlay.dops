port lang/zig
type port
reason "DragonFly: drop -lmd from STATIC_LDFLAGS, add -llzma; build with clang21 and libc++ like the devel/llvm21 it links, and have build.zig link that libc++ (dragonfly/@<line> patch)"
target @any

mk eval STATIC_LDFLAGS "${STATIC_LDFLAGS:N-lmd} -llzma"
mk target set dfly-patch <<'MK1'
	${MKDIR} ${BUILD_WRKSRC}
		${TOUCH} ${BUILD_WRKSRC}/build.ninja
	${REINPLACE_CMD} -e 's@LLVM_SYSTEM_LIBS_SPACES}"@LLVM_SYSTEM_LIBS_SPACES} -llzma"@g' \
		${WRKSRC}/cmake/Findllvm.cmake

MK1

# devel/llvm21 is built against libc++ on DragonFly, and zig's C++ glue
# calls LLVM's C++ API, so built with base gcc and libstdc++ zig2 fails to
# link: undefined llvm:: symbols with std::__cxx11 types.
target @2026Q4,@main
mk add USES "dfly-libcxx:21"

port lang/quickjs
type port
reason "auto-converted from compat (Makefile.DragonFly + dragonfly/)"
target @any

mk target set dfly-patch <<'MK1'
	${REINPLACE_CMD} -e 's@\(HOST_CC=\).*@\1gcc@g' -e 's@\([[:<:]]CC=\).*@\1gcc@g' \
		${WRKSRC}/Makefile
MK1

# dragonfly/patch-qjs.c, patch-quickjs.c: report malloc usable size as 0,
# as for __EMSCRIPTEN__, instead of calling malloc_usable_size().

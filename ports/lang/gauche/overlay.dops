port lang/gauche
type port
reason "2026Q1/Q2 only: axTLS endian patch and LibreSSL test tweaks"

# 0.9.15 dropped the bundled axTLS (TLS is mbedTLS now) and
# ext/tls/ssltest-mod.scm, so the patch in dragonfly/@2026Q1 and @2026Q2
# and the ops below have nothing to apply to from 2026Q3 on.
target @2026Q1,@2026Q2

mk add USES "ssl"
mk set BINARY_ALIAS "openssl=${LOCALBASE}/bin/openssl"
mk target set dfly-patch <<'MK1'
	${REINPLACE_CMD} -e '/rxmatch/s@OpenSSL@\\w+SSL@' \
		${WRKSRC}/ext/tls/ssltest-mod.scm
MK1

port lang/gcc6-aux
type port
reason "DragonFly: restore the DragonFly Ada bootstrap compiler upstream dropped"
target @any

# Upstream only sets BOOTSTRAP_COMPILER for FreeBSD now; on DragonFly it
# falls back to gnat-bootstrap.x86_64.dragonfly.tar.bz2, which exists
# nowhere and is not in distinfo, so fetch fails. Put back the DragonFly
# bootstrap the port last built with (GNAT 5.1, static, from avalon).
mk add MASTER_SITES "https://avalon.dragonflybsd.org/misc/distfiles/:boot"
mk eval BOOTSTRAP_COMPILER "ada-bootstrap.x86_64.dragonfly.41.tar.bz2"

# Anchored on the gcc source SIZE: if upstream moves off 6.5.0 compose
# fails here, and the bootstrap has to be revisited with it.
text line-insert-after file distinfo \
     anchor "SIZE (gcc-6.5.0.tar.xz) = 74355588" \
     line   "SHA256 (ada-bootstrap.x86_64.dragonfly.41.tar.bz2) = eb7785d8b842aee2bb04b43adfb1346b178ee4e83d8775b4e6705fd23f1586f0"
text line-insert-after file distinfo \
     anchor "SHA256 (ada-bootstrap.x86_64.dragonfly.41.tar.bz2) = eb7785d8b842aee2bb04b43adfb1346b178ee4e83d8775b4e6705fd23f1586f0" \
     line   "SIZE (ada-bootstrap.x86_64.dragonfly.41.tar.bz2) = 44956630"

port lang/go127
type port
reason "DragonFly: GOARCH for ARCH=x86_64, the dragonfly bootstrap distfile, interface message layout"
target @any

# bsd.go.mk keys GOARCH off ${ARCH}; DragonFly reports x86_64, which it
# does not map, so the bootstrap distfile came out as
# go1.25.14.dragonfly-.tar.gz. Every use is lazily expanded.
mk set GOARCH_x86_64 "amd64" on-missing noop

# Same go1.25.14 bootstrap tarball as lang/go126, built with
# src/bootstrap.bash (GOOS=dragonfly GOARCH=amd64) and recompressed to
# .tar.gz. Served by avalon via MASTER_SITE_BACKUP.
text line-insert-after file distinfo \
     anchor "SIZE (go1.25.14.freebsd-riscv64.tar.gz) = 58188033" \
     line   "SHA256 (go1.25.14.dragonfly-amd64.tar.gz) = 5c8a33b21b05998a7cb05d1aafbbcadc31bd5e64527da11056a363001d997d41"

text line-insert-after file distinfo \
     anchor "SHA256 (go1.25.14.dragonfly-amd64.tar.gz) = 5c8a33b21b05998a7cb05d1aafbbcadc31bd5e64527da11056a363001d997d41" \
     line   "SIZE (go1.25.14.dragonfly-amd64.tar.gz) = 60336476"

# dragonfly/: DragonFly puts the index before flags and addrs in
# if_msghdr/ifa_msghdr, so net.Interfaces() found none (golang/go#81503).
mk set PORTREVISION "1"

port lang/python312
type port
reason "DragonFly: OPTIONS_EXCLUDE LTO, plist sysconfigdata/module adjustments"
target @any

# Use bundled expat instead of the system library.
mk remove LIB_DEPENDS "libexpat.so:textproc/expat2"
text replace-once file Makefile from "--enable-shared --without-ensurepip --with-system-expat" to "--enable-shared --without-ensurepip"
# DragonFly uses base libcrypt and lacks llvm-ar for thin LTO.
mk add CONFIGURE_ENV "LIBCRYPT_LIBS=-lcrypt"
mk remove OPTIONS_DEFAULT "LTO"
text replace-once file pkg-plist from "%%PYTHON_LIBDIR%%/_sysconfigdata_%%ABI%%_freebsd%%OSMAJOR%%_.py" to "%%PYTHON_LIBDIR%%/__pycache__/_sysconfigdata__%%PYTHON_PLATFORM%%_%%PYTHON_TAG%%.opt-1.pyc\n%%PYTHON_LIBDIR%%/__pycache__/_sysconfigdata__%%PYTHON_PLATFORM%%_%%PYTHON_TAG%%.opt-2.pyc\n%%PYTHON_LIBDIR%%/__pycache__/_sysconfigdata__%%PYTHON_PLATFORM%%_%%PYTHON_TAG%%.pyc\n%%PYTHON_LIBDIR%%/_sysconfigdata__%%PYTHON_PLATFORM%%_.py"
text line-remove file pkg-plist exact "%%PYTHON_LIBDIR%%/__pycache__/_sysconfigdata_%%ABI%%_freebsd%%OSMAJOR%%_%%PYTHON_TAG%%.opt-1.pyc"
text line-remove file pkg-plist exact "%%PYTHON_LIBDIR%%/__pycache__/_sysconfigdata_%%ABI%%_freebsd%%OSMAJOR%%_%%PYTHON_TAG%%.opt-2.pyc"
text line-remove file pkg-plist exact "%%PYTHON_LIBDIR%%/__pycache__/_sysconfigdata_%%ABI%%_freebsd%%OSMAJOR%%_%%PYTHON_TAG%%.pyc"
file materialize dragonfly/patch-configure.ac -> dragonfly/patch-configure.ac
# Replaced by the carried, version-adjusted patch in the DragonFly lane.
file remove files/patch-configure
file materialize dragonfly/patch-configure -> dragonfly/patch-configure

port x11-fonts/py-compreffor
type port
reason "DragonFly: regenerate the Cython module; the shipped .cpp predates Python 3.12"

# src/cython/_compreffor.cpp was generated by Cython 0.29.32 and reads
# PyLongObject's ob_digit, which Python 3.12 removed. setup.py cythonizes
# the .pyx instead when Cython is installed. FreeBSD's build is hit too.
target @2026Q4,@main

mk add BUILD_DEPENDS "${PYTHON_PKGNAMEPREFIX}cython>=0.29.30:lang/cython@${PY_FLAVOR}"

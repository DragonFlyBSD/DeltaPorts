port x11-fonts/uw-ttyp0
type port
reason "no FreeBSD vt console fonts: they need vtfontcvt"
target @any

text replace-once file Makefile \
     from " GEN_CONS_FREEBSD_VT=1" \
     to   ""
text line-remove file pkg-plist exact "share/vt/fonts/ttyp0-11.fnt"
text line-remove file pkg-plist exact "share/vt/fonts/ttyp0-12.fnt"
text line-remove file pkg-plist exact "share/vt/fonts/ttyp0-13.fnt"
text line-remove file pkg-plist exact "share/vt/fonts/ttyp0-14.fnt"
text line-remove file pkg-plist exact "share/vt/fonts/ttyp0-15.fnt"
text line-remove file pkg-plist exact "share/vt/fonts/ttyp0-16.fnt"
text line-remove file pkg-plist exact "share/vt/fonts/ttyp0-17.fnt"
text line-remove file pkg-plist exact "share/vt/fonts/ttyp0-18.fnt"
text line-remove file pkg-plist exact "share/vt/fonts/ttyp0-22.fnt"
text line-remove file pkg-plist exact "share/vt/fonts/ttyp0-30.fnt"
text line-remove file pkg-plist exact "share/vt/fonts/ttyp0-40.fnt"
text line-remove file pkg-plist exact "share/vt/fonts/ttyp0-60.fnt"
text line-remove file pkg-plist exact "share/vt/fonts/ttyp0-80.fnt"

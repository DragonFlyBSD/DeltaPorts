port accessibility/hyprsunset
type port
reason "hyprutils' headers need C++23 <format>, use GCC 14 as hyprutils does; timerfd from devel/libepoll-shim"
target @any
mk set USE_GCC_VERSION "14"

# Hyprsunset.cpp includes <sys/timerfd.h>, which DragonFly lacks.
mk add LIB_DEPENDS "libepoll-shim.so:devel/libepoll-shim"
mk block set condition "1" <<'MK'
CXXFLAGS+=	-I${LOCALBASE}/include/libepoll-shim
LDFLAGS+=	-L${LOCALBASE}/lib -lepoll-shim
MK

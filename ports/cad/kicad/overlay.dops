port cad/kicad
type port
reason "libcontext and other __FreeBSD__ checks; major()/minor() macros vs the API protobuf"
target @any

mk set USE_GCC_VERSION "${GCC_DEFAULT}"
mk add USES "localbase:ldflags"
mk add CXXFLAGS "-Wno-deprecated-declarations -fext-numeric-literals"
# gcc's <unwind.h> declares _Unwind_Backtrace without _GNU_SOURCE.
mk add CXXFLAGS "-DBOOST_STACKTRACE_GNU_SOURCE_NOT_REQUIRED"
mk target set dfly-patch <<'MK1'
	${REINPLACE_CMD} -e 's|__FreeBSD__|__DragonFly__|' \
		${WRKSRC}/thirdparty/libcontext/libcontext.h
	cd ${WRKSRC} && ${GREP} -rlF --include='*.h' --include='*.cpp' \
		'#if defined(__linux__) || defined(__FreeBSD__)' . | \
		${XARGS} ${REINPLACE_CMD} -e 's/^#if defined(__linux__) || defined(__FreeBSD__)$$/& || defined(__DragonFly__)/'
	# No ENODATA here; FreeBSD gets libc++'s value.
	${REINPLACE_CMD} -e 's|= ENODATA,|= 9919,|' \
		${WRKSRC}/thirdparty/3dxware_sdk/inc/navlib/navlib_types.h
MK1

# DragonFly's <sys/types.h> defines major() and minor() as macros, which
# mangle the accessors protoc generates for the API's version message.
target @2026Q4,@main

mk target set post-patch <<'MK'
	@${PRINTF} '#include <sys/types.h>\n#undef major\n#undef minor\n' > ${WRKDIR}/dfly-no-major-minor.h
MK
text line-insert-after file Makefile \
     anchor "CXXFLAGS_powerpc=\t-O0" \
     line   "CXXFLAGS+=\t-include ${WRKDIR}/dfly-no-major-minor.h"

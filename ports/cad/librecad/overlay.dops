port cad/librecad
type port
reason "remove untranslated .qm locale files from plist; dragonfly upstream patches"

# DragonFly does not build LibreCAD's translations (bc2e06de3f9, 2018:
# "block translations (qmake segfaults?)"). The source patch below cuts
# the lrelease run and the .qm copy loops out of
# scripts/postprocess-unix.sh, so nothing lands in ${DATADIR}/qm and
# every qm entry has to leave the plist with it.
#
# One line-remove per entry rather than a context diff: these do not
# drift when neighbouring plist lines change, and a catalog upstream
# drops or renames fails compose naming the line. A catalog upstream
# adds is not caught here: it would stay listed with no file staged.
target @any

text line-remove file pkg-plist exact "%%DATADIR%%/qm/librecad_ar.qm"
text line-remove file pkg-plist exact "%%DATADIR%%/qm/librecad_ca.qm"
text line-remove file pkg-plist exact "%%DATADIR%%/qm/librecad_cs.qm"
text line-remove file pkg-plist exact "%%DATADIR%%/qm/librecad_da.qm"
text line-remove file pkg-plist exact "%%DATADIR%%/qm/librecad_de.qm"
text line-remove file pkg-plist exact "%%DATADIR%%/qm/librecad_el.qm"
text line-remove file pkg-plist exact "%%DATADIR%%/qm/librecad_en.qm"
text line-remove file pkg-plist exact "%%DATADIR%%/qm/librecad_en_au.qm"
text line-remove file pkg-plist exact "%%DATADIR%%/qm/librecad_es.qm"
text line-remove file pkg-plist exact "%%DATADIR%%/qm/librecad_es_ar.qm"
text line-remove file pkg-plist exact "%%DATADIR%%/qm/librecad_es_bo.qm"
text line-remove file pkg-plist exact "%%DATADIR%%/qm/librecad_es_cl.qm"
text line-remove file pkg-plist exact "%%DATADIR%%/qm/librecad_es_co.qm"
text line-remove file pkg-plist exact "%%DATADIR%%/qm/librecad_es_cr.qm"

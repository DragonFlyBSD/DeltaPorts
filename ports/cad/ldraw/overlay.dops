port cad/ldraw
type port
reason "install the models/ directory that upstream's do-install leaves out"
target @any

# Upstream stopped installing ldraw/models/ in the 20181208 update
# (45b2d115f454); DragonFly put it back (7ba49c733a1) for cad/brickutils,
# whose RUN_DEPENDS was share/ldraw/models/car.dat.
#
# complete.zip unpacks to ${WRKDIR}/ldraw (20260831 sets WRKSRC there),
# and DATADIR is ${PREFIX}/share/ldraw. Append a line to do-install's
# COPYTREE_SHARE recipe rather than edit it.
mk target append do-install <<'MK'
	cd ${WRKDIR}/ldraw && ${COPYTREE_SHARE} models ${STAGEDIR}${DATADIR}
MK

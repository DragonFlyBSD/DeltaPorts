port cad/yosys
type port
reason "auto-converted from compat (Makefile.DragonFly + dragonfly/)"
target @any

mk add USES "localbase:ldflags"

# dragonfly/: take the FreeBSD branches in kernel/driver.cc, kernel/yosys.cc
# and libs/minisat/System.cc.

# 0.69 needs C++20 (<version>, a __cplusplus check in yosys_common.h).
# compiler:c++20-lang resolves to base gcc 8.3 on DragonFly; build with the
# default ports GCC instead.
target @2026Q4,@main

mk set USE_GCC_VERSION "${GCC_DEFAULT}"

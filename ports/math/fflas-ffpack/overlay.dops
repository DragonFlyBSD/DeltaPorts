port math/fflas-ffpack
type port
reason "auto-converted from Makefile.DragonFly"
target @any

mk add CONFIGURE_ARGS "--with-blas-libs=\"-L${LOCALBASE}/lib -lopenblas\""

# The only CONFIGURE_ARGS assignment in the Makefile now sits inside the
# DOXYGEN option block, so the "mk add" above lands there and
# --with-blas-libs is only passed with DOXYGEN on; by default configure
# stops with "BLAS not found". Add it unconditionally instead.
target @2026Q3,@2026Q4,@main

text line-insert-after file Makefile anchor ".include <bsd.port.options.mk>" line "CONFIGURE_ARGS+=	--with-blas-libs=\"-L${LOCALBASE}/lib -lopenblas\""

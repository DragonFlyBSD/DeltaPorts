port math/lib2geom
type port
reason "DragonFly: 1.4 is C++20 (concepts); build with GCC_DEFAULT"

# USES=compiler:c++20-lang resolves to base gcc 8.3 on DragonFly, which
# knows no concept/requires (src/2geom/planar-graph.h). 1.4 is on every
# line, so this applies to all of them.
target @any

mk set USE_GCC_VERSION "${GCC_DEFAULT}"

# The Makefile builds the test suite on every build (CMAKE_ON 2GEOM_TESTING).
# devel/googletest is built with gcc 13 on DragonFly (see its overlay), so
# libgtest_main needs GLIBCXX_3.4.32 (std::ios_base_library_init), which
# GCC_DEFAULT's (12) libstdc++ does not have, and the test programs fail to
# link. The option defaults to ON for a standalone build, so turn it off
# explicitly and build the tests only for "make test" (CMAKE_TESTING_ON).
target @2026Q4,@main

mk eval CMAKE_ON "${CMAKE_ON:N2GEOM_TESTING}"
mk add CMAKE_OFF "2GEOM_TESTING"
mk set CMAKE_TESTING_ON "2GEOM_TESTING"

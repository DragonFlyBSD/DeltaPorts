port math/cvc5
type port
reason "DragonFly: cvc5 requires GCC 10 or later"

# CMakeLists.txt calls check_min_compiler_version("GNU" 10); base gcc 8.3
# (what compiler:c++17-lang gives) is rejected at configure.
target @2026Q4,@main

mk set USE_GCC_VERSION "${GCC_DEFAULT}"

# SymFPU's headers use NULL without including <cstddef>; libc++ provides it
# indirectly, but DragonFly's libstdc++ does not, so cvc5's SymFPU probe fails
# ("incompatible version") and so would its own users of the headers. The
# proper fix belongs in math/symfpu; until then pre-include <cstddef>.
mk add CXXFLAGS_x86_64 "-include cstddef"

port math/py-blis
type port
reason "Step 48 bootstrap: deterministic header; patch authors the body"
target @any

# setup.py maps DragonFly to the linux config path and its compiler-flag
# probe on this toolchain selects arch x86_64_no_zen2, for which the 1.3.3
# sdist ships no blis/_src/make jsonl (only generic/x86_64/no_skx exist).
# BLIS_ARCH is honoured first by get_arch_name(), so force a shipped config.
mk add MAKE_ENV "BLIS_ARCH=generic"

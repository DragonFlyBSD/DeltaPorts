port math/pdal
type port
reason "auto-converted from Makefile.DragonFly"

# GDAL 3.12+: gdal_multidim.h declares
# "std::unique_ptr<GDALRasterAttributeTable> m_poRAT{};" with the class
# incomplete. gcc 8 instantiates the deleter for that initializer and
# fails in io/OGRWriter.cpp; gcc 12 does not, and has std::filesystem
# in libstdc++ itself.
target @2026Q4,@main

mk set USE_GCC_VERSION "${GCC_DEFAULT}"

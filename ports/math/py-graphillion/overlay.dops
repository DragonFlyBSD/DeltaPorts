port math/py-graphillion
type port
reason "auto-converted from Makefile.DragonFly; gnu++98 only up to 1.x"

# 1.x needed -std=gnu++98. 2.1 (Q4, main) uses C++11 (std::to_string, >>
# closing nested templates), which gnu++98 rejects; base gcc 8.3's default
# gnu++14 is what it wants (setup.py asks for -std=c++11 on macOS).
target @2026Q1,@2026Q2,@2026Q3

mk add CFLAGS "-std=gnu++98"

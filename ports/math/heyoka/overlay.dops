port math/heyoka
type port
reason "DragonFly: needs C++20/23 stdlib and language support from gcc 14"

# The old compat forced clang++12, which finds only base gcc 8's
# libstdc++: no C++20 headers (<concepts>, <ranges>,
# <source_location>). Build with ports GCC instead; its libstdc++
# is new and forward-compatible with the gcc 12-built dependencies
# (boost, fmt, ...). heyoka 7 also uses explicit object parameters
# ("this auto &&self", callable.hpp), which gcc supports from 14.
target @2026Q4,@main

mk set USE_GCC_VERSION "14"

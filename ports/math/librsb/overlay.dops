port math/librsb
type port
reason "auto-converted from Makefile.DragonFly"
target @any

mk target set dfly-patch <<'MK1'
	${REINPLACE_CMD} s/enable_optimize=no/enable_optimize=yes/ \
		${WRKSRC}/configure
MK1

# LDFLAGS+= -lthr: DragonFly has no libthr (its threads library is
# libpthread), so configure's first link test already fails ("C compiler
# cannot create executables").
target @2026Q4,@main

text replace-once file Makefile from "LDFLAGS+=\t-lthr" to "LDFLAGS+=\t-lpthread"

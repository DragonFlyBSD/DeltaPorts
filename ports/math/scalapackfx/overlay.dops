port math/scalapackfx
type port
reason "DragonFly: add -L${LOCALBASE}/lib for the Makefile's -lscalapack"

# The Makefile puts -lscalapack in LDFLAGS without a -L, and DragonFly's
# linker does not search ${LOCALBASE}/lib, so CMake's Fortran compiler
# check already fails ("cannot find -lscalapack").
target @2026Q4,@main

mk add USES "localbase:ldflags"

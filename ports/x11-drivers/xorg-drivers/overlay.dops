port x11-drivers/xorg-drivers
type port
reason "drop the libinput input driver; default-enable ati and intel on x86_64"
target @any

# libinput has been left out of the DragonFly driver set since 2017
# (DeltaPorts 64371942f04). Taking it out of INPUT_DRIVERS drops LIBINPUT
# from OPTIONS_DEFINE and xf86-input-libinput from RUN_DEPENDS, as both are
# generated by loops over that list. A text op, not mk remove:
# INPUT_DRIVERS is assigned twice (INPUT_DRIVERS+= vmmouse under the x86
# .if is the second), and mk remove refuses an ambiguous variable.
text line-remove file Makefile exact "\t\t\tlibinput \\"

# DragonFly installs the ati and intel video drivers by default, not only
# vesa. The amd64 -> x86_64 rename of this variable, of OPTIONS_DEFINE_amd64
# and of the ${ARCH}==amd64 test is done for every port by compose's system
# replacements (dportsv3/system_replacements.py), which run after these ops.
mk add OPTIONS_DEFAULT_amd64 ATI
mk add OPTIONS_DEFAULT_amd64 INTEL

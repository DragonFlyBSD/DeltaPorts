port mail/archiveopteryx
type port
reason "auto-converted from compat (Makefile.DragonFly + dragonfly/)"
target @any

mk target set dfly-patch <<'MK1'
	${REINPLACE_CMD} -e 's@CLANG@CLANG_NOT@g'	\
		${WRKSRC}/Jamrules
	${REINPLACE_CMD} -e 's@-Werror@@g'		\
		${WRKSRC}/Jamsettings ${WRKSRC}/Makefile
MK1

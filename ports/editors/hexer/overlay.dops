port editors/hexer
type port
reason "port ncurses: its include and library paths"
target @any

# FreeBSD's only USES line sits under .if ${OPSYS} == FreeBSD.
mk block set condition "1" <<'MK'
USES+=	ncurses
MK
mk add CFLAGS "-I${NCURSESINC}"
mk add LDFLAGS "-L${NCURSESLIB}"
mk target set dfly-patch <<'MK1'
	${REINPLACE_CMD} -e 's@-lcurses@-lncurses@'	\
		${WRKSRC}/Makefile
MK1

port editors/mg
type port
reason "auto-converted from Makefile.DragonFly"
target @any

mk add CFLAGS "-DSLIST_FOREACH_SAFE=SLIST_FOREACH_MUTABLE"
mk set DFLY_UNMAINTAINED "yes"

# DragonFly's <sys/queue.h> spells TAILQ_FOREACH_SAFE as
# TAILQ_FOREACH_MUTABLE, and there is no MAXNAMLEN (NAME_MAX is 255).
target @2026Q3,@2026Q4,@main
mk add CFLAGS "-DTAILQ_FOREACH_SAFE=TAILQ_FOREACH_MUTABLE -DMAXNAMLEN=255"

port editors/croft
type port
reason "DragonFly: take main's distinfo for the regenerated codeberg archive"

# codeberg regenerated the archive and every mirror serves the new one;
# freebsd-ports main re-rolled distinfo for it.
target @2026Q4
text replace-once file distinfo from "TIMESTAMP = 1780447017" to "TIMESTAMP = 1791703978"
text replace-once file distinfo from "SHA256 (croft-0.1.271.20260602.tar.gz) = 0665e4550afe49656bdebbf51c30d2b1086d72e2b584b294b29f4c86a4cbd4ff" to "SHA256 (croft-0.1.271.20260602.tar.gz) = 58a08a0864626c9a0ba84a6dee8816afb2d1557f7fa5872693e645524d9a3017"
text replace-once file distinfo from "SIZE (croft-0.1.271.20260602.tar.gz) = 4037021" to "SIZE (croft-0.1.271.20260602.tar.gz) = 4036770"

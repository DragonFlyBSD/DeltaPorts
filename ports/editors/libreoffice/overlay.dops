port editors/libreoffice
type port
reason "USE_GCC=13; filter elfctl; disable JAVA/Firebird; CONFIGURE_ARGS; dfly-patch with .for loops; dragonfly patches"
target @any

mk set USE_GCC_VERSION "13"

mk eval USES "${USES:Nelfctl}"

mk eval OPTIONS_DEFAULT "${OPTIONS_DEFAULT:NJAVA}"

mk add CONFIGURE_ARGS "--disable-firebird-sdbc"

mk add CONFIGURE_ARGS "--with-os-version=${DFLYVERSION}"
mk add CONFIGURE_ARGS "--with-vendor=\"DragonFly dports\""

patch apply diffs/Makefile.diff

file remove files/patch-bridges_source_cpp__uno_gcc3__linux__x86-64_except.cxx on-missing noop

mk target set dfly-patch <<'MK'
	${CP} -v ${DFLY_FILESDIR}/pdfium-build__config.patch ${WRKSRC}/external/pdfium
	${REINPLACE_CMD} -e 's,pdfium_patches += pdfium-bsd.patch,& pdfium-build__config.patch ,g' \
		${WRKSRC}/external/pdfium/UnpackedTarball_pdfium.mk
	${REINPLACE_CMD} -e 's|$$ENV{TMPDIR};|"${WRKDIR}";|' \
		${WRKSRC}/solenv/bin/ooinstall
	(cd ${WRKSRC} && ${REINPLACE_CMD} -e 's|FREEBSD|DRAGONFLY|' \
		${REPLACE_LIST})
.for F in ${REPLACE_LIST}
	@/usr/bin/cmp -s ${WRKSRC:Q}/${F} ${WRKSRC:Q}/${F}.bak && \
		echo "${F} was not altered" || /usr/bin/true
.endfor
	(cd ${WRKSRC} && \
		${REINPLACE_CMD} -e 's|%BSD|DRAGONFLY|' ${PERCENT_BSD_LIST})
.for F in ${PERCENT_BSD_LIST}
	@/usr/bin/cmp -s ${WRKSRC:Q}/${F} ${WRKSRC:Q}/${F}.bak && \
		echo "${F} was not altered" || /usr/bin/true
.endfor
MK

# 26.8 (2026Q4 on): the dragonfly/@<line> patches are re-cut for the new
# sources, and pdfium-build__config.patch for pdfium-7681. pdfium's BSD
# patch is now upstream's external/pdfium/freebsd.patch rather than the
# pdfium-bsd.patch FreeBSD used to add, so hook our build_config patch in
# after it and run the FREEBSD -> DRAGONFLY rename over it. REPLACE_LIST
# and PERCENT_BSD_LIST came from Makefile.DragonFly and were lost in the
# dops conversion; without them dfly-patch runs sed -i on no files.
target @2026Q4,@main
mk set REPLACE_LIST "external/curl/ExternalProject_curl.mk external/liblangtag/ExternalProject_liblangtag.mk external/libxslt/ExternalProject_libxslt.mk external/nss/ExternalProject_nss.mk external/openssl/ExternalProject_openssl.mk external/redland/ExternalProject_raptor.mk external/redland/ExternalProject_rasqal.mk external/redland/ExternalProject_redland.mk external/xmlsec/ExternalProject_xmlsec.mk external/pdfium/freebsd.patch include/osl/endian.h solenv/bin/modules/installer/parameter.pm soltools/mkdepend/main.c vcl/qa/cppunit/BitmapTest.cxx vcl/unx/generic/app/saldata.cxx vcl/unx/generic/dtrans/X11_selection.cxx vcl/unx/generic/printer/printerinfomanager.cxx desktop/unx/source/start.c sal/osl/unx/process_impl.cxx sal/osl/unx/sockimpl.hxx sal/osl/unx/pipe.cxx vcl/unx/gtk3/gtkdata.cxx"
mk set PERCENT_BSD_LIST "Repository.mk desktop/Library_crashreport.mk libreofficekit/Module_libreofficekit.mk libreofficekit/Executable_gtktiledviewer.mk libreofficekit/Library_libreofficekitgtk.mk svl/Library_svl.mk vcl/Module_vcl.mk vcl/Library_vcl.mk"
text replace-once file Makefile from "s,pdfium_patches += pdfium-bsd.patch,& pdfium-build__config.patch ,g" to "s,pdfium_patches += freebsd.patch,& pdfium-build__config.patch ,g"

# textproc/zxing-cpp is a libc++ library on these lines; LibreOffice builds
# with gcc 13 and libstdc++, so it can't link it. Drop the QR-code support
# it provides.
target @2026Q3,@2026Q4,@main

mk remove LIB_DEPENDS "libZXing.so:textproc/zxing-cpp"
text replace-once file Makefile from "--with-system-zxing" to "--disable-zxing"

port editors/emacs-devel
type port
reason "auto-converted from compat (Makefile.DragonFly + dragonfly/)"
target @any

mk eval OPTIONS_DEFAULT "${OPTIONS_DEFAULT:NACL}"
mk set USE_GCC_VERSION "${GCC_DEFAULT}"
# Native compilation needs libgccjit, which only a ports gcc ships (base gcc
# has none); FreeBSD asks for gcc 13 with USE_GCC, which DragonFly ignores.
mk set NATIVECOMP_VARS "USE_GCC_VERSION=13"

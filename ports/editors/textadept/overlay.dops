port editors/textadept
type port
reason "auto-converted from compat (Makefile.DragonFly + dragonfly/)"
target @any

mk add USES "ncurses"
mk target set dfly-patch <<'MK1'
	${CP} -v ${WRKSRC}/src/cdk/menu.h ${WRKSRC}/src/cdk/cdkmenu.h
	${REINPLACE_CMD} -e 's,<menu.h>,<cdkmenu.h>,g' \
		${WRKSRC}/src/cdk/cdk.h
MK1
# devel/ncurses keeps WINDOW and friends opaque.
mk add CFLAGS "-DNCURSES_INTERNALS"
# The link needs devel/ncurses' library path, which ncurses.pc leaves out;
# the Makefile sets LDFLAGS itself, so pass it in CXXFLAGS.
mk add CXXFLAGS "-L${NCURSESLIB}"
